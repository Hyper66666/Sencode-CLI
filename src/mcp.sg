// Permissions and terminal controls stay in Sencode; byte framing, deadlines,
// JSON-RPC state and owned process cleanup have one implementation in sgmcp.
import executor;
import sgmcp;

struct McpClient { core: SgMcpClient }

def mcp_start(command: &str, arguments: JsonValue, cwd: &str) -> Result<McpClient, i64> {
    let started = sgmcp_start(command, arguments, cwd)?;
    Result { is_ok: true, value: McpClient { core: started }, error: 0 }
}

impl McpClient {
    def rpc(&mut self, method: &str, params: JsonValue, timeout_ms: i64, terminal: &Terminal) -> Result<JsonDoc, i64> {
        let pending: Vec<TerminalEvent> = vec_new(); self.rpc_pending(method, params, timeout_ms, terminal, &pending)
    }
    def wait_pending(&mut self, terminal: &Terminal, pending: &Vec<TerminalEvent>) -> Result<bool, i64> {
        loop {
            let input = ui_poll_busy(terminal, pending);
            if not input.is_ok() or input.value { self.core.cancel()?; return Result { is_ok: false, value: false, error: if input.is_ok() { 19 } else { input.error } }; };
            let polled = self.core.poll();
            if not polled.is_ok() { self.core.cancel()?; return Result { is_ok: false, value: false, error: polled.error }; };
            // Notifications cannot execute tools or approve work. Drain this
            // bounded stream even when no UI progress consumer is attached.
            let mut drained = 0;
            while drained < 64 {
                let notice = self.core.next_notification()?;
                if not notice.root().object_has("method") { break; };
                drained = drained + 1;
            };
            if polled.value { return Result { is_ok: true, value: true, error: 0 }; };
            time_sleep_ms(1);
        };
        Result { is_ok: true, value: true, error: 0 }
    }
    def rpc_pending(&mut self, method: &str, params: JsonValue, timeout_ms: i64, terminal: &Terminal, pending: &Vec<TerminalEvent>) -> Result<JsonDoc, i64> {
        self.core.begin(method, params, timeout_ms)?; self.wait_pending(terminal, pending)?; self.core.result()
    }
    def initialize(&mut self, terminal: &Terminal) -> Result<bool, i64> {
        let pending: Vec<TerminalEvent> = vec_new(); self.initialize_pending(terminal, &pending)
    }
    def initialize_pending(&mut self, terminal: &Terminal, pending: &Vec<TerminalEvent>) -> Result<bool, i64> {
        self.core.begin_initialize("2025-11-25", "sencode-sg", 30000)?;
        self.wait_pending(terminal, pending)?; self.core.finish_initialize()
    }
    def diagnostic_report(&self) -> Result<JsonDoc, i64> { self.core.diagnostic_report() }
    def cancel(&mut self) -> Result<bool, i64> { self.core.cancel() }
    def tools(&mut self, terminal: &Terminal) -> Result<JsonDoc, i64> {
        let pending: Vec<TerminalEvent> = vec_new();
        self.tools_pending(terminal, &pending)
    }

    def tools_pending(&mut self, terminal: &Terminal, pending: &Vec<TerminalEvent>) -> Result<JsonDoc, i64> {
        let document = json_doc_object()?;
        let tools = document.new_array()?;
        document.root().object_set("tools", tools)?;
        let mut cursor = string_new();
        let mut pages = 0;
        loop {
            let params = json_doc_object()?;
            if cursor.len() > 0 { cli_put_string(&params, params.root(), "cursor", cursor.as_str())?; (); };
            let response = self.rpc_pending("tools/list", params.root(), 30000, terminal, pending)?;
            let result = response.root().object_get("result")?;
            let page = result.object_get("tools")?;
            let mut index = 0;
            while index < page.array_len()? {
                if tools.array_len()? >= 256 { return Result { is_ok: false, value: JsonDoc { handle: 0 }, error: 13 }; };
                tools.array_push(document.copy(page.array_get(index)?)?)?;
                index = index + 1;
            };
            let next = cli_json_optional_string(result, "nextCursor");
            if next.len() == 0 { break; };
            if next.as_str() == cursor.as_str() or pages >= 32 { return Result { is_ok: false, value: JsonDoc { handle: 0 }, error: 10 }; };
            cursor = next;
            pages = pages + 1;
        };
        Result { is_ok: true, value: document, error: 0 }
    }

    def call_tool(&mut self, name: &str, arguments: JsonValue, terminal: &Terminal) -> Result<JsonDoc, i64> {
        let pending: Vec<TerminalEvent> = vec_new();
        self.call_tool_pending(name, arguments, terminal, &pending)
    }

    def call_tool_pending(&mut self, name: &str, arguments: JsonValue, terminal: &Terminal, pending: &Vec<TerminalEvent>) -> Result<JsonDoc, i64> {
        if not self.core.initialized { return Result { is_ok: false, value: JsonDoc { handle: 0 }, error: 3 }; };
        let params = json_doc_object()?;
        cli_put_string(&params, params.root(), "name", name)?;
        params.root().object_set("arguments", params.copy(arguments)?)?;
        self.rpc_pending("tools/call", params.root(), 120000, terminal, pending)
    }
}
