import common;

struct SseEvent {
    event: String,
    data: String,
    id: String,
}

struct SseDecoder {
    pending: Buffer,
    data: String,
    event: String,
    id: String,
    maximum: i64,
    first: bool,
}

def sse_decoder() -> SseDecoder {
    SseDecoder { pending: cli_bytes(1048576), data: string_new(), event: string_new(), id: string_new(), maximum: 1048576, first: true }
}

impl SseDecoder {
    def feed(&mut self, chunk: &str) -> Result<Vec<SseEvent>, i64> {
        let bytes = ffi_buffer_from_bytes(chunk)?;
        self.feed_bytes(&bytes, 0, bytes.used_len())
    }

    def feed_bytes(&mut self, chunk: &Buffer, start: i64, count: i64) -> Result<Vec<SseEvent>, i64> {
        let events: Vec<SseEvent> = vec_new();
        if self.pending.used_len() + count > self.maximum { return Result { is_ok: false, value: events, error: 13 }; };
        cli_bytes_append(&self.pending, chunk, start, count)?;
        loop {
            let newline = cli_bytes_index(&self.pending, "\n")?;
            if newline < 0 { break; };
            let mut line = cli_bytes_text(&self.pending, 0, newline)?;
            self.pending.consume(newline + 1)?;
            if str_ends_with(line.as_str(), "\r") { line = cli_byte_slice(line.as_str(), 0, line.len() - 1)?; };
            if self.first {
                self.first = false;
                if str_starts_with(line.as_str(), "﻿") { line = cli_byte_slice(line.as_str(), 3, line.len())?; };
            };
            if line.len() == 0 {
                if self.data.len() > 0 {
                    let payload = cli_byte_slice(self.data.as_str(), 0, self.data.len() - 1)?;
                    let name = if self.event.len() == 0 { cli_text("message") } else { self.event.clone()? };
                    events.push(SseEvent { event: name, data: payload, id: self.id.clone()? });
                    ();
                };
                self.data = string_new();
                self.event = string_new();
            } else {
                if not str_starts_with(line.as_str(), ":") {
                    let colon = str_index_of(line.as_str(), ":");
                    let name = if colon < 0 { line.clone()? } else { cli_byte_slice(line.as_str(), 0, colon)? };
                    let mut value = if colon < 0 { string_new() } else { cli_byte_slice(line.as_str(), colon + 1, line.len())? };
                    if str_starts_with(value.as_str(), " ") { value = cli_byte_slice(value.as_str(), 1, value.len())?; };
                    if name.as_str() == "data" {
                        if self.data.len() + value.len() + 1 > self.maximum { return Result { is_ok: false, value: events, error: 13 }; };
                        self.data.push_str(value.as_str())?;
                        self.data.push_str("\n")?;
                        ();
                    };
                    if name.as_str() == "event" { self.event = value.clone()?; };
                    if name.as_str() == "id" { self.id = value.clone()?; };
                };
            };
        };
        Result { is_ok: true, value: events, error: 0 }
    }

    def finish(&self) -> Result<bool, i64> {
        // A trailing partial event cannot authorize tools or indicate success.
        if self.pending.used_len() != 0 or self.data.len() != 0 { return Result { is_ok: false, value: false, error: 10 }; };
        Result { is_ok: true, value: true, error: 0 }
    }
}
