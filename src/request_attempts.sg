import state;

// Fenced attempt evidence is separate from conversation data and never stores
// credentials, raw error bodies, request headers or hidden provider state.
def request_attempt_save(state: &CliState, execution: &CliExecution, id: &str, connection: &str, model: &str, purpose: &str, attempt: i64, status: &str, code: i64, input_tokens: i64, output_tokens: i64, usage_reported: bool) -> Result<bool, i64> {
    let document = json_parse("{\"schema\":1,\"attempts\":[]}")?;
    let target = document.root().object_get("attempts")?;
    let previous = cli_state_mode_load(state, execution.session.as_str(), "request_attempts")?;
    if previous.root().object_has("value") {
        let source = previous.root().object_get("value")?.object_get("attempts")?;
        if source.array_len()? > 256 { return Result { is_ok: false, value: false, error: 13 }; };
        let mut index = 0;
        while index < source.array_len()? {
            let value = source.array_get(index)?;
            if cli_json_optional_string(value, "id").as_str() != id {
                if source.array_len()? >= 256 and index == 0 {
                    if cli_json_optional_string(value, "status").as_str() == "running" { return Result { is_ok: false, value: false, error: 13 }; };
                } else { target.array_push(document.copy(value)?)?; (); };
                ();
            };
            index = index + 1;
        };
    };
    let item = document.new_object()?;
    cli_put_string(&document, item, "id", id)?;
    cli_put_string(&document, item, "execution_id", execution.id.as_str())?;
    cli_put_i64(&document, item, "fence", execution.fence)?;
    cli_put_string(&document, item, "connection_id", connection)?; cli_put_string(&document, item, "model", model)?;
    cli_put_string(&document, item, "purpose", purpose)?; cli_put_i64(&document, item, "attempt", attempt)?;
    cli_put_string(&document, item, "status", status)?; cli_put_i64(&document, item, "error", code)?;
    cli_put_string(&document, item, "usage_source", if usage_reported { "provider-reported" } else { "unavailable" })?;
    cli_put_i64(&document, item, "input_tokens", input_tokens)?; cli_put_i64(&document, item, "output_tokens", output_tokens)?;
    cli_put_i64(&document, item, "updated_at", time_unix_ms())?;
    target.array_push(item)?;
    cli_state_mode_save(state, execution, "request_attempts", &document)
}

def request_attempt_finish(state: &CliState, execution: &CliExecution, id: &str, connection: &str, model: &str, purpose: &str, attempt: i64, code: i64, input: i64, output: i64, reported: bool) -> Result<bool, i64> {
    request_attempt_save(state, execution, id, connection, model, purpose, attempt, if code == 0 { "accepted" } else { if code == 19 { "canceled" } else { "failed" } }, code, input, output, reported)?;
    // Preserve absence instead of recording invented zero provider usage.
    if reported { cli_state_usage(state, execution, id, connection, model, input, output)?; (); };
    Result { is_ok: true, value: true, error: 0 }
}
