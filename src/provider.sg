import common;
import provider_media;

// Owned strings retain their byte length; the current borrowed C-string view
// ends at NUL. Reject that mismatch before any protocol text is narrowed.
def provider_owned_text_valid(text: &String) -> Result<bool, i64> {
    if text.len() != text.as_str().len() { return Result { is_ok: false, value: false, error: 10 }; };
    Result { is_ok: true, value: true, error: 0 }
}

def provider_json_text_valid(value: JsonValue, depth: i64) -> Result<bool, i64> {
    if depth > 64 { return Result { is_ok: false, value: false, error: 13 }; };
    let kind = value.kind()?;
    if kind == JSON_KIND_STRING() { let text = value.string_value()?; return provider_owned_text_valid(&text); };
    if kind == JSON_KIND_ARRAY() {
        let mut index = 0;
        while index < value.array_len()? { provider_json_text_valid(value.array_get(index)?, depth + 1)?; index = index + 1; };
    };
    if kind == JSON_KIND_OBJECT() {
        let keys = value.object_keys()?;
        let mut index = 0;
        while index < keys.root().array_len()? {
            let key = keys.root().array_get(index)?.string_value()?;
            provider_owned_text_valid(&key)?;
            provider_json_text_valid(value.object_get(key.as_str())?, depth + 1)?;
            index = index + 1;
        };
    };
    Result { is_ok: true, value: true, error: 0 }
}

// Protocol ids are stable in the CLI contract: 0 Chat, 1 Responses, 2 Messages.
def provider_protocol(name: &str) -> i64 {
    if name == "chatCompletions" or name == "openai-chat-completions" or name == "chat-completions" or name == "openai" or name == "chat_completions" { return 0; };
    if name == "openai-responses" or name == "responses" or name == "openai_responses" { return 1; };
    if name == "messages" or name == "anthropic-messages" or name == "anthropic" or name == "anthropic_messages" { return 2; };
    -1
}

def provider_route(protocol: i64) -> &str {
    if protocol == 0 { return "/chat/completions"; };
    if protocol == 1 { return "/responses"; };
    "/messages"
}

def provider_history_tools(document: &JsonDoc, calls: JsonValue, protocol: i64) -> Result<JsonValue, i64> {
    let output = document.new_array()?;
    let count = calls.array_len()?;
    let mut index = 0;
    while index < count {
        let call = calls.array_get(index)?;
        let id = cli_json_string(call, "id")?;
        let name = cli_json_string(call, "name")?;
        let arguments = cli_json_string(call, "arguments")?;
        provider_owned_text_valid(&id)?;
        provider_owned_text_valid(&name)?;
        provider_owned_text_valid(&arguments)?;
        let item = document.new_object()?;
        if protocol == 0 {
            cli_put_string(document, item, "id", id.as_str())?;
            cli_put_string(document, item, "type", "function")?;
            let function = document.new_object()?;
            cli_put_string(document, function, "name", name.as_str())?;
            cli_put_string(document, function, "arguments", arguments.as_str())?;
            item.object_set("function", function)?;
            ();
        };
        if protocol == 1 {
            cli_put_string(document, item, "type", "function_call")?;
            cli_put_string(document, item, "call_id", id.as_str())?;
            cli_put_string(document, item, "name", name.as_str())?;
            cli_put_string(document, item, "arguments", arguments.as_str())?;
            ();
        };
        if protocol == 2 {
            cli_put_string(document, item, "type", "tool_use")?;
            cli_put_string(document, item, "id", id.as_str())?;
            cli_put_string(document, item, "name", name.as_str())?;
            let parsed = json_parse(arguments.as_str())?;
            item.object_set("input", document.copy(parsed.root())?)?;
            ();
        };
        output.array_push(item)?;
        index = index + 1;
    };
    Result { is_ok: true, value: output, error: 0 }
}

// Desktop and the managed ACP runtime share this closed set. An empty effort
// means "use the provider/model default" and deliberately omits all wire
// fields so older custom endpoints keep their previous request shape.
def provider_effort_valid(effort: &str) -> bool {
    effort.len() == 0 or effort == "low" or effort == "medium" or effort == "high" or effort == "xhigh" or effort == "max"
}

def provider_effort_wire(protocol: i64, effort: &str) -> &str {
    if effort == "max" and (protocol == 0 or protocol == 1) { return "xhigh"; };
    if effort == "xhigh" and protocol == 2 { return "high"; };
    effort
}

def provider_encode_effort(document: &JsonDoc, root: JsonValue, protocol: i64, effort: &str) -> Result<bool, i64> {
    if not provider_effort_valid(effort) { return Result { is_ok: false, value: false, error: 2 }; };
    if effort.len() == 0 { return Result { is_ok: true, value: true, error: 0 }; };
    if protocol == 0 {
        // OpenAI Chat Completions and compatible endpoints use the scalar
        // reasoning_effort extension.
        cli_put_string(document, root, "reasoning_effort", provider_effort_wire(protocol, effort))?;
        return Result { is_ok: true, value: true, error: 0 };
    };
    if protocol == 1 {
        // Responses keeps reasoning controls in an object so future controls
        // can be added without changing the scalar field contract.
        let reasoning = document.new_object()?;
        cli_put_string(document, reasoning, "effort", provider_effort_wire(protocol, effort))?;
        root.object_set("reasoning", reasoning)?;
        return Result { is_ok: true, value: true, error: 0 };
    };
    if protocol == 2 {
        // Keep the desktop sampling contract: adaptive thinking plus the
        // Messages-native output_config tier. Xhigh remains a distinct local
        // preference but maps to high; Max retains the provider max tier.
        let thinking = document.new_object()?;
        cli_put_string(document, thinking, "type", "adaptive")?;
        cli_put_string(document, thinking, "display", "summarized")?;
        root.object_set("thinking", thinking)?;
        let config = document.new_object()?;
        cli_put_string(document, config, "effort", provider_effort_wire(protocol, effort))?;
        root.object_set("output_config", config)?;
        return Result { is_ok: true, value: true, error: 0 };
    };
    Result { is_ok: false, value: false, error: 2 }
}

def provider_build_request(protocol: i64, model: &str, history: &JsonDoc, tools: &JsonDoc) -> Result<String, i64> {
    provider_build_request_with_effort(protocol, model, "", history, tools)
}

def provider_build_request_with_effort(protocol: i64, model: &str, effort: &str, history: &JsonDoc, tools: &JsonDoc) -> Result<String, i64> {
    provider_build_request_checked_with_effort(protocol, model, effort, history, tools, false, 16777216)
}

// Internal qualified adapter entry. The caller owns asset inspection and the
// captured model capability; enabling a protocol alone never enables images.
def provider_build_request_with_media(protocol: i64, model: &str, history: &JsonDoc, tools: &JsonDoc, images_allowed: bool, body_limit: i64) -> Result<String, i64> {
    provider_build_request_with_media_effort(protocol, model, "", history, tools, images_allowed, body_limit)
}

def provider_build_request_with_media_effort(protocol: i64, model: &str, effort: &str, history: &JsonDoc, tools: &JsonDoc, images_allowed: bool, body_limit: i64) -> Result<String, i64> {
    provider_build_request_checked_with_effort(protocol, model, effort, history, tools, images_allowed, body_limit)
}

def provider_build_request_checked(protocol: i64, model: &str, history: &JsonDoc, tools: &JsonDoc, images_allowed: bool, body_limit: i64) -> Result<String, i64> {
    provider_build_request_checked_with_effort(protocol, model, "", history, tools, images_allowed, body_limit)
}

def provider_build_request_checked_with_effort(protocol: i64, model: &str, effort: &str, history: &JsonDoc, tools: &JsonDoc, images_allowed: bool, body_limit: i64) -> Result<String, i64> {
    if protocol < 0 or protocol > 2 or model.len() == 0 { return string_result_err(2); };
    if not provider_effort_valid(effort) { return string_result_err(2); };
    if body_limit < 1 or body_limit > 16777216 { return string_result_err(2); };
    let size = history.serialize_string()?.len() + tools.serialize_string()?.len();
    let document = json_doc_object_limits(if images_allowed { body_limit } else { if size * 2 + 65536 < body_limit { size * 2 + 65536 } else { body_limit } }, 65536)?;
    let root = document.root();
    cli_put_string(&document, root, "model", model)?;
    cli_put_bool(&document, root, "stream", true)?;
    let window = cli_json_optional_i64(history.root(), "context_window_tokens", 262144);
    let maximum = cli_json_optional_i64(history.root(), "max_output_tokens", 131072);
    if window < 64 or window > 1048576 or maximum < 1 or maximum > 1048576 { return string_result_err(2); };
    // Base64 is wire transport, not text context. Keep wire-byte admission
    // independent; use an explicit conservative image estimate per input.
    let mut text_bytes = size; let mut image_tokens = 0; let mut image_row = 0;
    let history_rows = history.root().object_get("messages")?;
    while image_row < history_rows.array_len()? {
        let row = history_rows.array_get(image_row)?;
        if row.object_has("content_parts") {
            let parts = row.object_get("content_parts")?; let mut part_index = 0;
            if parts.array_len()? > 64 { return string_result_err(13); };
            while part_index < parts.array_len()? {
                let part = parts.array_get(part_index)?;
                if cli_json_optional_string(part, "type").as_str() == "image" and part.object_has("data") {
                    let data = cli_json_string(part, "data")?;
                    if data.len() > text_bytes { return string_result_err(10); };
                    text_bytes = text_bytes - data.len(); image_tokens = image_tokens + 4096;
                }; part_index = part_index + 1;
            };
        }; image_row = image_row + 1;
    };
    let estimated = (text_bytes + 2) / 3 + history_rows.array_len()? * 16 + image_tokens;
    let remaining = window - estimated - 32;
    if remaining < 1 or protocol == 1 and (maximum < 16 or remaining < 16) { return string_result_err(13); };
    let output_limit = if maximum < remaining { maximum } else { remaining };
    cli_put_i64(&document, root, if protocol == 0 { "max_completion_tokens" } else { if protocol == 1 { "max_output_tokens" } else { "max_tokens" } }, output_limit)?;
    if protocol == 1 {
        cli_put_bool(&document, root, "store", false)?;
        let include = document.new_array()?;
        include.array_push(document.new_string("reasoning.encrypted_content")?)?;
        root.object_set("include", include)?;
        ();
    };
    provider_encode_effort(&document, root, protocol, effort)?;
    let messages = document.new_array()?;
    let source = history.root().object_get("messages")?;
    let mut index = 0;
    let system = string_new();
    while index < source.array_len()? {
        let original = source.array_get(index)?;
        let role = cli_json_string(original, "role")?;
        let text = cli_json_optional_string(original, "content");
        provider_owned_text_valid(&role)?;
        provider_owned_text_valid(&text)?;
        let media = original.object_has("content_parts");
        // Validate once even for a protocol that would otherwise skip this role.
        let parts = if media { provider_media_content(&document, original, protocol, images_allowed)? } else { document.new_array()? };
        let message = document.new_object()?;
        if protocol == 0 {
            cli_put_string(&document, message, "role", role.as_str())?;
            if media { message.object_set("content", parts)?; (); } else { cli_put_string(&document, message, "content", text.as_str())?; (); };
            if original.object_has("tool_call_id") { message.object_set("tool_call_id", document.copy(original.object_get("tool_call_id")?)?)?; (); };
            if original.object_has("tool_calls") { message.object_set("tool_calls", provider_history_tools(&document, original.object_get("tool_calls")?, 0)?)?; (); };
            messages.array_push(message)?;
            ();
        };
        if protocol == 1 {
            if role.as_str() == "tool" {
                cli_put_string(&document, message, "type", "function_call_output")?;
                message.object_set("call_id", document.copy(original.object_get("tool_call_id")?)?)?;
                cli_put_string(&document, message, "output", text.as_str())?;
                messages.array_push(message)?;
                ();
            } else {
                if role.as_str() == "assistant" and original.object_has("responses_output") {
                    let items = original.object_get("responses_output")?;
                    if items.array_len()? > 64 { return string_result_err(13); };
                    let mut item_index = 0;
                    while item_index < items.array_len()? {
                        let item = items.array_get(item_index)?;
                        provider_json_text_valid(item, 0)?;
                        let kind = cli_json_string(item, "type")?;
                        if kind.as_str() != "reasoning" and kind.as_str() != "function_call" and kind.as_str() != "message" { return string_result_err(10); };
                        messages.array_push(document.copy(item)?)?;
                        item_index = item_index + 1;
                    };
                    index = index + 1;
                    continue;
                };
                if text.len() > 0 or media {
                    cli_put_string(&document, message, "role", role.as_str())?;
                    if media { message.object_set("content", parts)?; (); } else { cli_put_string(&document, message, "content", text.as_str())?; (); };
                    messages.array_push(message)?;
                    ();
                };
                if original.object_has("tool_calls") {
                    let calls = provider_history_tools(&document, original.object_get("tool_calls")?, 1)?;
                    let mut call_index = 0;
                    while call_index < calls.array_len()? { messages.array_push(calls.array_get(call_index)?)?; call_index = call_index + 1; };
                };
            };
        };
        if protocol == 2 {
            if role.as_str() == "system" {
                system.push_str(text.as_str())?;
                system.push_str("\n")?;
                ();
            } else {
                let content = document.new_array()?;
                if role.as_str() == "tool" {
                    cli_put_string(&document, message, "role", "user")?;
                    let result = document.new_object()?;
                    cli_put_string(&document, result, "type", "tool_result")?;
                    result.object_set("tool_use_id", document.copy(original.object_get("tool_call_id")?)?)?;
                    cli_put_string(&document, result, "content", text.as_str())?;
                    content.array_push(result)?;
                    ();
                } else {
                    cli_put_string(&document, message, "role", role.as_str())?;
                    if media { let mut part_index = 0; while part_index < parts.array_len()? { content.array_push(parts.array_get(part_index)?)?; part_index = part_index + 1; }; (); };
                    if text.len() > 0 {
                        let part = document.new_object()?;
                        cli_put_string(&document, part, "type", "text")?;
                        cli_put_string(&document, part, "text", text.as_str())?;
                        content.array_push(part)?;
                        ();
                    };
                    if original.object_has("tool_calls") {
                        let calls = provider_history_tools(&document, original.object_get("tool_calls")?, 2)?;
                        let mut call_index = 0;
                        while call_index < calls.array_len()? { content.array_push(calls.array_get(call_index)?)?; call_index = call_index + 1; };
                    };
                };
                message.object_set("content", content)?;
                messages.array_push(message)?;
                ();
            };
        };
        index = index + 1;
    };
    root.object_set(if protocol == 1 { "input" } else { "messages" }, messages)?;
    if protocol == 2 { cli_put_string(&document, root, "system", system.as_str())?; (); };
    if protocol == 0 {
        let options = document.new_object()?;
        cli_put_bool(&document, options, "include_usage", true)?;
        root.object_set("stream_options", options)?;
        ();
    };
    let definitions = document.new_array()?;
    let source_tools = tools.root().object_get("tools")?;
    index = 0;
    while index < source_tools.array_len()? {
        let tool = source_tools.array_get(index)?;
        let function = document.new_object()?;
        function.object_set("name", document.copy(tool.object_get("name")?)?)?;
        function.object_set("description", document.copy(tool.object_get("description")?)?)?;
        function.object_set(if protocol == 2 { "input_schema" } else { "parameters" }, document.copy(tool.object_get("parameters")?)?)?;
        if protocol == 0 { let wrapper = document.new_object()?; cli_put_string(&document, wrapper, "type", "function")?; wrapper.object_set("function", function)?; definitions.array_push(wrapper)?; (); } else {
            if protocol == 1 { cli_put_string(&document, function, "type", "function")?; (); };
            definitions.array_push(function)?;
            ();
        };
        index = index + 1;
    };
    if definitions.array_len()? > 0 { root.object_set("tools", definitions)?; (); };
    let serialized = document.serialize_string()?;
    if serialized.len() > body_limit { cli_diagnostic("The complete serialized model request exceeds the local byte limit; nothing was sent."); return string_result_err(13); };
    Result { is_ok: true, value: serialized, error: 0 }
}

struct ProviderToolCall {
    index: i64,
    id: String,
    name: String,
    arguments: String,
}

impl ProviderToolCall {
    def number(&self) -> i64 { self.index }
    def id_matches(&self, id: &str) -> bool { self.id.as_str() == id }
    def add_fragments(&self, id: &str, name: &str, arguments: &str) -> Result<bool, i64> {
        if self.id.len() == 0 { self.id.push_str(id)?; (); } else { if id.len() > 0 and self.id.as_str() != id { return Result { is_ok: false, value: false, error: 10 }; }; };
        self.name.push_str(name)?;
        self.arguments.push_str(arguments)?;
        if self.arguments.len() > 1048576 { return Result { is_ok: false, value: false, error: 13 }; };
        Result { is_ok: true, value: true, error: 0 }
    }
    def to_json(&self, document: &JsonDoc) -> Result<JsonValue, i64> {
        provider_owned_text_valid(&self.id)?;
        provider_owned_text_valid(&self.name)?;
        provider_owned_text_valid(&self.arguments)?;
        if self.id.len() == 0 or self.name.len() == 0 { return Result { is_ok: false, value: JsonValue { doc_handle: 0, node_id: 0 }, error: 10 }; };
        let arguments = if self.arguments.len() == 0 { cli_text("{}") } else { self.arguments.clone()? };
        let valid = json_parse(arguments.as_str())?;
        if valid.root().kind()? != JSON_KIND_OBJECT() { return Result { is_ok: false, value: JsonValue { doc_handle: 0, node_id: 0 }, error: 10 }; };
        let out = document.new_object()?;
        cli_put_string(document, out, "id", self.id.as_str())?;
        cli_put_string(document, out, "name", self.name.as_str())?;
        cli_put_string(document, out, "arguments", arguments.as_str())?;
        Result { is_ok: true, value: out, error: 0 }
    }
}

struct ProviderTurn {
    content: String,
    calls: Vec<ProviderToolCall>,
    reasoning_items: Vec<String>,
    reasoning_indices: Vec<i64>,
    done: bool,
    input_tokens: i64,
    output_tokens: i64,
    finish_reason: String,
    reasoning: bool,
    // Presentation state only. No hidden reasoning text is retained here.
    activity: i64,
    usage_reported: bool,
    // -1 missing, 0 explicit false, 1 explicit true. Message phase never
    // substitutes for the provider's turn-completion signal.
    responses_end_turn: i64,
    // Closed diagnostic category; never retain provider error messages.
    failure_kind: i64,
}

def provider_turn() -> ProviderTurn {
    let calls: Vec<ProviderToolCall> = vec_new();
    let reasoning_items: Vec<String> = vec_new();
    let reasoning_indices: Vec<i64> = vec_new();
    ProviderTurn { content: string_new(), calls: calls, reasoning_items: reasoning_items, reasoning_indices: reasoning_indices, done: false, input_tokens: 0, output_tokens: 0, finish_reason: string_new(), reasoning: false, activity: 0, usage_reported: false, responses_end_turn: -1, failure_kind: 0 }
}

impl ProviderTurn {
    def failure_label(&self) -> &str {
        if self.failure_kind == 1 { return "Provider reported a failed response"; };
        if self.failure_kind == 2 { return "Provider reported an incomplete response"; };
        if self.failure_kind == 3 { return "Provider reported a stream error"; };
        if self.failure_kind == 4 or self.finish_reason.as_str() == "length" or self.finish_reason.as_str() == "max_tokens" { return "Provider output token limit reached"; };
        if self.failure_kind == 5 or self.finish_reason.as_str() == "content_filter" { return "Provider content filter stopped the response"; };
        if self.failure_kind == 6 or self.finish_reason.as_str() == "refusal" { return "Provider refused the response"; };
        if self.failure_kind == 7 { return "Provider rate limit reported inside the stream"; };
        if self.failure_kind == 8 { return "Invalid provider event JSON"; };
        if self.failure_kind == 9 { return "Provider event exceeded the local JSON byte, node or memory limit"; };
        if self.failure_kind == 10 { return "Invalid provider event fields, identity or tool arguments"; };
        ""
    }

    def classify_failure(&mut self, value: JsonValue) -> Result<bool, i64> {
        if value.kind()? != JSON_KIND_OBJECT() { return Result { is_ok: true, value: false, error: 0 }; };
        let code = cli_json_optional_string(value, "code");
        let kind = cli_json_optional_string(value, "type");
        let reason = cli_json_optional_string(value, "reason");
        if code.as_str() == "max_output_tokens" or reason.as_str() == "max_output_tokens" or reason.as_str() == "max_tokens" { self.failure_kind = 4; };
        if code.as_str() == "content_filter" or reason.as_str() == "content_filter" { self.failure_kind = 5; };
        if code.as_str() == "rate_limit_exceeded" or kind.as_str() == "rate_limit_error" { self.failure_kind = 7; };
        Result { is_ok: true, value: true, error: 0 }
    }

    def retain_reasoning(&mut self, output_index: i64, item: JsonValue) -> Result<bool, i64> {
        if output_index < 0 or output_index > 4096 { return Result { is_ok: false, value: false, error: 10 }; };
        let kind = cli_json_string(item, "type")?;
        provider_json_text_valid(item, 0)?;
        if kind.as_str() != "reasoning" and kind.as_str() != "function_call" and kind.as_str() != "message" { return Result { is_ok: false, value: false, error: 10 }; };
        let id = cli_json_optional_string(item, "id");
        if id.len() > 256 or kind.as_str() == "reasoning" and id.len() == 0 { return Result { is_ok: false, value: false, error: 10 }; };
        let owned = json_doc_object()?;
        owned.root().object_set("item", owned.copy(item)?)?;
        let serialized = owned.serialize_string()?;
        if serialized.len() > 262144 { return Result { is_ok: false, value: false, error: 13 }; };
        let mut index = 0;
        let mut total = serialized.len();
        let mut replace = -1;
        while index < self.reasoning_indices.len() {
            let previous = self.reasoning_items.get(index)?;
            total = total + previous.len();
            let old = json_parse(previous.as_str())?;
            let previous_id = cli_json_optional_string(old.root().object_get("item")?, "id");
            if self.reasoning_indices.get(index).unwrap_or(-1) != output_index and id.len() > 0 and previous_id.as_str() == id.as_str() { return Result { is_ok: false, value: false, error: 10 }; };
            if self.reasoning_indices.get(index).unwrap_or(-1) == output_index {
                if id.len() > 0 and previous_id.len() > 0 and id.as_str() != previous_id.as_str() { return Result { is_ok: false, value: false, error: 10 }; };
                if cli_json_string(old.root().object_get("item")?, "type")?.as_str() != kind.as_str() { return Result { is_ok: false, value: false, error: 10 }; };
                replace = index;
                total = total - previous.len();
            };
            index = index + 1;
        };
        if total > 786432 { return Result { is_ok: false, value: false, error: 13 }; };
        if replace >= 0 { self.reasoning_items.set(replace, serialized); return Result { is_ok: true, value: true, error: 0 }; };
        if self.reasoning_items.len() >= 64 { return Result { is_ok: false, value: false, error: 13 }; };
        self.reasoning_indices.push(output_index);
        self.reasoning_items.push(serialized);
        let mut position = self.reasoning_indices.len() - 1;
        while position > 0 and self.reasoning_indices.get(position).unwrap_or(-1) < self.reasoning_indices.get(position - 1).unwrap_or(-1) {
            let left_number = self.reasoning_indices.get(position - 1).unwrap_or(-1);
            let right_number = self.reasoning_indices.get(position).unwrap_or(-1);
            let left = self.reasoning_items.get(position - 1)?;
            let right = self.reasoning_items.get(position)?;
            self.reasoning_indices.set(position - 1, right_number); self.reasoning_indices.set(position, left_number);
            self.reasoning_items.set(position - 1, right); self.reasoning_items.set(position, left);
            position = position - 1;
        };
        Result { is_ok: true, value: true, error: 0 }
    }

    def complete_tool(&mut self, output_index: i64, item: JsonValue) -> Result<bool, i64> {
        let id = cli_json_string(item, "call_id")?;
        let name = cli_json_string(item, "name")?;
        let arguments = cli_json_string(item, "arguments")?;
        provider_owned_text_valid(&id)?; provider_owned_text_valid(&name)?; provider_owned_text_valid(&arguments)?;
        let replacement = ProviderToolCall { index: output_index, id: id, name: name, arguments: arguments };
        let mut index = 0;
        while index < self.calls.len() {
            if self.calls.get(index).number() == output_index {
                let existing = self.calls.get(index);
                if existing.id.len() > 0 and not existing.id_matches(replacement.id.as_str()) { return Result { is_ok: false, value: false, error: 10 }; };
                self.calls.set(index, replacement); return Result { is_ok: true, value: true, error: 0 };
            };
            index = index + 1;
        };
        if self.calls.len() >= 64 { return Result { is_ok: false, value: false, error: 13 }; };
        self.calls.push(replacement);
        Result { is_ok: true, value: true, error: 0 }
    }

    def tool_delta(&mut self, index: i64, id: &str, name: &str, arguments: &str) -> Result<bool, i64> {
        let mut cursor = 0;
        while cursor < self.calls.len() {
            let existing: &ProviderToolCall = self.calls.get(cursor);
            if existing.number() == index { let appended = existing.add_fragments(id, name, arguments); return appended; };
            cursor = cursor + 1;
        };
        if self.calls.len() >= 64 { return Result { is_ok: false, value: false, error: 13 }; };
        self.calls.push(ProviderToolCall { index: index, id: cli_text(id), name: cli_text(name), arguments: cli_text(arguments) });
        Result { is_ok: true, value: true, error: 0 }
    }

    def text_delta(&mut self, text: &str) -> Result<String, i64> {
        if self.content.len() + text.len() > 2097152 { return string_result_err(13); };
        self.content.push_str(text)?;
        string_from_str(text)
    }

    def owned_text_delta(&mut self, text: &String) -> Result<String, i64> {
        provider_owned_text_valid(text)?;
        self.text_delta(text.as_str())
    }

    def event(&mut self, protocol: i64, data: &str) -> Result<String, i64> {
        let result = self.decode_event(protocol, data);
        if not result.is_ok() and self.failure_kind == 0 { self.failure_kind = 10; };
        result
    }

    def decode_event(&mut self, protocol: i64, data: &str) -> Result<String, i64> {
        if protocol == 0 and data == "[DONE]" { self.done = true; self.activity = 0; return Result { is_ok: true, value: string_new(), error: 0 }; };
        if self.done { return string_result_err(10); };
        // Completion metadata can contain cumulative per-message usage even
        // when the actual answer is tiny. Match the SSE byte bound and opt in
        // to a structural budget; the legacy JSON API's 4096 nodes are too
        // small for long Responses conversations. Parse one event at a time;
        // optional metadata never enters retained model history.
        let parsed = json_parse_limits(data, 1048576, 65536);
        if not parsed.is_ok() {
            self.failure_kind = if parsed.error == 13 { 9 } else { 8 };
            return string_result_err(parsed.error);
        };
        let document = parsed?;
        let root = document.root();
        if root.object_has("error") and not root.object_get("error")?.is_null() { self.failure_kind = 3; self.classify_failure(root.object_get("error")?)?; return string_result_err(9); };
        if protocol == 0 {
            if root.object_has("usage") {
                let usage = root.object_get("usage")?;
                if not usage.is_null() { self.input_tokens = cli_json_optional_i64(usage, "prompt_tokens", self.input_tokens); self.output_tokens = cli_json_optional_i64(usage, "completion_tokens", self.output_tokens); self.usage_reported = true; };
            };
            if root.object_has("choices") {
                let choices = root.object_get("choices")?;
                if choices.array_len()? > 0 {
                    let choice = choices.array_get(0)?;
                    if choice.object_has("finish_reason") {
                        let reason = choice.object_get("finish_reason")?;
                        if not reason.is_null() { let finish = reason.string_value()?; provider_owned_text_valid(&finish)?; self.finish_reason = finish; };
                    };
                    if choice.object_has("delta") {
                        let delta = choice.object_get("delta")?;
                        if delta.object_has("reasoning_content") and not delta.object_get("reasoning_content")?.is_null() {
                            let reasoning = delta.object_get("reasoning_content")?.string_value()?;
                            provider_owned_text_valid(&reasoning)?;
                            if reasoning.len() > 0 { self.activity = 1; };
                        };
                        if delta.object_has("refusal") and not delta.object_get("refusal")?.is_null() { self.failure_kind = 6; return string_result_err(7); };
                        if delta.object_has("tool_calls") {
                            self.activity = 0;
                            let calls = delta.object_get("tool_calls")?;
                            let mut cursor = 0;
                            while cursor < calls.array_len()? {
                                let call = calls.array_get(cursor)?;
                                let index = cli_json_optional_i64(call, "index", 0);
                                let id = cli_json_optional_string(call, "id");
                                let mut name = string_new();
                                let mut arguments = string_new();
                                if call.object_has("function") { let function = call.object_get("function")?; name = cli_json_optional_string(function, "name"); arguments = cli_json_optional_string(function, "arguments"); };
                                provider_owned_text_valid(&id)?;
                                provider_owned_text_valid(&name)?;
                                provider_owned_text_valid(&arguments)?;
                                self.tool_delta(index, id.as_str(), name.as_str(), arguments.as_str())?;
                                cursor = cursor + 1;
                            };
                        };
                        let text = cli_json_optional_string(delta, "content");
                        if text.len() > 0 { self.activity = 0; };
                        return self.owned_text_delta(&text);
                    };
                };
            };
        };
        if protocol == 1 {
            let kind = cli_json_optional_string(root, "type");
            provider_owned_text_valid(&kind)?;
            if kind.as_str() == "response.refusal.delta" or kind.as_str() == "response.refusal.done" { self.failure_kind = 6; return string_result_err(7); };
            if kind.as_str() == "response.output_text.delta" { self.activity = 0; let text = cli_json_string(root, "delta")?; return self.owned_text_delta(&text); };
            if kind.as_str() == "response.output_item.added" {
                let item = root.object_get("item")?;
                let item_type = cli_json_optional_string(item, "type");
                provider_owned_text_valid(&item_type)?;
                self.retain_reasoning(cli_json_optional_i64(root, "output_index", 0), item)?;
                if item_type.as_str() == "reasoning" {
                    self.reasoning = true;
                    self.activity = 1;
                };
                if item_type.as_str() == "function_call" {
                    self.activity = 0;
                    let id = cli_json_string(item, "call_id")?;
                    let name = cli_json_string(item, "name")?;
                    let args = cli_json_optional_string(item, "arguments");
                    provider_owned_text_valid(&id)?;
                    provider_owned_text_valid(&name)?;
                    provider_owned_text_valid(&args)?;
                    self.tool_delta(cli_json_optional_i64(root, "output_index", 0), id.as_str(), name.as_str(), args.as_str())?;
                    ();
                };
            };
            if kind.as_str() == "response.output_item.done" {
                let item = root.object_get("item")?;
                let item_type = cli_json_optional_string(item, "type");
                self.retain_reasoning(cli_json_optional_i64(root, "output_index", 0), item)?;
                if item_type.as_str() == "function_call" { self.complete_tool(cli_json_optional_i64(root, "output_index", 0), item)?; (); };
                if item_type.as_str() == "reasoning" {
                    self.reasoning = true;
                    self.activity = 0;
                };
            };
            if kind.as_str() == "response.function_call_arguments.delta" { let arguments = cli_json_string(root, "delta")?; provider_owned_text_valid(&arguments)?; self.tool_delta(cli_json_optional_i64(root, "output_index", 0), "", "", arguments.as_str())?; (); };
            if kind.as_str() == "response.failed" or kind.as_str() == "response.incomplete" or kind.as_str() == "error" {
                self.failure_kind = if kind.as_str() == "response.failed" { 1 } else { if kind.as_str() == "response.incomplete" { 2 } else { 3 } };
                if root.object_has("response") {
                    let response = root.object_get("response")?;
                    if response.object_has("error") { self.classify_failure(response.object_get("error")?)?; (); };
                    if response.object_has("incomplete_details") { self.classify_failure(response.object_get("incomplete_details")?)?; (); };
                };
                return string_result_err(10);
            };
            if kind.as_str() == "response.completed" {
                if root.object_has("response") {
                    let response = root.object_get("response")?;
                    if response.object_has("error") and not response.object_get("error")?.is_null() { self.failure_kind = 1; self.classify_failure(response.object_get("error")?)?; return string_result_err(9); };
                    if response.object_has("incomplete_details") and not response.object_get("incomplete_details")?.is_null() { self.failure_kind = 2; self.classify_failure(response.object_get("incomplete_details")?)?; return string_result_err(10); };
                    if response.object_has("status") and cli_json_string(response, "status")?.as_str() != "completed" { self.failure_kind = 2; return string_result_err(10); };
                    if response.object_has("end_turn") {
                        let end_turn = response.object_get("end_turn")?.bool_value()?;
                        self.responses_end_turn = if end_turn { 1 } else { 0 };
                    };
                    if response.object_has("output") {
                        let output = response.object_get("output")?;
                        let mut output_index = 0;
                        let final_text = string_new();
                        while output_index < output.array_len()? {
                            let item = output.array_get(output_index)?;
                            self.retain_reasoning(output_index, item)?;
                            if cli_json_optional_string(item, "type").as_str() == "function_call" { self.complete_tool(output_index, item)?; (); };
                            if cli_json_optional_string(item, "type").as_str() == "reasoning" { self.reasoning = true; };
                            if cli_json_optional_string(item, "type").as_str() == "message" and item.object_has("content") {
                                let content = item.object_get("content")?;
                                let mut part_index = 0;
                                while part_index < content.array_len()? {
                                    let part = content.array_get(part_index)?;
                                    if cli_json_optional_string(part, "type").as_str() == "refusal" { self.failure_kind = 6; return string_result_err(7); };
                                    if cli_json_optional_string(part, "type").as_str() == "output_text" { final_text.push_str(cli_json_string(part, "text")?.as_str())?; (); };
                                    part_index = part_index + 1;
                                };
                            };
                            output_index = output_index + 1;
                        };
                        if self.content.len() == 0 { self.content = final_text; };
                    };
                    if response.object_has("usage") { let usage = response.object_get("usage")?; self.input_tokens = cli_json_optional_i64(usage, "input_tokens", 0); self.output_tokens = cli_json_optional_i64(usage, "output_tokens", 0); self.usage_reported = not usage.is_null(); };
                };
                // Only a validated normal terminal event can authorize tools
                // or another model request. An invalid event never sets done.
                self.done = true;
                self.activity = 0;
                self.finish_reason = cli_text("stop");
            };
        };
        if protocol == 2 {
            let kind = cli_json_optional_string(root, "type");
            provider_owned_text_valid(&kind)?;
            if kind.as_str() == "message_start" { let message = root.object_get("message")?; if message.object_has("usage") { let usage = message.object_get("usage")?; self.input_tokens = cli_json_optional_i64(usage, "input_tokens", 0); self.usage_reported = not usage.is_null(); }; };
            if kind.as_str() == "content_block_start" {
                let item = root.object_get("content_block")?;
                let item_type = cli_json_optional_string(item, "type");
                provider_owned_text_valid(&item_type)?;
                if item_type.as_str() == "thinking" or item_type.as_str() == "redacted_thinking" { self.activity = 1; };
                if item_type.as_str() == "tool_use" {
                    self.activity = 0;
                    let id = cli_json_string(item, "id")?;
                    let name = cli_json_string(item, "name")?;
                    provider_owned_text_valid(&id)?;
                    provider_owned_text_valid(&name)?;
                    self.tool_delta(cli_json_optional_i64(root, "index", 0), id.as_str(), name.as_str(), "")?;
                    ();
                };
                if item_type.as_str() == "text" { self.activity = 0; let text = cli_json_optional_string(item, "text"); return self.owned_text_delta(&text); };
            };
            if kind.as_str() == "content_block_delta" {
                let delta = root.object_get("delta")?;
                let delta_type = cli_json_optional_string(delta, "type");
                provider_owned_text_valid(&delta_type)?;
                if delta_type.as_str() == "thinking_delta" { self.activity = 1; };
                if delta_type.as_str() == "text_delta" { self.activity = 0; let text = cli_json_string(delta, "text")?; return self.owned_text_delta(&text); };
                if delta_type.as_str() == "input_json_delta" { let arguments = cli_json_string(delta, "partial_json")?; provider_owned_text_valid(&arguments)?; self.tool_delta(cli_json_optional_i64(root, "index", 0), "", "", arguments.as_str())?; (); };
            };
            if kind.as_str() == "message_delta" {
                let delta = root.object_get("delta")?;
                self.finish_reason = cli_json_optional_string(delta, "stop_reason");
                provider_owned_text_valid(&self.finish_reason)?;
                if root.object_has("usage") { self.output_tokens = cli_json_optional_i64(root.object_get("usage")?, "output_tokens", 0); };
            };
            if kind.as_str() == "content_block_stop" { self.activity = 0; };
            if kind.as_str() == "message_stop" { self.done = true; self.activity = 0; };
            if kind.as_str() == "error" { self.failure_kind = 3; return string_result_err(9); };
        };
        Result { is_ok: true, value: string_new(), error: 0 }
    }

    def finish(&self) -> Result<JsonDoc, i64> {
        let document = json_doc_object()?;
        if not self.done or self.finish_reason.len() == 0 or self.finish_reason.as_str() == "length" or self.finish_reason.as_str() == "max_tokens" or self.finish_reason.as_str() == "content_filter" or self.finish_reason.as_str() == "refusal" { return Result { is_ok: false, value: document, error: 10 }; };
        let root = document.root();
        cli_put_string(&document, root, "role", "assistant")?;
        cli_put_string(&document, root, "content", self.content.as_str())?;
        if self.responses_end_turn >= 0 { cli_put_bool(&document, root, "responses_end_turn", self.responses_end_turn == 1)?; (); };
        cli_put_bool(&document, root, "requires_continuation", self.responses_end_turn == 0 and self.finish_reason.as_str() == "stop")?;
        let calls = document.new_array()?;
        let mut index = 0;
        while index < self.calls.len() {
            let call = self.calls.get(index).to_json(&document)?;
            let id = cli_json_string(call, "id")?;
            let mut previous = 0;
            while previous < index { if self.calls.get(previous).id_matches(id.as_str()) { return Result { is_ok: false, value: document, error: 10 }; }; previous = previous + 1; };
            calls.array_push(call)?;
            index = index + 1;
        };
        root.object_set("tool_calls", calls)?;
        if self.reasoning_items.len() > 0 {
            let items = document.new_array()?;
            let mut reasoning_index = 0;
            while reasoning_index < self.reasoning_items.len() {
                let item = json_parse(self.reasoning_items.get(reasoning_index)?.as_str())?;
                let retained = item.root().object_get("item")?;
                let copied = document.copy(retained)?;
                // Added items may precede argument deltas; use the validated
                // complete call assembled by the common stream parser while
                // retaining provider id/status/phase and all opaque fields.
                if cli_json_optional_string(retained, "type").as_str() == "function_call" {
                    let mut call_index = 0;
                    while call_index < self.calls.len() {
                        let call = self.calls.get(call_index);
                        if call.number() == self.reasoning_indices.get(reasoning_index).unwrap_or(-1) {
                            let valid = call.to_json(&document)?;
                            cli_put_string(&document, copied, "call_id", cli_json_string(valid, "id")?.as_str())?;
                            cli_put_string(&document, copied, "name", cli_json_string(valid, "name")?.as_str())?;
                            cli_put_string(&document, copied, "arguments", cli_json_string(valid, "arguments")?.as_str())?;
                            break;
                        };
                        call_index = call_index + 1;
                    };
                };
                items.array_push(copied)?;
                reasoning_index = reasoning_index + 1;
            };
            root.object_set("responses_output", items)?;
        };
        cli_put_i64(&document, root, "input_tokens", self.input_tokens)?;
        cli_put_i64(&document, root, "output_tokens", self.output_tokens)?;
        Result { is_ok: true, value: document, error: 0 }
    }
}
