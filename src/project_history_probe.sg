import project_history;
import command_line;

def project_history_probe() -> Result<i64,i64> {
    let database = cli_argument(0)?; let cwd = cli_argument(1)?; let action = cli_argument(2)?;
    let state = cli_state_open(database.as_str())?;
    if action.as_str() != "legacy" and action.as_str() != "initialize" { project_history_open(&state,cwd.as_str(),action.as_str()=="import")?; (); };
    if action.as_str() == "initialize" { return cli_ok(0); };
    // Fixture-only SQL entry: the Python driver supplies literal statements
    // against its inventoried temporary catalog. This is no product command.
    if action.as_str() == "sql" or action.as_str() == "sql-rollback" {
        let sql = cli_argument(3)?;
        let mut transaction = state.db.transaction()?; transaction.exec(sql.as_str())?;
        if action.as_str() == "sql" { transaction.commit()?; (); };
        return cli_ok(0);
    };
    if action.as_str() == "rollback" {
        let mut transaction = state.db.transaction()?;
        transaction.exec("UPDATE messages SET text='rolled-back' WHERE session_id IN(SELECT id FROM project_history.ph_sessions)")?;
        return cli_ok(0);
    };
    if action.as_str() == "seed" or action.as_str() == "legacy" {
        let session = cli_state_create_session(&state,cwd.as_str())?;
        let mut execution = cli_state_begin(&state,session.as_str(),"fixture","fixture-model")?;
        let message = json_parse("{\"role\":\"user\",\"content\":\"目录改名后继续：你好😀\"}")?;
        cli_state_append(&state,&execution,&message)?;
        cli_state_tool_claim(&state,&execution,"one","write_file","{}")?;
        cli_state_tool_complete(&state,&execution,"one","persisted")?;
        let mode = json_parse("{\"objective\":\"kept\",\"requests_used\":7,\"status\":3}")?;
        cli_state_mode_save(&state,&execution,"goal",&mode)?;
        let request = cli_join("request-",session.as_str())?;
        cli_state_usage(&state,&execution,request.as_str(),"fixture","fixture-model",17,23)?;
        cli_state_finish(&state,&mut execution,"idle")?;
        let mut tool = state.db.prepare("INSERT INTO tool_calls(id,session_id,message_id,kind,status,safe_payload_json,started_at,completed_at) SELECT ?,session_id,id,'edit','complete','{}',created_at,created_at FROM messages WHERE session_id=? ORDER BY revision LIMIT 1")?;
        tool.bind_text(1,request.as_str())?; tool.bind_text(2,session.as_str())?; tool.step()?;
        let mut usage = state.db.prepare("INSERT INTO session_usage(session_id,input_tokens,output_tokens,terminal_events) VALUES(?,17,23,1)")?;
        usage.bind_text(1,session.as_str())?; usage.step()?;
        println(session.as_str());
        return cli_ok(0);
    };
    let sessions = cli_state_sessions(&state,cwd.as_str())?;
    println(sessions.serialize_string()?.as_str());
    cli_ok(0)
}
def main() -> i64 { let result = project_history_probe(); if not result.is_ok { println(result.error); let detail=sqlite_error_message();if detail.is_ok(){println(detail.value.as_str());};return 1; }; result.value }
