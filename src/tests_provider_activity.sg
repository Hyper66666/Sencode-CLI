import provider;

def activity_assert(condition: bool, label: &str) -> Result<bool, i64> {
    if not condition { println(label); return Result { is_ok: false, value: false, error: 1 }; };
    Result { is_ok: true, value: true, error: 0 }
}

def activity_tests() -> Result<bool, i64> {
    let mut chat = provider_turn();
    activity_assert(chat.activity == 0, "unsignalled request is working")?;
    chat.event(0, "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}")?;
    activity_assert(chat.activity == 0, "role envelope is not reasoning")?;
    chat.event(0, "{\"choices\":[{\"delta\":{\"reasoning_content\":\"private-not-visible\"}}]}")?;
    activity_assert(chat.activity == 1 and chat.content.len() == 0, "chat reasoning is activity only")?;
    chat.event(0, "{\"choices\":[{\"delta\":{\"content\":\"visible\"}}]}")?;
    activity_assert(chat.activity == 0 and chat.content.as_str() == "visible", "chat content ends reasoning")?;
    chat.event(0, "[DONE]")?;
    activity_assert(chat.activity == 0, "completed chat has no reasoning activity")?;
    let mut responses = provider_turn();
    responses.event(1, "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"reasoning\",\"id\":\"r1\",\"summary\":[]}}")?;
    activity_assert(responses.activity == 1, "responses reasoning item begins activity")?;
    responses.event(1, "{\"type\":\"response.output_item.done\",\"output_index\":0,\"item\":{\"type\":\"reasoning\",\"id\":\"r1\",\"summary\":[]}}")?;
    activity_assert(responses.activity == 0, "responses reasoning completion ends activity")?;
    responses.event(1, "{\"type\":\"response.output_text.delta\",\"delta\":\"visible\"}")?;
    activity_assert(responses.activity == 0, "responses text is working")?;
    let mut anthropic = provider_turn();
    anthropic.event(2, "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"thinking\",\"thinking\":\"\"}}")?;
    activity_assert(anthropic.activity == 1, "anthropic thinking block")?;
    anthropic.event(2, "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"thinking_delta\",\"thinking\":\"private-not-visible\"}}")?;
    activity_assert(anthropic.content.len() == 0, "anthropic reasoning never enters public content")?;
    anthropic.event(2, "{\"type\":\"content_block_stop\",\"index\":0}")?;
    activity_assert(anthropic.activity == 0, "anthropic stopped block is working")?;
    anthropic.event(2, "{\"type\":\"content_block_start\",\"index\":1,\"content_block\":{\"type\":\"text\",\"text\":\"visible\"}}")?;
    activity_assert(anthropic.content.as_str() == "visible" and anthropic.activity == 0, "anthropic public text")?;
    println("provider activity signals passed");
    Result { is_ok: true, value: true, error: 0 }
}

def main() -> i64 { let result = activity_tests(); if not result.is_ok() { println(result.error); return 1; }; 0 }
