import controller;
import command_line;

def recovery_expect(condition: bool, label: &str) -> Result<bool, i64> {
    if not condition { cli_diagnostic(label); return state_bool_error(99); };
    Result { is_ok: true, value: true, error: 0 }
}

def recovery_call(id: &str, name: &str, arguments: &str) -> Result<JsonDoc, i64> {
    let result = json_doc_object()?;
    cli_put_string(&result, result.root(), "id", id)?;
    cli_put_string(&result, result.root(), "name", name)?;
    cli_put_string(&result, result.root(), "arguments", arguments)?;
    Result { is_ok: true, value: result, error: 0 }
}

def recovery_tests(database: &str) -> Result<bool, i64> {
    recovery_expect(executor_read_error_recoverable("list_directory", 7) and executor_read_error_recoverable("read_file", 5) and executor_read_error_recoverable("git_status", 9), "Ordinary built-in read failures have a no-mutation boundary")?;
    recovery_expect(not executor_read_error_recoverable("run_command", 9) and not executor_read_error_recoverable("write_file", 7) and not executor_read_error_recoverable("read_file", 19) and not executor_read_error_recoverable("read_file", 12) and not executor_read_error_recoverable("read_file", 3) and not executor_read_error_recoverable("read_file", 14), "Effectful, cancellation, ownership, invalid-handle and OOM failures cannot be swallowed")?;
    let cwd = path_parent_string(database)?;
    let state = cli_state_open(database)?;
    let session = cli_state_create_session(&state, cwd.as_str())?;
    let mut execution = cli_state_begin(&state, session.as_str(), "fixture", "fixture-model")?;
    let mut policy = policy_default(); policy.interactive = false; policy.auto_edit = true;
    let input: Vec<TerminalEvent> = vec_new();
    let options = AgentOptions { cwd: cwd, session: session, connection: cli_text("fixture"), model: cli_text("fixture-model"), effort: string_new(), format: cli_text("json"), policy: policy, allow_commands: false, plan_path: string_new(), goal_text: string_new(), checks: json_parse("{\"checks\":[]}")?, input: input };
    let terminal = terminal_open()?; let scheduler = scheduler_new();
    let task = scheduler_add(&scheduler, 0, "fixture", options.cwd.as_str(), true)?;
    let children = children_new(); let child_states: Vec<ControllerChild> = vec_new();
    let mut goal = goal_new(50, 0);
    let denied = recovery_call("absolute-directory", "list_directory", "{\"path\":\"D:/outside-fixture-only\"}")?;
    let first = controller_tool(&state, &execution, &options, denied.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states);
    if not first.is_ok() { println(first.error); cli_diagnostic("REPRODUCED: ordinary list_directory path rejection aborted the agent instead of returning a tool result"); return state_bool_error(99); };
    let error = json_parse(first.value.as_str())?;
    recovery_expect(error.root().object_get("is_error")?.bool_value()? and error.root().object_get("recoverable")?.bool_value()? and error.root().object_get("error_code")?.number_i64()? == 7 and str_contains(cli_json_string(error.root(), "content")?.as_str(), "'.'"), "Rejected directory path returns code and a workspace-root correction hint")?;
    let repeated = recovery_call("absolute-directory", "list_directory", "{\"path\":\".\"}")?;
    let cached = controller_tool(&state, &execution, &options, repeated.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states)?;
    recovery_expect(cached.as_str() == first.value.as_str(), "A changed argument cannot replay the original call ID")?;
    let corrected = recovery_call("corrected-directory", "list_directory", "{\"path\":\".\"}")?;
    let corrected_result = controller_tool(&state, &execution, &options, corrected.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states)?;
    let corrected_json = json_parse(corrected_result.as_str())?;
    recovery_expect(not corrected_json.root().object_get("is_error")?.bool_value()?, "A corrected new call can read the workspace root")?;
    let missing = recovery_call("missing-file", "read_file", "{\"path\":\"missing-fixture.txt\"}")?;
    let missing_result = controller_tool(&state, &execution, &options, missing.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states)?;
    let missing_json = json_parse(missing_result.as_str())?;
    recovery_expect(missing_json.root().object_get("recoverable")?.bool_value()?, "Missing file remains a model-visible tool error")?;
    let invalid = recovery_call("invalid-text", "read_file", "{\"path\":\"invalid.bin\"}")?;
    let invalid_result = controller_tool(&state, &execution, &options, invalid.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states)?;
    let invalid_json = json_parse(invalid_result.as_str())?;
    recovery_expect(invalid_json.root().object_get("recoverable")?.bool_value()? and invalid_json.root().object_get("error_code")?.number_i64()? == 20, "Invalid UTF-8 read is a recoverable error with its original code")?;
    let note = workspace_path(options.cwd.as_str(), "unchanged.txt")?;
    file_write_str(note.as_str(), "original 世界")?;
    let patch = recovery_call("rejected-patch", "apply_patch", "{\"path\":\"unchanged.txt\",\"old\":\"absent pattern\",\"new\":\"must not write\"}")?;
    let patch_result = controller_tool(&state, &execution, &options, patch.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states)?;
    let patch_json = json_parse(patch_result.as_str())?;
    recovery_expect(patch_json.root().object_get("recoverable")?.bool_value()? and patch_json.root().object_get("no_side_effects")?.bool_value()? and workspace_read(note.as_str(), 100)?.as_str() == "original 世界", "Rejected editor preview has no write and can be corrected")?;
    let checkpoints = checkpoint_load(&state, options.session.as_str())?;
    recovery_expect(checkpoints.root().object_get("entries")?.array_len()? == 0, "Rejected preflight creates no prepared mutation checkpoint")?;

    let history = agent_history("No real provider; recoverable mixed read batch")?;
    let calls = json_parse("[{\"id\":\"batch-read-rejected\",\"name\":\"list_directory\",\"arguments\":\"{\\\"path\\\":\\\"\\\"}\"},{\"id\":\"batch-read-valid\",\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"unchanged.txt\\\"}\"}]")?;
    recovery_expect(controller_execute_batch(&state, &execution, &options, &history, calls.root(), &scheduler, task, &mut goal, &terminal, &children, &child_states)?, "A rejected read does not cancel the next read in its batch")?;
    let messages = history.root().object_get("messages")?;
    recovery_expect(messages.array_len()? == 3 and cli_json_string(messages.array_get(1)?, "tool_call_id")?.as_str() == "batch-read-rejected" and cli_json_string(messages.array_get(2)?, "tool_call_id")?.as_str() == "batch-read-valid", "Failed and successful results retain original call ordering")?;

    let git_calls = json_parse("[{\"id\":\"git-error-status\",\"name\":\"git_status\",\"arguments\":\"{}\"},{\"id\":\"git-error-diff\",\"name\":\"git_diff\",\"arguments\":\"{}\"}]")?;
    recovery_expect(controller_execute_batch(&state, &execution, &options, &history, git_calls.root(), &scheduler, task, &mut goal, &terminal, &children, &child_states)?, "Settled Git failures outside a repository do not abort unrelated read results")?;
    recovery_expect(goal.status == 1, "Recoverable read leaves the agent active")?;

    // Seed a genuinely uncertain durable outcome; dispatching the same ID must
    // remain paused without executing the apparently harmless replacement.
    cli_state_tool_claim(&state, &execution, "uncertain-write", "write_file", "{}")?;
    let unknown = executor_tool_failure("write_file", 9, false)?;
    cli_state_tool_complete(&state, &execution, "uncertain-write", unknown.serialize_string()?.as_str())?;
    let uncertain = recovery_call("uncertain-write", "write_file", "{\"path\":\"must-not-replay.txt\",\"content\":\"forbidden\"}")?;
    let halted = controller_tool(&state, &execution, &options, uncertain.root(), &scheduler, task, &mut goal, &terminal, &options.input, &children, &child_states);
    recovery_expect(not halted.is_ok() and halted.error == 12 and goal.status == 2 and not file_exists(workspace_path(options.cwd.as_str(), "must-not-replay.txt")?.as_str()), "Unknown side effects remain paused and cannot replay a completed call ID")?;
    let cancel = executor_tool_failure("list_directory", 19, false)?;
    recovery_expect(cancel.root().object_get("host_error")?.bool_value()? and not cancel.root().object_get("recoverable")?.bool_value()?, "Read cancellation is still a host stop")?;
    let cancelled_input: Vec<TerminalEvent> = vec_new();
    engine_control_init(&cancelled_input)?;
    cancelled_input.push(engine_control_record(92, 0, "fixture-cancel"));
    let cancelled_call = recovery_call("cancelled-read", "list_directory", "{\"path\":\".\"}")?;
    let stopped = controller_tool(&state, &execution, &options, cancelled_call.root(), &scheduler, task, &mut goal, &terminal, &cancelled_input, &children, &child_states);
    recovery_expect(not stopped.is_ok() and stopped.error == 19 and controller_tool_prior(&state, &execution, "cancelled-read")? == 0, "A real pending cancellation prevents read admission and does not become a model retry")?;
    cli_state_finish(&state, &mut execution, "idle")?;
    Result { is_ok: true, value: true, error: 0 }
}

def main() -> i64 {
    let arguments = cli_arguments(); if not arguments.is_ok() { return 2; };
    let database = cli_option(&arguments.value, "database", "").unwrap_or(string_new());
    if database.len() == 0 { return 2; };
    let result = recovery_tests(database.as_str());
    if not result.is_ok() { println(result.error); return 1; };
    if sengoo_process_live_resource_count() != 0 or sengoo_process_live_handle_count() != 0 { cli_diagnostic("Recovery regression retained a process resource"); return 1; };
    println("controller recoverable tool failures acceptance passed"); 0
}
