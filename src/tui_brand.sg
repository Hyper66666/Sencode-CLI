// Original pixel wordmark with a two-cell monochrome extrusion.
def tui_brand_row(row: i64) -> &str {
    if row == 0 { return "█████  █████  ██  █  █████  █████  ████   █████"; };
    if row == 1 { return "██░░░░ ██░░░░ ███ █░ ██░░░░ ██░██░ ██░██  ██░░░░"; };
    if row == 2 { return "█████░░████░░░█████░░██░░░░░██░██░░██░██░ ████░░░"; };
    if row == 3 { return " ░░██░ ██░░░  ██░██░░██░░   ██░██░░██░██░░██░░░"; };
    if row == 4 { return "█████░░█████░ ██░░█░░█████  █████░░████░░░█████░"; };
    if row == 5 { return " ░░░░░░ ░░░░░  ░░░ ░░ ░░░░░  ░░░░░░ ░░░░░░ ░░░░░"; };
    if row == 6 { return "  ░░░░░  ░░░░░  ░░  ░  ░░░░░  ░░░░░  ░░░░   ░░░░░"; };
    ""
}
