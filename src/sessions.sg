import state;
import workspace;

// Caller holds the same session OS lock used by both desktop and CLI turns.
def session_idle(state: &CliState, session: &str) -> Result<bool, i64> {
    let mut query = state.db.prepare("SELECT 1 FROM sessions s WHERE s.id=? AND s.archived=0 AND NOT EXISTS(SELECT 1 FROM shared_executions e WHERE e.session_id=s.id AND (e.active=1 OR e.cleanup_required=1)) AND NOT EXISTS(SELECT 1 FROM shared_tool_ledger t WHERE t.session_id=s.id AND t.state='running')")?;
    query.bind_text(1, session)?;
    if not query.step()? { return state_bool_error(7); };
    Result { is_ok: true, value: true, error: 0 }
}

def session_rename(state: &CliState, session: &str, title: &str) -> Result<bool, i64> {
    let clean = str_trim(title)?;
    if clean.len() == 0 or clean.len() > 256 or str_contains(clean.as_str(), "\n") or str_contains(clean.as_str(), "\r") { return state_bool_error(2); };
    let safe = cli_terminal_safe(clean.as_str())?;
    if safe.as_str() != clean.as_str() { return state_bool_error(2); };
    let path = state_lock_path(state.path.as_str(), "session", session)?;
    let lease = file_lock(path.as_str())?;
    session_idle(state, session)?;
    let mut tx = state.db.transaction()?;
    let mut update = tx.prepare("UPDATE sessions SET title=?,title_source='user',updated_at=? WHERE id=?")?;
    update.bind_text(1, clean.as_str())?; update.bind_i64(2, time_unix_ms())?; update.bind_text(3, session)?; update.step()?;
    tx.commit()?;
    Result { is_ok: true, value: true, error: 0 }
}

def session_branch(state: &CliState, source: &str, title: &str) -> Result<String, i64> {
    if title.len() > 256 { return string_result_err(2); };
    let path = state_lock_path(state.path.as_str(), "session", source)?;
    let lease = file_lock(path.as_str())?;
    session_idle(state, source)?;
    let id = state_id("branch-")?;
    let prefix = cli_join(id.as_str(), ":")?;
    let now = time_unix_ms();
    let recall = json_parse("{\"version\":1,\"entries\":[]}")?;
    let origin=session_origin("branch","",source)?;
    let mut tx = state.db.transaction()?;
    let mut insert = tx.prepare("INSERT INTO sessions(id,project_id,title,title_source,created_at,updated_at,selected_connection_id,selected_model_id) SELECT ?,project_id,CASE WHEN ?='' THEN title || ' (branch)' ELSE ? END,'existing',?,?,selected_connection_id,selected_model_id FROM sessions WHERE id=?")?;
    insert.bind_text(1, id.as_str())?; insert.bind_text(2, title)?; insert.bind_text(3, title)?;
    insert.bind_i64(4, now)?; insert.bind_i64(5, now)?; insert.bind_text(6, source)?; insert.step()?;
    // Preserve the public transcript, not disposable engine-native sessions.
    let mut messages = tx.prepare("INSERT INTO messages(id,session_id,role,text,reasoning,created_at,completed_at,cancelled,connection_id,model_id,revision) SELECT ? || id,?,role,text,reasoning,created_at,completed_at,cancelled,connection_id,model_id,revision FROM messages WHERE session_id=?")?;
    messages.bind_text(1, prefix.as_str())?; messages.bind_text(2, id.as_str())?; messages.bind_text(3, source)?; messages.step()?;
    let mut history = tx.prepare("INSERT INTO shared_history(message_id,session_id,message_json,execution_id,fence) SELECT ? || message_id,?,message_json,execution_id,fence FROM shared_history WHERE session_id=?")?;
    history.bind_text(1, prefix.as_str())?; history.bind_text(2, id.as_str())?; history.bind_text(3, source)?; history.step()?;
    // A repeated historical tool ID must not acquire a fresh side effect.
    let mut ledger = tx.prepare("INSERT INTO shared_tool_ledger(session_id,call_id,execution_id,fence,name,arguments,state,result,updated_at) SELECT ?,call_id,execution_id,fence,name,arguments,state,result,updated_at FROM shared_tool_ledger WHERE session_id=?")?;
    ledger.bind_text(1, id.as_str())?; ledger.bind_text(2, source)?; ledger.step()?;
    let mut saved = tx.prepare("INSERT INTO shared_modes(session_id,mode_json,updated_at) VALUES(?,json_set(COALESCE((SELECT CASE WHEN json_type(mode_json,'$.image_grants') IS NOT NULL THEN json_set(mode_json,'$.image_grants',json('{\"image_grants\":[]}')) ELSE mode_json END FROM shared_modes WHERE session_id=?),'{}'),'$.cli_input_history',json(?),'$.branch_source',?,'$.branch_created_at',?,'$.session_origin',json(?)),?)")?;
    saved.bind_text(1,id.as_str())?; saved.bind_text(2,source)?; saved.bind_text(3,recall.serialize_string()?.as_str())?; saved.bind_text(4,source)?; saved.bind_i64(5,now)?; saved.bind_text(6,origin.serialize_string()?.as_str())?; saved.bind_i64(7,now)?; saved.step()?;
    tx.commit()?;
    Result { is_ok: true, value: id, error: 0 }
}

def session_export(state: &CliState, session: &str) -> Result<String, i64> {
    let mut title = state.db.prepare("SELECT title FROM sessions WHERE id=?")?;
    title.bind_text(1, session)?;
    if not title.step()? { return string_result_err(5); };
    let name = title.text(0)?;
    let out = cli_text("# "); out.push_str(name.as_str())?;
    out.push_str("\n\nSession: ")?; out.push_str(session)?; out.push_str("\n\n")?;
    let mut query = state.db.prepare("SELECT role,text,reasoning,cancelled FROM messages WHERE session_id=? ORDER BY revision,created_at,id")?;
    query.bind_text(1, session)?;
    while query.step()? {
        if out.len() > 8388608 { return string_result_err(13); };
        out.push_str("## ")?; out.push_str(query.text(0)?.as_str())?;
        if query.integer(3)? != 0 { out.push_str(" (interrupted)")?; (); };
        out.push_str("\n\n")?; out.push_str(query.text(1)?.as_str())?; out.push_str("\n\n")?;
        let reasoning = query.text(2)?;
        if reasoning.len() > 0 { out.push_str("### Reasoning\n\n")?; out.push_str(reasoning.as_str())?; out.push_str("\n\n")?; (); };
    };
    if out.len() > 8388608 { return string_result_err(13); };
    Result { is_ok: true, value: out, error: 0 }
}
