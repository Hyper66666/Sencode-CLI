import session_permissions;
import project_history;
import command_line;

def permission_expect(value: bool, message: &str) -> Result<bool, i64> {
    if not value { cli_diagnostic(message); return state_bool_error(99); };
    Result { is_ok: true, value: true, error: 0 }
}

def permission_memory_tests(database: &str) -> Result<bool, i64> {
    let state = cli_state_open(database)?;
    let session = cli_state_create_session(&state, cli_current_directory()?.as_str())?;
    let mut policy = policy_default(); policy.plan = true;
    let initial = session_permissions_restore(&state, session.as_str(), &mut policy)?;
    permission_expect(permission_mode(&policy) == "manual" and policy.plan and not initial.root().object_get("allow_commands")?.bool_value()?, "legacy sessions default to manual and retain Plan")?;
    permission_apply(&mut policy, "full");
    session_permissions_save(&state, session.as_str(), &policy, true, "strict")?;
    let before = { let mut query = state.db.prepare("SELECT COUNT(*) FROM shared_changes")?; query.step()?; query.integer(0)? };
    session_permissions_save(&state, session.as_str(), &policy, true, "strict")?;
    let after = { let mut query = state.db.prepare("SELECT COUNT(*) FROM shared_changes")?; query.step()?; query.integer(0)? };
    permission_expect(before == after, "unchanged permissions do not write changelog")?;
    permission_apply(&mut policy, "manual");
    let restored = session_permissions_restore(&state, session.as_str(), &mut policy)?;
    permission_expect(policy.full_access and policy.plan and restored.root().object_get("allow_commands")?.bool_value()?, "full selection restores without leaving Plan")?;
    let mut running = cli_state_begin(&state, session.as_str(), "", "")?;
    let goal = json_parse("{\"requests\":17,\"tokens\":241,\"status\":2}")?;
    cli_state_mode_save(&state, &running, "goal", &goal)?;
    let user = json_parse("{\"role\":\"user\",\"content\":\"权限记忆 😀\"}")?; cli_state_append(&state, &running, &user)?;
    permission_apply(&mut policy, "auto");
    permission_expect(not session_permissions_save(&state, session.as_str(), &policy, false, "strict").is_ok(), "active execution forbids policy preference mutation")?;
    permission_expect(cli_json_string(session_permissions_load(&state, session.as_str())?.root(), "mode")?.as_str() == "full", "active request retains full snapshot")?;
    cli_state_finish(&state, &mut running, "idle")?;
    session_permissions_save(&state, session.as_str(), &policy, false, "strict")?;
    let modes = cli_state_modes(&state, session.as_str())?;
    permission_expect(modes.root().object_get("goal")?.object_get("requests")?.number_i64()? == 17 and modes.root().object_has("session_origin"), "preference update preserves budget and origin")?;
    let branch = session_branch(&state, session.as_str(), "branch")?;
    permission_expect(cli_json_string(session_permissions_load(&state, branch.as_str())?.root(), "mode")?.as_str() == "auto", "local branch inherits selected permission")?;
    let imported = project_history_import_modes(modes.serialize_string()?.as_str())?;
    permission_expect(not imported.root().object_has("cli_permissions"), "untrusted independent history cannot grant permissions")?;
    permission_apply(&mut policy, "manual");
    session_permissions_save(&state, session.as_str(), &policy, true, "backend")?;
    let backend = session_permissions_load(&state, session.as_str())?;
    permission_expect(backend.root().object_get("allow_commands")?.bool_value()? and cli_json_string(backend.root(), "profile")?.as_str() == "backend", "explicit command and backend selections are durable")?;
    permission_expect(not session_permissions_value("bogus", true, "strict").is_ok() and not session_permissions_value("full", true, "bogus").is_ok(), "invalid selections cannot grant authority")?;
    Result { is_ok: true, value: true, error: 0 }
}

def main() -> i64 {
    let arguments = cli_arguments(); if not arguments.is_ok() { return 2; };
    let database = cli_option(&arguments.value, "database", "").unwrap_or(string_new()); if database.len() == 0 { return 2; };
    let result = permission_memory_tests(database.as_str());
    if not result.is_ok() { println(result.error); return 1; };
    println("session permissions: idle persistence, Plan, active isolation, budgets, branch and import boundaries passed"); 0
}
