import policy;
import std::system;

// Single-coordinator state. ProviderJob and tool ownership stay in main.
// States: 0 runnable, 1 waiting for children, 2 finished, 3 canceled.
struct SchedulerTask {
    id: i64,
    parent: i64,
    connection: String,
    cwd: String,
    write_capable: bool,
    // phase, model permit, write permit, pending write, error, unreported call,
    // write queue ticket (ordered by request arrival, not task creation)
    state: Vec<i64>,
    // Live tool leases. A cancellation request is not proof of process exit.
    jobs: Vec<i64>,
}

struct Scheduler {
    tasks: Vec<SchedulerTask>,
    // global limit, per-connection limit, next stable id, next write ticket,
    // next stable tool lease
    control: Vec<i64>,
}

def scheduler_make(global_limit: i64, connection_limit: i64) -> Scheduler {
    let control: Vec<i64> = vec_new();
    control.push(global_limit);
    control.push(connection_limit);
    control.push(1);
    control.push(1);
    control.push(1);
    let tasks: Vec<SchedulerTask> = vec_new();
    Scheduler { tasks: tasks, control: control }
}

def scheduler_new() -> Scheduler { scheduler_make(4, 2) }

def scheduler_with_limits(global_limit: i64, connection_limit: i64) -> Result<Scheduler, i64> {
    let valid = global_limit >= 1 and global_limit <= 8 and connection_limit >= 1 and connection_limit <= global_limit;
    Result { is_ok: valid, value: scheduler_make(if valid { global_limit } else { 4 }, if valid { connection_limit } else { 2 }), error: if valid { 0 } else { 2 } }
}

def scheduler_bool(value: bool, error: i64) -> Result<bool, i64> {
    Result { is_ok: error == 0, value: value, error: error }
}

def scheduler_slot(scheduler: &Scheduler, id: i64) -> i64 {
    let mut index = 0;
    while index < scheduler.tasks.len() {
        let task: &SchedulerTask = scheduler.tasks.get(index);
        if task.id == id { return index; };
        index = index + 1;
    };
    -1
}

def scheduler_flag(task: &SchedulerTask, flag: i64) -> i64 {
    task.state.get(flag).unwrap_or(0)
}

def scheduler_state(scheduler: &Scheduler, id: i64) -> i64 {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return -3; };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    scheduler_flag(task, 0)
}

def scheduler_error(scheduler: &Scheduler, id: i64) -> i64 {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return 3; };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    scheduler_flag(task, 4)
}

def scheduler_children_pending(scheduler: &Scheduler, parent: i64) -> bool {
    let mut index = 0;
    while index < scheduler.tasks.len() {
        let child: &SchedulerTask = scheduler.tasks.get(index);
        if child.parent == parent and (scheduler_flag(child, 0) < 2 or scheduler_resources_pending(child)) { return true; };
        index = index + 1;
    };
    false
}

def scheduler_resources_pending(task: &SchedulerTask) -> bool {
    scheduler_flag(task, 1) != 0 or scheduler_flag(task, 2) != 0 or scheduler_flag(task, 5) != 0 or task.jobs.len() != 0
}

// Terminal leaf records are removed before their parents. Never reuse an id;
// late completion/cancel notifications cannot target a new task in an old slot.
def scheduler_reap(scheduler: &Scheduler) -> i64 {
    let mut removed = 0;
    let mut changed = true;
    while changed {
        changed = false;
        let mut index = scheduler.tasks.len() - 1;
        while index >= 0 {
            let task: &SchedulerTask = scheduler.tasks.get(index);
            let id = task.id;
            let terminal = scheduler_flag(task, 0) >= 2 and not scheduler_resources_pending(task);
            let mut has_child = false;
            let mut other_index = 0;
            while other_index < scheduler.tasks.len() {
                let other: &SchedulerTask = scheduler.tasks.get(other_index);
                if other.parent == id { has_child = true; };
                other_index = other_index + 1;
            };
            if terminal and not has_child {
                scheduler.tasks.remove(index);
                removed = removed + 1;
                changed = true;
            };
            index = index - 1;
        };
    };
    removed
}

def scheduler_add(scheduler: &Scheduler, parent: i64, connection: &str, cwd: &str, write_capable: bool) -> Result<i64, i64> {
    if connection.len() == 0 or connection.len() > 256 or cwd.len() == 0 or cwd.len() > 32768 { return cli_fail(2); };
    if parent != 0 {
        let parent_index = scheduler_slot(scheduler, parent);
        if parent_index < 0 { return cli_fail(3); };
        let parent_task: &SchedulerTask = scheduler.tasks.get(parent_index);
        if scheduler_flag(parent_task, 0) >= 2 { return cli_fail(19); };
        if parent_task.parent != 0 or write_capable and not parent_task.write_capable { return cli_fail(7); };
    };
    if scheduler.tasks.len() >= 128 { scheduler_reap(scheduler); (); };
    if scheduler.tasks.len() >= 128 { return cli_fail(13); };
    let id = scheduler.control.get(2).unwrap_or(0);
    if id <= 0 or id >= 9223372036854775807 { return cli_fail(13); };
    let directory = canonical_path_string(cwd)?;
    let captured_connection = string_from_str(connection)?;
    let state: Vec<i64> = vec_new();
    let mut field = 0;
    while field < 7 { if not state.push(0) { return cli_fail(8); }; field = field + 1; };
    let jobs: Vec<i64> = vec_new();
    let task = SchedulerTask { id: id, parent: parent, connection: captured_connection, cwd: directory, write_capable: write_capable, state: state, jobs: jobs };
    if not scheduler.tasks.push(task) { return cli_fail(8); };
    scheduler.control.set(2, id + 1);
    cli_ok(id)
}

def scheduler_model_count(scheduler: &Scheduler, connection: &str) -> i64 {
    let mut count = 0;
    let mut index = 0;
    while index < scheduler.tasks.len() {
        let task: &SchedulerTask = scheduler.tasks.get(index);
        if scheduler_flag(task, 1) != 0 and (connection.len() == 0 or task.connection.as_str() == connection) { count = count + 1; };
        index = index + 1;
    };
    count
}

def scheduler_acquire_model(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    let phase = scheduler_flag(task, 0);
    if phase >= 2 { return scheduler_bool(false, if phase == 3 { 19 } else { 3 }); };
    if phase == 1 {
        if scheduler_children_pending(scheduler, id) { return scheduler_bool(false, 0); };
        task.state.set(0, 0);
        ();
    };
    if scheduler_flag(task, 1) != 0 { return scheduler_bool(true, 0); };
    if scheduler_model_count(scheduler, "") >= scheduler.control.get(0).unwrap_or(4) or scheduler_model_count(scheduler, task.connection.as_str()) >= scheduler.control.get(1).unwrap_or(2) { return scheduler_bool(false, 0); };
    task.state.set(1, 1);
    scheduler_bool(true, 0)
}

def scheduler_release_model(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 5) != 0 { return scheduler_bool(false, 6); };
    let held = scheduler_flag(task, 1) != 0;
    task.state.set(1, 0);
    scheduler_bool(held, 0)
}

// Explicit write permits cover tools, never an entire model stream. Waiting
// writers are FIFO within canonical cwd; read-only model jobs stay parallel.
def scheduler_acquire_write(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    let phase = scheduler_flag(task, 0);
    if phase >= 2 { return scheduler_bool(false, if phase == 3 { 19 } else { 3 }); };
    if not task.write_capable { return scheduler_bool(false, 7); };
    if phase == 1 and scheduler_children_pending(scheduler, id) { return scheduler_bool(false, 0); };
    if scheduler_flag(task, 2) != 0 { return scheduler_bool(true, 0); };
    if scheduler_flag(task, 3) == 0 {
        let ticket = scheduler.control.get(3).unwrap_or(0);
        if ticket <= 0 or ticket >= 9223372036854775807 { return scheduler_bool(false, 13); };
        task.state.set(3, 1);
        task.state.set(6, ticket);
        scheduler.control.set(3, ticket + 1);
        ();
    };
    let mut other_index = 0;
    while other_index < scheduler.tasks.len() {
        let other: &SchedulerTask = scheduler.tasks.get(other_index);
        if other.id != id and other.cwd.as_str() == task.cwd.as_str() {
            // Canceled owners retain their lease until explicit quiescence.
            if scheduler_flag(other, 2) != 0 or scheduler_flag(other, 0) == 0 and scheduler_flag(other, 3) != 0 and scheduler_flag(other, 6) < scheduler_flag(task, 6) { return scheduler_bool(false, 0); };
        };
        other_index = other_index + 1;
    };
    task.state.set(0, 0);
    task.state.set(2, 1);
    scheduler_bool(true, 0)
}

def scheduler_release_write(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if task.jobs.len() != 0 or scheduler_flag(task, 0) == 3 and scheduler_flag(task, 2) != 0 { return scheduler_bool(false, 6); };
    let held = scheduler_flag(task, 2) != 0;
    task.state.set(2, 0);
    task.state.set(3, 0);
    task.state.set(6, 0);
    scheduler_bool(held, 0)
}

// Begin only after complete input validation, durable claim and permission.
// Every process/hook/MCP worker must retain a lease until its owner can prove
// that cancellation has stopped the worker and its entire process tree.
def scheduler_begin_tool(scheduler: &Scheduler, id: i64) -> Result<i64, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return cli_fail(3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 0) != 0 { return cli_fail(19); };
    let token = scheduler.control.get(4).unwrap_or(0);
    if token <= 0 or token >= 9223372036854775807 { return cli_fail(13); };
    if task.jobs.len() >= 128 { return cli_fail(13); };
    if not task.jobs.push(token) { return cli_fail(8); };
    scheduler.control.set(4, token + 1);
    cli_ok(token)
}

def scheduler_end_tool(scheduler: &Scheduler, id: i64, token: i64, quiescent: bool) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    let mut job_index = 0;
    while job_index < task.jobs.len() {
        if task.jobs.get(job_index).unwrap_or(0) == token {
            if not quiescent { return scheduler_bool(false, 6); };
            task.jobs.remove(job_index);
            return scheduler_bool(true, 0);
        };
        job_index = job_index + 1;
    };
    scheduler_bool(false, 0)
}

// Explicit owner attestation after live ProviderJob/tool cleanup. A heartbeat,
// canceled flag, timeout, or unknown tool outcome cannot certify quiescence.
def scheduler_confirm_quiescent(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 0) != 3 { return scheduler_bool(false, 2); };
    if task.jobs.len() != 0 or scheduler_flag(task, 5) != 0 or scheduler_children_pending(scheduler, id) { return scheduler_bool(false, 6); };
    task.state.set(1, 0);
    task.state.set(2, 0);
    task.state.set(3, 0);
    task.state.set(6, 0);
    scheduler_bool(true, 0)
}

def scheduler_wait_children(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 0) >= 2 { return scheduler_bool(false, 19); };
    // A pending provider request must first be canceled/completed and its
    // observed usage reported. Never hide a live request by releasing its slot.
    if scheduler_flag(task, 5) != 0 or task.jobs.len() != 0 { return scheduler_bool(false, 6); };
    scheduler_release_model(scheduler, id)?;
    scheduler_release_write(scheduler, id)?;
    let pending = scheduler_children_pending(scheduler, id);
    task.state.set(0, if pending { 1 } else { 0 });
    scheduler_bool(not pending, 0)
}

// A bounded wait returning a snapshot is not an indefinite join. Do not grant
// permits here: the normal model/write capacity and FIFO checks still apply.
def scheduler_resume_wait(scheduler: &Scheduler, id: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 0) >= 2 { return scheduler_bool(false, 19); };
    if scheduler_flag(task, 0) == 1 { task.state.set(0, 0); (); };
    scheduler_bool(true, 0)
}

def scheduler_finish(scheduler: &Scheduler, id: i64, error: i64) -> Result<bool, i64> {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return scheduler_bool(false, 3); };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_children_pending(scheduler, id) or scheduler_flag(task, 5) != 0 or task.jobs.len() != 0 { return scheduler_bool(false, 6); };
    scheduler_release_model(scheduler, id)?;
    scheduler_release_write(scheduler, id)?;
    if scheduler_flag(task, 0) != 3 { task.state.set(0, 2); task.state.set(4, error); (); };
    scheduler_bool(true, 0)
}

def scheduler_cancel_tree(scheduler: &Scheduler, id: i64) -> bool {
    if scheduler_slot(scheduler, id) < 0 { return false; };
    let mut index = 0;
    while index < scheduler.tasks.len() {
        let task: &SchedulerTask = scheduler.tasks.get(index);
        if (task.id == id or task.parent == id) and scheduler_flag(task, 0) < 2 {
            task.state.set(0, 3);
            if scheduler_flag(task, 5) == 0 { task.state.set(1, 0); (); };
            // Remove a waiting writer immediately. An acquired writer instead
            // keeps its permit until scheduler_confirm_quiescent succeeds.
            task.state.set(3, 0);
            task.state.set(4, 19);
            task.state.set(6, 0);
            ();
        };
        index = index + 1;
    };
    true
}

def scheduler_cancel_all(scheduler: &Scheduler) {
    let mut index = 0;
    while index < scheduler.tasks.len() {
        let task: &SchedulerTask = scheduler.tasks.get(index);
        scheduler_cancel_tree(scheduler, task.id);
        index = index + 1;
    };
    ();
}

def scheduler_is_cancelled(scheduler: &Scheduler, id: i64) -> bool {
    let phase = scheduler_state(scheduler, id);
    phase == 3 or phase == -3
}

// All parents, children, consultations, compaction and verification requests
// pass the SAME GoalState. Reserve once immediately before ProviderJob start.
def scheduler_take_request(scheduler: &Scheduler, id: i64, goal: &mut GoalState) -> bool {
    let index = scheduler_slot(scheduler, id);
    if index < 0 { return false; };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 0) != 0 or scheduler_flag(task, 1) == 0 or scheduler_flag(task, 5) != 0 { return false; };
    if not goal_accept_request(goal) { scheduler_cancel_all(scheduler); return false; };
    task.state.set(5, 1);
    true
}

// Report even a failed/canceled start with zero observed tokens. Repeated poll
// or terminal notifications cannot charge the same reservation twice.
def scheduler_report_usage(scheduler: &Scheduler, id: i64, goal: &mut GoalState, tokens: i64) -> bool {
    let index = scheduler_slot(scheduler, id);
    if index < 0 or tokens < 0 { return false; };
    let task: &SchedulerTask = scheduler.tasks.get(index);
    if scheduler_flag(task, 5) == 0 { return false; };
    task.state.set(5, 0);
    if scheduler_flag(task, 0) == 3 { task.state.set(1, 0); (); };
    if tokens > 9223372036854775807 - goal.tokens {
        goal.tokens = 9223372036854775807;
        goal.status = 3;
        scheduler_cancel_all(scheduler);
        return true;
    };
    goal_usage(goal, tokens);
    if goal.status == 3 { scheduler_cancel_all(scheduler); };
    true
}
