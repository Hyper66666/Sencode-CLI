import common;

struct AgentPolicy {
    plan: bool,
    auto_edit: bool,
    full_access: bool,
    interactive: bool,
    depth: i64,
    maximum_depth: i64,
}

def policy_default() -> AgentPolicy {
    AgentPolicy { plan: false, auto_edit: false, full_access: false, interactive: true, depth: 0, maximum_depth: 1 }
}

// Plan is a foreground-turn overlay, independent of remembered permissions.
// Call only after the captured execution has finished/cancelled/failed; its
// children retain their captured read-only policy until cleanup is confirmed.
def policy_finish_plan(policy: &mut AgentPolicy) { policy.plan = false; }

// 0 = allow, 1 = ask, 2 = deny. Unknown tools never acquire privileges.
def policy_decision(policy: &AgentPolicy, tool: &str, exact_plan_file: bool) -> i64 {
    if tool == "read_file" or tool == "list_directory" or tool == "search" or tool == "find_files" or tool == "git_status" or tool == "git_diff" or tool == "ask_user" { return 0; };
    if tool == "spawn_agent" {
        if policy.depth >= policy.maximum_depth { return 2; };
        return 0;
    };
    if tool == "list_agents" or tool == "wait_agents" or tool == "cancel_agent" or tool == "list_models" { return if policy.depth == 0 { 0 } else { 2 }; };
    if policy.plan {
        if tool == "write_plan" and exact_plan_file { return 0; };
        return 2;
    };
    if tool == "write_file" or tool == "apply_patch" or tool == "write_plan" {
        if policy.auto_edit or policy.full_access { return 0; };
        return 1;
    };
    if tool == "run_command" or tool == "mcp__list_tools" or tool == "mcp__call" { return if policy.full_access { 0 } else { 1 }; };
    2
}

def policy_child(parent: &AgentPolicy, role: &str) -> AgentPolicy {
    let read_only = parent.plan or role == "explore" or role == "plan";
    AgentPolicy { plan: read_only, auto_edit: parent.auto_edit and not read_only, full_access: parent.full_access and not read_only, interactive: parent.interactive, depth: parent.depth + 1, maximum_depth: parent.maximum_depth }
}

struct GoalState {
    status: i64,
    requests: i64,
    max_requests: i64,
    tokens: i64,
    token_budget: i64,
    same_failure_count: i64,
    last_failure: String,
}

// status: 0 inactive, 1 active, 2 paused, 3 budget_limited, 4 complete, 5 blocked.
def goal_new(max_requests: i64, token_budget: i64) -> GoalState {
    GoalState { status: 1, requests: 0, max_requests: max_requests, tokens: 0, token_budget: token_budget, same_failure_count: 0, last_failure: string_new() }
}

def goal_accept_request(goal: &mut GoalState) -> bool {
    if goal.status != 1 { return false; };
    if goal.requests >= goal.max_requests or goal.token_budget > 0 and goal.tokens >= goal.token_budget { goal.status = 3; return false; };
    goal.requests = goal.requests + 1;
    true
}

def goal_usage(goal: &mut GoalState, tokens: i64) {
    if tokens > 0 {
        if goal.tokens > 9223372036854775807 - tokens { goal.tokens = 9223372036854775807; goal.status = 3; } else { goal.tokens = goal.tokens + tokens; };
    };
    if goal.token_budget > 0 and goal.tokens >= goal.token_budget { goal.status = 3; };
    ();
}

def goal_verify(goal: &mut GoalState, checks_passed: bool, verifier_available: bool, failure: &str) {
    if not verifier_available { goal.status = 2; goal.last_failure = cli_text(failure); return; };
    if checks_passed { goal.status = 4; goal.last_failure.clear(); goal.same_failure_count = 0; return; };
    if goal.last_failure.as_str() == failure { goal.same_failure_count = goal.same_failure_count + 1; } else { goal.last_failure = cli_text(failure); goal.same_failure_count = 1; };
    if goal.same_failure_count >= 2 { goal.status = 2; };
    ();
}

def goal_restore(goal: &mut GoalState) {
    if goal.status == 1 { goal.status = 2; };
    ();
}
