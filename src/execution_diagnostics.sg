import engine_control;
import policy;

def execution_diagnostic_child(input: &Vec<TerminalEvent>, stage: &str, child: i64, tool: &str, call_id: &str) -> Result<bool, i64> {
    if not engine_control_enabled(input) { return Result { is_ok: true, value: false, error: 0 }; };
    let previous = execution_diagnostic_saved(input)?;
    if previous.root().object_has("reason") { return Result { is_ok: true, value: false, error: 0 }; };
    execution_diagnostic_failure(input, "child_coordination_failed", stage, tool, call_id, false)?;
    let document = execution_diagnostic_saved(input)?;
    cli_put_i64(&document, document.root(), "child_task_id", child)?;
    execution_diagnostic_store(input, &document)
}

def execution_diagnostic_budget(input: &Vec<TerminalEvent>, goal: &GoalState) -> Result<bool, i64> {
    execution_diagnostic_failure(input, "budget", "budget", "", "", false)?;
    let document = execution_diagnostic_saved(input)?;
    cli_put_i64(&document, document.root(), "requests", goal.requests)?;
    cli_put_i64(&document, document.root(), "max_requests", goal.max_requests)?;
    cli_put_i64(&document, document.root(), "tokens", goal.tokens)?;
    cli_put_i64(&document, document.root(), "token_budget", goal.token_budget)?;
    execution_diagnostic_store(input, &document)
}

// Never include response bodies, URLs, headers or credentials in diagnostics.
def execution_network_label(status: i64, code: i64) -> Result<String, i64> {
    if status >= 300 and status <= 599 {
        let text = cli_text("HTTP "); text.push_i64(status)?;
        text.push_str(if status == 429 { " Too Many Requests" } else { if status == 500 { " Internal Server Error" } else { if status == 502 { " Bad Gateway" } else { if status == 503 { " Service Unavailable" } else { if status == 504 { " Gateway Timeout" } else { if status == 401 { " Unauthorized" } else { if status == 403 { " Forbidden" } else { if status == 400 { " Bad Request" } else { "" } } } } } } } })?;
        return Result { is_ok: true, value: text, error: 0 };
    };
    if status >= 200 and status <= 299 {
        let text = execution_network_label(0, code)?;
        text.push_str(" (HTTP ")?; text.push_i64(status)?; text.push_str(" received)")?;
        return Result { is_ok: true, value: text, error: 0 };
    };
    if code == 9 { return string_from_str("Network connection / I/O failed"); };
    if code == 11 { return string_from_str("Network timeout"); };
    if code == 15 { return string_from_str("TLS certificate verification failed"); };
    if code == 16 { return string_from_str("TLS hostname verification failed"); };
    if code == 17 { return string_from_str("TLS handshake failed"); };
    if code == 18 { return string_from_str("TLS unavailable"); };
    if code == 19 { return string_from_str("Request cancelled"); };
    if code == 10 { return string_from_str("Invalid or incomplete provider response"); };
    let text = cli_text("Request error "); text.push_i64(code)?;
    Result { is_ok: true, value: text, error: 0 }
}

def execution_diagnostic_response(input: &Vec<TerminalEvent>, stage: &str, detail: &str) -> Result<bool, i64> {
    if not engine_control_enabled(input) { return Result { is_ok: true, value: false, error: 0 }; };
    let document = execution_diagnostic_saved(input)?;
    cli_put_string(&document, document.root(), "response_stage", stage)?;
    cli_put_string(&document, document.root(), "response_failure", detail)?;
    execution_diagnostic_store(input, &document)
}

def execution_diagnostic_network(input: &Vec<TerminalEvent>, status: i64, code: i64, attempts: i64, stopped: &str) -> Result<bool, i64> {
    if not engine_control_enabled(input) { return Result { is_ok: true, value: false, error: 0 }; };
    let document = execution_diagnostic_saved(input)?;
    cli_put_i64(&document, document.root(), "http_status", status)?;
    cli_put_i64(&document, document.root(), "transport_error", code)?;
    cli_put_i64(&document, document.root(), "attempts", attempts)?;
    cli_put_i64(&document, document.root(), "retries", if attempts > 0 { attempts - 1 } else { 0 })?;
    cli_put_i64(&document, document.root(), "max_retries", 5)?;
    cli_put_string(&document, document.root(), "network_error", execution_network_label(status, code)?.as_str())?;
    cli_put_string(&document, document.root(), "retry_stopped", stopped)?;
    execution_diagnostic_store(input, &document)
}

// Actor-local host metadata, never a key event. Raw-TTY callers are no-ops so
// this private record cannot be replayed by the line editor as user input.
// Numeric error codes retain their published meaning; stage/reason add context.
def execution_diagnostic_reset(input: &Vec<TerminalEvent>) {
    if engine_control_enabled(input) { engine_control_remove(input, 98); };
}

def execution_diagnostic_saved(input: &Vec<TerminalEvent>) -> Result<JsonDoc, i64> {
    let index = engine_control_slot(input, 98);
    if not engine_control_enabled(input) or index < 0 { return json_doc_object(); };
    let record: &TerminalEvent = input.get(index);
    json_parse(record.data.as_str())
}

def execution_diagnostic_store(input: &Vec<TerminalEvent>, document: &JsonDoc) -> Result<bool, i64> {
    if not engine_control_enabled(input) { return Result { is_ok: true, value: false, error: 0 }; };
    let encoded = document.serialize_string()?;
    engine_control_remove(input, 98);
    if not input.push(engine_control_record(98, 0, encoded.as_str())) { return Result { is_ok: false, value: false, error: 8 }; };
    Result { is_ok: true, value: true, error: 0 }
}

def execution_diagnostic_stage(input: &Vec<TerminalEvent>, stage: &str, tool: &str, call_id: &str) -> Result<bool, i64> {
    if not engine_control_enabled(input) { return Result { is_ok: true, value: false, error: 0 }; };
    let document = execution_diagnostic_saved(input)?;
    // Cleanup must not replace the original terminal failure's attribution.
    if document.root().object_has("reason") { return Result { is_ok: true, value: false, error: 0 }; };
    cli_put_string(&document, document.root(), "stage", stage)?;
    cli_put_string(&document, document.root(), "tool", tool)?;
    cli_put_string(&document, document.root(), "call_id", call_id)?;
    execution_diagnostic_store(input, &document)
}

def execution_diagnostic_failure(input: &Vec<TerminalEvent>, reason: &str, stage: &str, tool: &str, call_id: &str, outcome_unknown: bool) -> Result<bool, i64> {
    if not engine_control_enabled(input) { return Result { is_ok: true, value: false, error: 0 }; };
    let document = execution_diagnostic_saved(input)?;
    if document.root().object_has("reason") {
        // Retain the first cause; later cleanup uncertainty may strengthen,
        // never weaken, the no-replay requirement.
        if outcome_unknown { cli_put_bool(&document, document.root(), "outcome_unknown", true)?; return execution_diagnostic_store(input, &document); };
        return Result { is_ok: true, value: false, error: 0 };
    };
    cli_put_string(&document, document.root(), "reason", reason)?;
    cli_put_string(&document, document.root(), "stage", stage)?;
    cli_put_string(&document, document.root(), "tool", tool)?;
    cli_put_string(&document, document.root(), "call_id", call_id)?;
    cli_put_bool(&document, document.root(), "outcome_unknown", outcome_unknown)?;
    execution_diagnostic_store(input, &document)
}

def execution_diagnostic_document(input: &Vec<TerminalEvent>, code: i64) -> Result<JsonDoc, i64> {
    let document = execution_diagnostic_saved(input)?;
    let stage = cli_json_optional_string(document.root(), "stage");
    if not document.root().object_has("reason") {
        let reason = if code == 19 { "cancelled" } else { if stage.as_str() == "provider" { "provider_request" } else { if stage.as_str() == "budget" { "budget" } else { if stage.as_str() == "context" { "context" } else { if stage.as_str() == "tool" or stage.as_str() == "tool_commit" { "tool_failed" } else { "execution_failed" } } } } };
        cli_put_string(&document, document.root(), "reason", reason)?;
        ();
    };
    cli_put_i64(&document, document.root(), "schema", 1)?;
    cli_put_i64(&document, document.root(), "code", code)?;
    let unknown = document.root().object_has("outcome_unknown") and document.root().object_get("outcome_unknown")?.bool_value()?;
    cli_put_bool(&document, document.root(), "automatic_replay_forbidden", unknown)?;
    Result { is_ok: true, value: document, error: 0 }
}

def execution_diagnostic_content(document: &JsonDoc) -> Result<String, i64> {
    let reason = cli_json_optional_string(document.root(), "reason");
    let unknown = document.root().object_has("outcome_unknown") and document.root().object_get("outcome_unknown")?.bool_value()?;
    if not unknown and reason.as_str() == "child_coordination_failed" {
        let text = cli_text("Execution paused: local child coordination failed at "); text.push_str(cli_json_optional_string(document.root(), "stage").as_str())?;
        let child = cli_json_optional_i64(document.root(), "child_task_id", 0);
        if child > 0 { text.push_str(" for Agent #")?; text.push_i64(child)?; (); };
        let tool = cli_json_optional_string(document.root(), "tool");
        if tool.len() > 0 { text.push_str(" (")?; text.push_str(tool.as_str())?; text.push_str(")")?; (); };
        text.push_str("; code ")?; text.push_i64(cli_json_optional_i64(document.root(), "code", 1))?;
        text.push_str(". Completed tool results were retained. The parent request was stopped for cleanup; this was not a user cancellation or an HTTP response error. Completed tools will not be replayed.")?;
        return Result { is_ok: true, value: text, error: 0 };
    };
    if not unknown and reason.as_str() == "budget" and document.root().object_has("requests") {
        let text = cli_text("Paused at your configured budget: ");
        let maximum = cli_json_optional_i64(document.root(), "max_requests", 0);
        text.push_i64(cli_json_optional_i64(document.root(), "requests", 0))?;
        if maximum > 0 { text.push_str("/")?; text.push_i64(maximum)?; (); }; text.push_str(" model requests")?;
        let tokens = cli_json_optional_i64(document.root(), "token_budget", 0);
        if tokens > 0 { text.push_str("; ")?; text.push_i64(cli_json_optional_i64(document.root(), "tokens", 0))?; text.push_str("/")?; text.push_i64(tokens)?; text.push_str(" tokens")?; (); };
        text.push_str(". Context and completed tools were retained. Continue the conversation, or explicitly resume the Goal with its saved budget.")?;
        return Result { is_ok: true, value: text, error: 0 };
    };
    if not unknown and reason.as_str() == "request_state_failed" { return string_from_str("Execution paused: request evidence could not be saved. No new tool was executed after this failure. Saved results were retained; resume after state storage is available."); };
    if not unknown and reason.as_str() == "provider_request" and document.root().object_has("network_error") {
        let text = cli_json_string(document.root(), "network_error")?;
        let detail = cli_json_optional_string(document.root(), "response_failure");
        if detail.len() > 0 { text.push_str("; ")?; text.push_str(detail.as_str())?; (); };
        text.push_str("; retries ")?; text.push_i64(cli_json_optional_i64(document.root(), "retries", 0))?; text.push_str("/5. ")?;
        text.push_str(cli_json_optional_string(document.root(), "retry_stopped").as_str())?;
        text.push_str(". Completed tool results were retained.")?;
        return Result { is_ok: true, value: text, error: 0 };
    };
    if not unknown and str_starts_with(reason.as_str(), "goal_") {
        return string_from_str(if reason.as_str() == "goal_permission_required" { "Goal paused: acceptance commands need permission. Use /goal resume to retry with approval." } else {
            if reason.as_str() == "goal_checks_failed" { "Goal paused: acceptance checks failed twice without progress. Review their output, then use /goal resume after resolving the failure." } else {
            if reason.as_str() == "goal_verification_timeout" { "Goal paused: acceptance verification timed out. Review the check and use /goal resume when ready." } else { "Goal paused: acceptance verification could not run. Fix the verification environment, then use /goal resume." } }
        });
    };
    let text = cli_text(if unknown { "Execution paused: a tool outcome or process cleanup is unverified. Inspect the recorded outcome before retrying; automatic replay is forbidden." } else {
        if reason.as_str() == "provider_request" { "Model request failed. Completed tool results were retained; check the request details before continuing." } else {
        if reason.as_str() == "budget" { "Execution paused because its request or token budget could not continue." } else {
        if reason.as_str() == "context" { "Execution paused because complete model context could not be prepared; history was retained." } else {
        if reason.as_str() == "permission_required" { "Execution paused awaiting permission." } else {
        if reason.as_str() == "cancelled" { "Execution paused / cancelled." } else {
        if reason.as_str() == "ownership_lost" { "Execution paused because session ownership changed; inspect the current executor before resuming." } else {
        if reason.as_str() == "tool_failed" { "Tool execution failed; inspect the recorded tool details." } else { "Execution failed; inspect its recorded stage and error code." } } } } } } }
    });
    text.push_str(" (code ")?; text.push_i64(cli_json_optional_i64(document.root(), "code", 1))?; text.push_str(")")?;
    Result { is_ok: true, value: text, error: 0 }
}
