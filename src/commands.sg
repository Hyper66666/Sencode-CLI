import common;

// One registry supplies slash parsing, menus, help and host capability gates.
// A listed future command is never executable until its host enables it.
struct UiCommand {
    name: String, aliases: String, description: String, arguments: String,
    category: String, available: bool, during_run: bool, reason: String,
}
struct UiCommandMatch { index: i64, score: i64 }
struct UiCommandArgument { value: String, description: String }

def commands_add(items: &Vec<UiCommand>, name: &str, aliases: &str, description: &str, arguments: &str, category: &str, available: bool) {
    let immediate = name == "/help" or name == "/context" or name == "/usage" or name == "/agents" or name == "/connections" or name == "/model" or name == "/permissions" or name == "/quit" or name == "/copy" or name == "/queue" or name == "/keys" or name == "/read" or name == "/history" or name == "/stash";
    items.push(UiCommand { name: cli_text(name), aliases: cli_text(aliases), description: cli_text(description), arguments: cli_text(arguments), category: cli_text(category), available: available, during_run: immediate, reason: cli_text(if available { "" } else { "This host has not enabled this capability." }) }); ();
}

def commands_registry() -> Vec<UiCommand> {
    let items: Vec<UiCommand> = vec_new();
    commands_add(&items, "/model", "/models", "选择后续请求使用的模型", "[MODEL]", "Models", true);
    commands_add(&items, "/connections", "/connection", "切换 API 连接", "[ID]", "Models", true);
    commands_add(&items, "/resume", "/continue", "搜索并恢复会话", "[SESSION]", "Sessions", true);
    commands_add(&items, "/plan", "", "仅下一轮规划只读，结束或中断后退出", "[TASK|approve]", "Agents", true);
    commands_add(&items, "/goal", "", "持续目标、预算与恢复", "[TASK|pause|resume]", "Agents", true);
    commands_add(&items, "/agents", "/tasks", "查看子代理与任务", "", "Agents", true);
    commands_add(&items, "/consult", "", "多个模型并行会诊", "QUESTION", "Agents", true);
    commands_add(&items, "/skills", "", "发现并调用项目技能", "[NAME]", "Workspace", true);
    commands_add(&items, "/permissions", "/allowed-tools", "查看或修改操作权限 · Shift+Tab", "[ask|auto-edit|full|backend]", "Workspace", true);
    commands_add(&items, "/context", "", "查看当前会话上下文", "", "Sessions", true);
    commands_add(&items, "/compact", "", "压缩上下文并保留任务", "", "Sessions", true);
    commands_add(&items, "/usage", "/cost", "按 API 查看用量", "", "Models", true);
    commands_add(&items, "/copy", "", "复制最新回答或选择代码块", "[code]", "Interface", true);
    commands_add(&items, "/history", "", "搜索本会话最近十条输入", "[SEARCH]", "Interface", false);
    commands_add(&items, "/stash", "", "暂存、恢复或交换输入草稿", "", "Interface", false);
    commands_add(&items, "/queue", "", "查看、编辑或取消待发任务", "[pause|resume|clear]", "Interface", false);
    commands_add(&items, "/keys", "", "编辑键位与 Vim 输入模式", "[default|vim|show|reset]", "Interface", false);
    commands_add(&items, "/read", "", "阅读历史输出并保留输入草稿", "", "Interface", false);
    commands_add(&items, "/terminal", "/term", "打开由你操作的工作区终端", "[powershell|cmd]", "Workspace", false);
    commands_add(&items, "/worktree", "/worktrees", "查看或明确管理 Git 工作树", "[list|create PATH|remove PATH|cancel]", "Workspace", false);
    commands_add(&items, "/help", "", "命令与键盘操作说明", "", "Interface", true);
    commands_add(&items, "/quit", "/exit", "退出并暂停前台任务", "", "Interface", true);
    commands_add(&items, "/new", "/clear /reset", "新建会话", "", "Sessions", false);
    commands_add(&items, "/rename", "", "修改当前会话名称", "TITLE", "Sessions", false);
    commands_add(&items, "/export", "", "导出当前会话", "[PATH]", "Sessions", false);
    commands_add(&items, "/branch", "/fork", "从当前会话创建分支", "[TITLE]", "Sessions", false);
    commands_add(&items, "/rewind", "", "查看与恢复文件检查点", "[CHECKPOINT]", "Sessions", false);
    commands_add(&items, "/mcp", "", "管理本地 MCP 服务", "[list|doctor]", "Workspace", false);
    commands_add(&items, "/diff", "", "查看工作区修改", "", "Workspace", false);
    commands_add(&items, "/memory", "", "查看项目指令与记忆", "", "Workspace", false);
    commands_add(&items, "/doctor", "", "诊断安装与连接环境", "", "Interface", false);
    commands_add(&items, "/config", "", "查看当前配置与来源", "", "Interface", false);
    commands_add(&items, "/hooks", "", "管理生命周期 hooks", "", "Extensions", false);
