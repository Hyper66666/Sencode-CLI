import model_selection;
import config_catalog;
import command_line;

def effort_expect(value: bool, label: &str) -> Result<bool, i64> {
    if not value { cli_diagnostic(label); return state_bool_error(99); };
    Result { is_ok: true, value: true, error: 0 }
}

def effort_store(state: &CliState, id: &str, config: &str) -> Result<bool, i64> {
    let mut insert = state.db.prepare("INSERT INTO connection_configs(id,kind,profile_scope,display_name,config_json,selected_model_id,created_at,updated_at) VALUES(?,'customApi','managed','Disposable effort fixture',?,'one',1,1)")?;
    insert.bind_text(1, id)?; insert.bind_text(2, config)?; insert.step()?;
    Result { is_ok: true, value: true, error: 0 }
}

def effort_projection_tests(database: &str) -> Result<bool, i64> {
    let state = cli_state_open(database)?;
    effort_store(&state, "effort-medium", "{\"baseUrl\":\"https://fixture.invalid/v1\",\"protocol\":\"responses\",\"enabledModels\":[{\"id\":\"one\"}],\"capabilities\":{\"supportedReasoningEfforts\":[\"medium\",\"xhigh\"]}}")?;
    effort_store(&state, "effort-denied", "{\"baseUrl\":\"https://fixture.invalid/v1\",\"protocol\":\"responses\",\"enabledModels\":[{\"id\":\"one\",\"reasoningEfforts\":[\"medium\"]}],\"capabilities\":{\"supportsReasoningEffort\":false}}")?;
    effort_store(&state, "effort-subset", "{\"baseUrl\":\"https://fixture.invalid/v1\",\"protocol\":\"responses\",\"enabledModels\":[{\"id\":\"one\"}],\"capabilities\":{\"supportedReasoningEfforts\":[\"low\",\"high\"]}}")?;
    let snapshot = config_snapshot(&state)?;
    let medium = model_selection_target(&snapshot, "effort-medium", "one", "")?;
    effort_expect(cli_json_string(medium.root(), "effort")?.as_str() == "medium", "saved public picker advertises actual medium default")?;
    let medium_record = cli_state_connection(&state, "effort-medium")?;
    effort_expect(connection_normalize(&medium_record, "one").value.effort_id() == "medium", "saved request and public picker agree on medium")?;
    let denied = model_selection_target(&snapshot, "effort-denied", "one", "")?;
    effort_expect(cli_json_string(denied.root(), "effort")?.len() == 0 and not model_selection_target(&snapshot, "effort-denied", "one", "medium").is_ok(), "saved connection supportsReasoningEffort=false overrides model list in picker")?;
    let denied_record = cli_state_connection(&state, "effort-denied")?;
    effort_expect(connection_normalize(&denied_record, "one").value.effort_id() == "", "saved request applies the same explicit capability denial")?;
    let subset = model_selection_target(&snapshot, "effort-subset", "one", "")?;
    effort_expect(cli_json_string(subset.root(), "effort")?.len() == 0 and not model_selection_target(&snapshot, "effort-subset", "one", "medium").is_ok(), "saved supportedReasoningEfforts subset remains narrowed in picker")?;
    let subset_record = cli_state_connection(&state, "effort-subset")?;
    effort_expect(connection_normalize(&subset_record, "one").value.effort_id() == "", "saved request preserves subset without medium")?;
    state.db.exec("DELETE FROM connection_configs WHERE id IN('effort-medium','effort-denied','effort-subset')")?;
    Result { is_ok: true, value: true, error: 0 }
}

def main() -> i64 {
    let arguments = cli_arguments(); if not arguments.is_ok() { return 2; };
    let database = cli_option(&arguments.value, "database", "");
    if not database.is_ok() or database.value.len() == 0 { cli_diagnostic("Use --database with an isolated temporary fixture database"); return 2; };
    let result = effort_projection_tests(database.value.as_str());
    if not result.is_ok() { println(result.error); return 1; };
    println("medium effort: saved picker/request agreement, capability denial and subset admission passed"); 0
}
