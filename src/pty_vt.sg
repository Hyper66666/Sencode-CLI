import std::string;
import std::collections;
import std::ffi;
import std::unicode;

// Bounded, monochrome VT screen. Bytes from a child never become outer-terminal
// controls. OSC/DCS/APC/PM/SOS are consumed without replies or side effects.
struct PtyVtCell { text: String, width: i64 }
struct PtyVt {
    columns: i64, rows: i64, cells: Vec<PtyVtCell>, x: i64, y: i64,
    saved_x: i64, saved_y: i64, top: i64, bottom: i64, wrap: bool,
    mode: i64, params: String, string_escape: bool,
    utf8: Buffer, wanted: i64, cluster: UnicodeGraphemeState,
    last_x: i64, last_y: i64, bracketed_paste: bool, cursor_visible: bool,
    ignored: i64, invalid: i64,
}

def vt_ok() -> Result<bool, i64> { Result { is_ok: true, value: true, error: 0 } }
def vt_text(value: &str) -> String { string_from_str(value).unwrap_or(string_new()) }
def vt_blank() -> PtyVtCell { PtyVtCell { text: vt_text(" "), width: 1 } }
def vt_clamp(value: i64, lo: i64, hi: i64) -> i64 { if value < lo { lo } else { if value > hi { hi } else { value } } }
def vt_new(columns: i64, rows: i64) -> PtyVt {
    let w = vt_clamp(columns, 2, 240); let h = vt_clamp(rows, 1, 100);
    let cells: Vec<PtyVtCell> = vec_new(); let mut i = 0;
    while i < w * h { cells.push(vt_blank()); i = i + 1; };
    PtyVt { columns: w, rows: h, cells: cells, x: 0, y: 0, saved_x: 0, saved_y: 0,
        top: 0, bottom: h - 1, wrap: false, mode: 0, params: string_new(), string_escape: false,
        utf8: ffi_buffer_new(4).unwrap_or(Buffer { handle: 0 }), wanted: 0, cluster: unicode_grapheme_state(),
        last_x: -1, last_y: -1, bracketed_paste: false, cursor_visible: true, ignored: 0, invalid: 0 }
}
def vt_break(screen: &mut PtyVt) { screen.cluster = unicode_grapheme_state(); screen.last_x = -1; screen.last_y = -1; () }
def vt_erase_cell(screen: &PtyVt, x: i64, y: i64) {
    if x < 0 or x >= screen.columns or y < 0 or y >= screen.rows { return; };
    let index = y * screen.columns + x; let cell: &PtyVtCell = screen.cells.get(index); let width = cell.width;
    if width == 0 and x > 0 { screen.cells.set(index - 1, vt_blank()); (); };
    if width == 2 and x + 1 < screen.columns { screen.cells.set(index + 1, vt_blank()); (); };
    screen.cells.set(index, vt_blank()); ();
}
def vt_erase(screen: &PtyVt, start: i64, end: i64) {
    let mut i = vt_clamp(start, 0, screen.columns * screen.rows);
    let stop = vt_clamp(end, i, screen.columns * screen.rows);
    while i < stop { vt_erase_cell(screen, i % screen.columns, i / screen.columns); i = i + 1; };
}
def vt_scroll(screen: &mut PtyVt, count: i64) -> Result<bool, i64> {
    let amount = vt_clamp(if count < 0 { 0 - count } else { count }, 0, screen.bottom - screen.top + 1);
    let mut row = if count >= 0 { screen.top } else { screen.bottom };
    let mut n = 0;
    while n <= screen.bottom - screen.top {
        let source = if count >= 0 { row + amount } else { row - amount }; let mut col = 0;
        while col < screen.columns {
            if source >= screen.top and source <= screen.bottom {
                let cell: &PtyVtCell = screen.cells.get(source * screen.columns + col);
                screen.cells.set(row * screen.columns + col, PtyVtCell { text: cell.text.clone()?, width: cell.width }); ();
            } else { screen.cells.set(row * screen.columns + col, vt_blank()); (); };
            col = col + 1;
        };
        row = if count >= 0 { row + 1 } else { row - 1 }; n = n + 1;
    };
    vt_break(screen); vt_ok()
}
def vt_linefeed(screen: &mut PtyVt) -> Result<bool, i64> {
    screen.wrap = false; vt_break(screen);
    if screen.y == screen.bottom { vt_scroll(screen, 1)?; (); } else { screen.y = vt_clamp(screen.y + 1, 0, screen.rows - 1); };
    vt_ok()
}
def vt_cluster(screen: &mut PtyVt, text: &String, cp: i64) -> Result<bool, i64> {
    // Bidi controls are not interpreted by the outer terminal or copied into it.
    if cp >= 8234 and cp <= 8238 or cp >= 8294 and cp <= 8297 { vt_break(screen); return vt_ok(); };
    let boundary = screen.cluster.push(cp)?;
    if not boundary and screen.last_y == screen.y and screen.last_x >= 0 {
        let index = screen.last_y * screen.columns + screen.last_x;
        let cell: &PtyVtCell = screen.cells.get(index); let joined = cell.text.clone()?; let before = cell.width;
        if joined.len() + text.len() > 128 { screen.ignored = screen.ignored + 1; return vt_ok(); };
        joined.push_str(text.as_str())?; let after = vt_clamp(unicode_display_width(&joined)?, 1, 2);
        if screen.last_x + after > screen.columns { screen.ignored = screen.ignored + 1; return vt_ok(); };
        if after > before { vt_erase_cell(screen, screen.last_x + 1, screen.y); };
        if after < before { screen.cells.set(index + 1, vt_blank()); (); };
        screen.cells.set(index, PtyVtCell { text: joined, width: after });
        if after == 2 { screen.cells.set(index + 1, PtyVtCell { text: string_new(), width: 0 }); (); };
        screen.x = screen.last_x + after; screen.wrap = screen.x >= screen.columns;
        if screen.wrap { screen.x = screen.columns - 1; };
        return vt_ok();
    };
    let width = unicode_display_width(text)?;
    if width == 0 { return vt_ok(); };
    let cells = vt_clamp(width, 1, 2);
    if screen.wrap or screen.x + cells > screen.columns { screen.x = 0; vt_linefeed(screen)?; screen.cluster.push(cp)?; (); };
    vt_erase_cell(screen, screen.x, screen.y);
    if cells == 2 { vt_erase_cell(screen, screen.x + 1, screen.y); };
    let index = screen.y * screen.columns + screen.x;
    screen.cells.set(index, PtyVtCell { text: text.clone()?, width: cells });
    if cells == 2 { screen.cells.set(index + 1, PtyVtCell { text: string_new(), width: 0 }); (); };
    screen.last_x = screen.x; screen.last_y = screen.y; screen.x = screen.x + cells;
    screen.wrap = screen.x >= screen.columns; if screen.wrap { screen.x = screen.columns - 1; };
    vt_ok()
}
def vt_invalid(screen: &mut PtyVt) -> Result<bool, i64> {
    screen.invalid = screen.invalid + 1; screen.utf8.clear(); screen.wanted = 0;
    let replacement = vt_text("�"); vt_cluster(screen, &replacement, 65533)
}
def vt_number(params: &String, index: i64, fallback: i64) -> i64 {
    let iter = params.split(";"); let mut i = 0; let mut value = fallback;
    loop {
        let item = iter.next(); if not item.is_some { break; };
        if i == index {
            let bytes = item.value.bytes(); let mut number = 0; let mut found = false; let mut valid = true;
            loop { let b = bytes.next(); if not b.is_some { break; }; if b.value >= 48 and b.value <= 57 { found = true; number = vt_clamp(number * 10 + b.value - 48, 0, 10000); } else { if b.value != 63 { valid = false; }; }; };
            if found and valid { value = number; }; break;
        }; i = i + 1;
    };
    value
}
def vt_csi(screen: &mut PtyVt, final: i64) -> Result<bool, i64> {
    let first = vt_number(&screen.params, 0, 0); let n = if first == 0 { 1 } else { first };
    let private = str_starts_with(screen.params.as_str(), "?");
    screen.wrap = false; vt_break(screen);
    if private {
        if final == 104 or final == 108 {
            let enabled = final == 104;
            if first == 2004 { screen.bracketed_paste = enabled; };
            if first == 25 { screen.cursor_visible = enabled; };
            if first == 1049 or first == 1047 or first == 47 { vt_erase(screen, 0, screen.cells.len()); screen.x = 0; screen.y = 0; };
        };
        return vt_ok();
    };
    if final == 65 { screen.y = vt_clamp(screen.y - n, 0, screen.rows - 1); };
    if final == 66 { screen.y = vt_clamp(screen.y + n, 0, screen.rows - 1); };
    if final == 67 { screen.x = vt_clamp(screen.x + n, 0, screen.columns - 1); };
    if final == 68 { screen.x = vt_clamp(screen.x - n, 0, screen.columns - 1); };
    if final == 69 or final == 70 { screen.x = 0; screen.y = vt_clamp(screen.y + (if final == 69 { n } else { 0 - n }), 0, screen.rows - 1); };
    if final == 71 or final == 96 { screen.x = vt_clamp(n - 1, 0, screen.columns - 1); };
    if final == 100 { screen.y = vt_clamp(n - 1, 0, screen.rows - 1); };
    if final == 72 or final == 102 { screen.y = vt_clamp(n - 1, 0, screen.rows - 1); screen.x = vt_clamp(vt_number(&screen.params, 1, 1) - 1, 0, screen.columns - 1); };
    if final == 74 { let at = screen.y * screen.columns + screen.x; if first == 0 { vt_erase(screen, at, screen.cells.len()); }; if first == 1 { vt_erase(screen, 0, at + 1); }; if first == 2 or first == 3 { vt_erase(screen, 0, screen.cells.len()); }; };
    if final == 75 { let at = screen.y * screen.columns; if first == 0 { vt_erase(screen, at + screen.x, at + screen.columns); }; if first == 1 { vt_erase(screen, at, at + screen.x + 1); }; if first == 2 { vt_erase(screen, at, at + screen.columns); }; };
    if final == 88 { let at = screen.y * screen.columns + screen.x; vt_erase(screen, at, at + vt_clamp(n, 0, screen.columns - screen.x)); };
    if final == 115 { screen.saved_x = screen.x; screen.saved_y = screen.y; };
    if final == 117 { screen.x = vt_clamp(screen.saved_x, 0, screen.columns - 1); screen.y = vt_clamp(screen.saved_y, 0, screen.rows - 1); };
    if final == 114 {
        let top = n - 1; let bottom = vt_number(&screen.params, 1, screen.rows) - 1;
        if top >= 0 and bottom < screen.rows and top < bottom { screen.top = top; screen.bottom = bottom; screen.x = 0; screen.y = 0; };
    };
    if final == 83 { vt_scroll(screen, n)?; (); }; if final == 84 { vt_scroll(screen, 0 - n)?; (); };
    vt_ok()
}
def vt_byte(screen: &mut PtyVt, byte: i64) -> Result<bool, i64> {
    if screen.mode == 3 {
        if byte == 7 or screen.string_escape and byte == 92 { screen.mode = 0; screen.string_escape = false; } else { screen.string_escape = byte == 27; };
        return vt_ok();
    };
    if screen.mode == 4 { screen.mode = 0; return vt_ok(); };
    if screen.mode == 2 or screen.mode == 5 {
        if byte == 27 { screen.mode = 1; screen.params.clear(); return vt_ok(); };
        if byte == 24 or byte == 26 { screen.mode = 0; screen.params.clear(); return vt_ok(); };
        if byte >= 64 and byte <= 126 {
            if screen.mode == 2 { vt_csi(screen, byte)?; (); };
            screen.params.clear(); screen.mode = 0;
        } else {
            if screen.mode == 2 { if screen.params.len() < 128 and byte >= 32 and byte <= 63 { let ascii = ffi_buffer_new(1)?; ascii.push_u8(byte)?; let ch = string_from_bytes_raw(ascii.ptr(), 1)?; screen.params.push_str(ch.as_str())?; (); } else { screen.mode = 5; screen.ignored = screen.ignored + 1; }; };
        };
        return vt_ok();
    };
    if screen.mode == 1 {
        screen.mode = 0; vt_break(screen);
        if byte == 91 { screen.mode = 2; screen.params.clear(); (); };
        if byte == 93 or byte == 80 or byte == 95 or byte == 94 or byte == 88 { screen.mode = 3; screen.string_escape = false; };
        if byte == 40 or byte == 41 or byte == 35 or byte == 37 { screen.mode = 4; };
        if byte == 55 { screen.saved_x = screen.x; screen.saved_y = screen.y; };
        if byte == 56 { screen.x = screen.saved_x; screen.y = screen.saved_y; screen.wrap = false; };
        if byte == 68 or byte == 69 { if byte == 69 { screen.x = 0; }; vt_linefeed(screen)?; (); };
        if byte == 77 { if screen.y == screen.top { vt_scroll(screen, -1)?; (); } else { screen.y = vt_clamp(screen.y - 1, 0, screen.rows - 1); }; };
        if byte == 99 { vt_erase(screen, 0, screen.cells.len()); screen.x = 0; screen.y = 0; screen.top = 0; screen.bottom = screen.rows - 1; screen.wrap = false; screen.bracketed_paste = false; screen.cursor_visible = true; };
        return vt_ok();
    };
    if screen.wanted > 0 {
        if byte >= 128 and byte <= 191 {
            screen.utf8.push_u8(byte)?;
            if screen.utf8.used_len() == screen.wanted {
                let decoded = string_from_bytes_raw(screen.utf8.ptr(), screen.wanted);
                screen.wanted = 0; screen.utf8.clear();
                if decoded.is_ok { let iter = decoded.value.chars(); let cp = iter.next_codepoint(); if cp.is_some { vt_cluster(screen, &decoded.value, cp.value)?; (); }; } else { vt_invalid(screen)?; (); };
            };
            return vt_ok();
        };
        vt_invalid(screen)?; ();
    };
    if byte == 27 { screen.mode = 1; vt_break(screen); return vt_ok(); };
    if byte < 32 or byte == 127 {
        vt_break(screen);
        if byte == 13 { screen.x = 0; screen.wrap = false; };
        if byte == 10 or byte == 11 or byte == 12 { vt_linefeed(screen)?; (); };
        if byte == 8 { screen.x = vt_clamp(screen.x - 1, 0, screen.columns - 1); screen.wrap = false; };
        if byte == 9 { screen.x = vt_clamp((screen.x / 8 + 1) * 8, 0, screen.columns - 1); screen.wrap = false; };
        return vt_ok();
    };
    if byte < 128 { let one = ffi_buffer_new(1)?; one.push_u8(byte)?; let value = string_from_bytes_raw(one.ptr(), 1)?; return vt_cluster(screen, &value, byte); };
    if byte >= 194 and byte <= 244 { screen.wanted = if byte < 224 { 2 } else { if byte < 240 { 3 } else { 4 } }; screen.utf8.clear(); screen.utf8.push_u8(byte)?; return vt_ok(); };
    vt_invalid(screen)
}
def vt_feed(screen: &mut PtyVt, input: &Buffer, length: i64) -> Result<bool, i64> {
    if length < 0 or length > input.used_len() or length > 65536 { return Result { is_ok: false, value: false, error: 2 }; };
    let mut i = 0; while i < length { vt_byte(screen, input.get_u8(i)?)?; i = i + 1; }; vt_ok()
}
def vt_finish(screen: &mut PtyVt) -> Result<bool, i64> { if screen.wanted > 0 { vt_invalid(screen)?; (); }; screen.mode = 0; screen.params.clear(); vt_ok() }
def vt_resize(screen: &mut PtyVt, columns: i64, rows: i64) -> Result<bool, i64> {
    let mut next = vt_new(columns, rows); let mut y = 0;
    while y < next.rows and y < screen.rows {
        let mut x = 0;
        while x < next.columns and x < screen.columns {
            let cell: &PtyVtCell = screen.cells.get(y * screen.columns + x);
            if cell.width != 2 or x + 1 < next.columns {
                next.cells.set(y * next.columns + x, PtyVtCell { text: cell.text.clone()?, width: cell.width }); ();
            };
            x = x + 1;
        }; y = y + 1;
    };
    next.x = vt_clamp(screen.x, 0, next.columns - 1); next.y = vt_clamp(screen.y, 0, next.rows - 1);
    next.saved_x = vt_clamp(screen.saved_x, 0, next.columns - 1); next.saved_y = vt_clamp(screen.saved_y, 0, next.rows - 1);
    next.mode = screen.mode; next.params = screen.params.clone()?; next.string_escape = screen.string_escape;
    next.wanted = screen.wanted; next.utf8.append_copy(&screen.utf8, 0, screen.utf8.used_len())?;
    next.bracketed_paste = screen.bracketed_paste; next.cursor_visible = screen.cursor_visible;
    next.ignored = screen.ignored; next.invalid = screen.invalid; *screen = next; vt_ok()
}
def vt_row(screen: &PtyVt, row: i64) -> Result<String, i64> {
    if row < 0 or row >= screen.rows { return Result { is_ok: false, value: string_new(), error: 2 }; };
    let out = string_new(); let mut x = 0;
    while x < screen.columns { let cell: &PtyVtCell = screen.cells.get(row * screen.columns + x); out.push_str(cell.text.as_str())?; x = x + 1; };
    Result { is_ok: true, value: out, error: 0 }
}
