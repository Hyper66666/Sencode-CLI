import provider;

def provider_nul_expect(condition: bool, label: &str) -> Result<bool, i64> {
    if condition { return Result { is_ok: true, value: true, error: 0 }; };
    cli_diagnostic(label);
    Result { is_ok: false, value: false, error: 1 }
}

def provider_nul_event(protocol: i64, data: &str) -> Result<bool, i64> {
    let mut turn = provider_turn();
    let result = turn.event(protocol, data);
    provider_nul_expect(not result.is_ok() and result.error == 10, "NUL protocol field must return status 10 before narrowing")
}

def provider_nul_tests() -> Result<i64, i64> {
    provider_nul_event(0, "{\"choices\":[{\"delta\":{\"content\":\"visible\\u0000hidden\"}}]}")?;
    provider_nul_event(0, "{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call\\u0000hidden\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{}\"}}]}}]}")?;
    provider_nul_event(0, "{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call\",\"function\":{\"name\":\"read_file\\u0000hidden\",\"arguments\":\"{}\"}}]}}]}")?;
    provider_nul_event(0, "{\"choices\":[{\"delta\":{\"tool_calls\":[{\"index\":0,\"id\":\"call\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{}\\u0000hidden\"}}]}}]}")?;
    provider_nul_event(0, "{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\\u0000hidden\"}]}")?;
    provider_nul_event(1, "{\"type\":\"response.output_text.delta\",\"delta\":\"visible\\u0000hidden\"}")?;
    provider_nul_event(1, "{\"type\":\"response.function_call_arguments.delta\",\"output_index\":0,\"delta\":\"{}\\u0000hidden\"}")?;
    provider_nul_event(1, "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"function_call\",\"call_id\":\"call\",\"name\":\"read_file\",\"arguments\":\"{}\\u0000hidden\"}}")?;
    provider_nul_event(1, "{\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"function_call\",\"call_id\":\"call\\u0000hidden\",\"name\":\"read_file\",\"arguments\":\"{}\"}}")?;
    provider_nul_event(1, "{\"type\":\"response.completed\\u0000hidden\"}")?;
    provider_nul_event(2, "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"visible\\u0000hidden\"}}")?;
    provider_nul_event(2, "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"visible\\u0000hidden\"}}")?;
    provider_nul_event(2, "{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{}\\u0000hidden\"}}")?;
    provider_nul_event(2, "{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"tool_use\",\"id\":\"call\",\"name\":\"read_file\\u0000hidden\",\"input\":{}}}")?;
    provider_nul_event(2, "{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"end_turn\\u0000hidden\"}}")?;
    let tools = json_parse("{\"tools\":[]}")?;
    let history = json_parse("{\"messages\":[{\"role\":\"user\",\"content\":\"visible\\u0000hidden\"}]}")?;
    let tool_history = json_parse("{\"messages\":[{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"call\",\"name\":\"read_file\",\"arguments\":\"{}\\u0000hidden\"}]}]}")?;
    let mut protocol = 0;
    while protocol < 3 {
        let request = provider_build_request(protocol, "fixture", &history, &tools);
        provider_nul_expect(not request.is_ok() and request.error == 10, "NUL text history cannot be truncated into a request")?;
        let tool_request = provider_build_request(protocol, "fixture", &tool_history, &tools);
        provider_nul_expect(not tool_request.is_ok() and tool_request.error == 10, "NUL tool history cannot be truncated into a request")?;
        protocol = protocol + 1;
    };
    let mut accepted = provider_turn();
    let visible = accepted.event(0, "{\"choices\":[{\"delta\":{\"content\":\"世界😀\\n\"}}]}")?;
    provider_nul_expect(visible.as_str() == "世界😀\n", "Unicode and ordinary escapes remain exact")?;
    let rejected = accepted.event(0, "{\"choices\":[{\"delta\":{\"content\":\"prefix\\u0000suffix\"}}]}");
    provider_nul_expect(not rejected.is_ok() and rejected.error == 10, "A later NUL fragment fails")?;
    accepted.event(0, "{\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}")?;
    accepted.event(0, "[DONE]")?;
    let finished = accepted.finish()?;
    provider_nul_expect(cli_json_string(finished.root(), "content")?.as_str() == "世界😀\n", "Rejected fragment appends no partial prefix")?;
    cli_ok(0)
}

def main() -> i64 {
    let result = provider_nul_tests();
    if not result.is_ok() { println(result.error); return 1; };
    println("provider NUL protocol/history rejection acceptance passed (24 checks)");
    result.value
}
