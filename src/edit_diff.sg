import common;

struct EditLine { text: String, terminated: bool }
struct EditBand { reach: Vec<i64> }
struct EditDiffLine { kind: i64, old_line: i64, new_line: i64, text: String }
struct EditDiff { lines: Vec<EditDiffLine>, added: i64, removed: i64, simplified: bool }

def edit_lines(text: &str) -> Result<Vec<EditLine>, i64> {
    let rows: Vec<EditLine> = vec_new(); let source = cli_text(text); let parts = source.split("\n"); let mut offset = 0;
    loop { let next = parts.next(); if not next.is_some { break; };
        let length = next.value.len();
        if offset < source.len() { rows.push(EditLine { text: next.value, terminated: offset + length < source.len() }); (); };
        offset = offset + length + 1;
        if rows.len() > 8192 { parts.free(); return Result { is_ok: false, value: rows, error: 13 }; };
    }; parts.free(); Result { is_ok: true, value: rows, error: 0 }
}

def edit_emit(out: &String, rows: &Vec<EditLine>, start: i64, end: i64, sign: &str) -> Result<bool, i64> {
    let mut index = start;
    while index < end { out.push_str(sign)?; out.push_str(rows.get(index).text.as_str())?; out.push_str("\n")?; index = index + 1; };
    Result { is_ok: true, value: true, error: 0 }
}


def edit_reach(band: &EditBand, distance: i64, diagonal: i64) -> i64 {
    if diagonal < 0 - distance or diagonal > distance { return -1; };
    band.reach.get((diagonal + distance) / 2).unwrap_or(-1)
}

// Bounded Myers trace: small edits in large files avoid an N*M matrix.
def edit_model(before: &str, after: &str) -> Result<EditDiff, i64> {
    let old = edit_lines(before)?; let new = edit_lines(after)?;
    let bands: Vec<EditBand> = vec_new(); let reversed: Vec<EditDiffLine> = vec_new(); let lines: Vec<EditDiffLine> = vec_new();
    let mut distance = 0; let mut found = -1; let mut work = 0; let mut stored = 0;
    while distance <= old.len() + new.len() and distance <= 1024 and work < 2000000 and stored < 524288 {
        let reach: Vec<i64> = vec_new(); let mut diagonal = 0 - distance;
        while diagonal <= distance {
            let mut x = 0;
            if distance > 0 {
                let previous: &EditBand = bands.get(distance - 1);
                if diagonal == 0 - distance or diagonal != distance and edit_reach(previous, distance - 1, diagonal - 1) < edit_reach(previous, distance - 1, diagonal + 1) {
                    x = edit_reach(previous, distance - 1, diagonal + 1);
                } else { x = edit_reach(previous, distance - 1, diagonal - 1) + 1; };
            };
            let mut y = x - diagonal;
            while x >= 0 and y >= 0 and x < old.len() and y < new.len() {
                work = work + 1;
                if old.get(x).text.as_str() != new.get(y).text.as_str() or old.get(x).terminated != new.get(y).terminated or work >= 2000000 { break; };
                x = x + 1; y = y + 1;
            };
            reach.push(x); stored = stored + 1; work = work + 1;
            if x >= old.len() and y >= new.len() { found = distance; break; };
            diagonal = diagonal + 2;
        };
        bands.push(EditBand { reach: reach });
        if found >= 0 { break; }; distance = distance + 1;
    };
    if found < 0 { return Result { is_ok: true, value: EditDiff { lines: lines, added: 0, removed: 0, simplified: true }, error: 0 }; };
    let mut x = old.len(); let mut y = new.len(); let mut added = 0; let mut removed = 0; distance = found;
    while distance > 0 {
        let diagonal = x - y; let previous: &EditBand = bands.get(distance - 1);
        let previous_diagonal = if diagonal == 0 - distance or diagonal != distance and edit_reach(previous, distance - 1, diagonal - 1) < edit_reach(previous, distance - 1, diagonal + 1) { diagonal + 1 } else { diagonal - 1 };
        let px = edit_reach(previous, distance - 1, previous_diagonal); let py = px - previous_diagonal;
        while x > px and y > py {
            reversed.push(EditDiffLine { kind: 0, old_line: x, new_line: y, text: old.get(x - 1).text.clone()? }); x = x - 1; y = y - 1;
        };
        if x == px { reversed.push(EditDiffLine { kind: 1, old_line: x + 1, new_line: y, text: new.get(y - 1).text.clone()? }); y = y - 1; added = added + 1; } else {
            reversed.push(EditDiffLine { kind: -1, old_line: x, new_line: y + 1, text: old.get(x - 1).text.clone()? }); x = x - 1; removed = removed + 1;
        };
        distance = distance - 1;
    };
    while x > 0 and y > 0 { reversed.push(EditDiffLine { kind: 0, old_line: x, new_line: y, text: old.get(x - 1).text.clone()? }); x = x - 1; y = y - 1; };
    let mut index = reversed.len() - 1;
    while index >= 0 { let row: &EditDiffLine = reversed.get(index); lines.push(EditDiffLine { kind: row.kind, old_line: row.old_line, new_line: row.new_line, text: row.text.clone()? }); index = index - 1; };
    Result { is_ok: true, value: EditDiff { lines: lines, added: added, removed: removed, simplified: false }, error: 0 }
}

// Preserve unified text for existing approval/export consumers; TUI projects
// these exact hunks once and never computes a file diff during painting.
def edit_diff(path: &str, before: &str, after: &str) -> Result<String, i64> {
    if before.len() + after.len() > 131072 { return string_result_err(13); };
    let model = edit_model(before, after)?;
    let out = cli_text("--- "); out.push_str(path)?; out.push_str("\n+++ ")?; out.push_str(path)?; out.push_str("\n")?;
    if model.simplified { out.push_str("Diff simplified: comparison budget exceeded. Inspect complete before/after content; exact change counts are unavailable.\n")?; return Result { is_ok: true, value: out, error: 0 }; };
    if model.added == 0 and model.removed == 0 { out.push_str("No changes\n")?; return Result { is_ok: true, value: out, error: 0 }; };
    let mut index = 0;
    while index < model.lines.len() {
        while index < model.lines.len() and model.lines.get(index).kind == 0 { index = index + 1; };
        if index >= model.lines.len() { break; };
        let start = if index > 3 { index - 3 } else { 0 }; let mut last_change = index; let mut end = index + 1;
        while end < model.lines.len() { if model.lines.get(end).kind != 0 { last_change = end; }; if end - last_change > 6 { break; }; end = end + 1; };
        let finish = if last_change + 4 < model.lines.len() { last_change + 4 } else { model.lines.len() };
        let mut old_count = 0; let mut new_count = 0; let mut cursor = start;
        while cursor < finish { let row: &EditDiffLine = model.lines.get(cursor); if row.kind != 1 { old_count = old_count + 1; }; if row.kind != -1 { new_count = new_count + 1; }; cursor = cursor + 1; };
        let first: &EditDiffLine = model.lines.get(start);
        out.push_str("@@ -")?; out.push_i64(if old_count == 0 { first.old_line - 1 } else { first.old_line })?; out.push_str(",")?; out.push_i64(old_count)?;
        out.push_str(" +")?; out.push_i64(if new_count == 0 { first.new_line - 1 } else { first.new_line })?; out.push_str(",")?; out.push_i64(new_count)?; out.push_str(" @@\n")?;
        cursor = start;
        while cursor < finish { let row: &EditDiffLine = model.lines.get(cursor); out.push_str(if row.kind == -1 { "-" } else { if row.kind == 1 { "+" } else { " " } })?; out.push_str(row.text.as_str())?; out.push_str("\n")?; cursor = cursor + 1; };
        index = finish;
    };
    if before.len() > 0 and not str_ends_with(before, "\n") or after.len() > 0 and not str_ends_with(after, "\n") { out.push_str("\\ No newline at end of file\n")?; (); };
    Result { is_ok: true, value: out, error: 0 }
}
