import job_host;
import job_client;
import management;

// Root owns argument parsing and dispatch. This module owns only explicit Agent
// job commands; it never interprets arbitrary user/model text as a job command.
def job_commands_snapshot(document:&JsonDoc,format:&str)->Result<bool,i64>{
    if format!="text" {return output_document(document);};
    let text=cli_text("Agent ");text.push_str(cli_json_string(document.root(),"job_id")?.as_str())?;
    text.push_str(" · ")?;text.push_str(cli_json_string(document.root(),"state")?.as_str())?;
    let reason=cli_json_optional_string(document.root(),"reason");if reason.len()>0{text.push_str(" · ")?;text.push_str(reason.as_str())?; (); };
    text.push_str("\n  Session: ")?;text.push_str(cli_json_string(document.root(),"session_id")?.as_str())?;
    text.push_str("\n  Target: ")?;text.push_str(cli_json_string(document.root(),"connection_id")?.as_str())?;text.push_str(" / ")?;text.push_str(cli_json_string(document.root(),"model")?.as_str())?;text.push_str("\n")?;
    ui_output(cli_terminal_safe(text.as_str())?.as_str())
}

def job_commands_event(job:JsonValue,wrapper:JsonValue,format:&str)->Result<bool,i64>{
    let event=wrapper.object_get("event")?;
    if format!="text" {
        let document=job_message("job_event",cli_json_string(job,"job_id")?.as_str(),cli_json_string(job,"generation")?.as_str())?;
        cli_put_i64(&document,document.root(),"sequence",cli_json_optional_i64(wrapper,"sequence",0))?;
        document.root().object_set("event",document.copy(event)?)?;return output_document(&document);
    };
    let kind=cli_json_optional_string(event,"type");
    if kind.as_str()=="text_delta"{return ui_output(cli_terminal_safe(cli_json_optional_string(event,"text").as_str())?.as_str());};
    if kind.as_str()=="notice" or kind.as_str()=="tool" or kind.as_str()=="agent" {
        let text=cli_text("\n  ");text.push_str(kind.as_str())?;text.push_str(": ")?;text.push_str(cli_json_optional_string(event,"text").as_str())?;text.push_str("\n")?;return ui_output(cli_terminal_safe(text.as_str())?.as_str());
    };
    if kind.as_str()=="result"{ui_output("\n")?;return job_true();};
    job_true()
}

def job_commands_page(document:&JsonDoc,format:&str,after:i64)->Result<i64,i64>{
    if format=="json"{output_document(document)?;return cli_ok(after);};
    let snapshot=document.root().object_get("snapshot")?;
    if cli_json_string(document.root(),"type")?.as_str()=="cursor_expired"{
        if format=="text"{ui_output("Log cursor expired; older events were pruned. Public session history is preserved.\n")?; (); }else{output_document(document)?; (); };
        return cli_ok(cli_json_optional_i64(snapshot,"first_sequence",1)-1);
    };
    let events=document.root().object_get("events")?;let mut index=0;let mut cursor=after;
    while index<events.array_len()?{let wrapper=events.array_get(index)?;job_commands_event(snapshot,wrapper,format)?;cursor=cli_json_optional_i64(wrapper,"sequence",cursor);index=index+1;};
    cli_ok(cursor)
}

def job_commands_logs(state:&CliState,id:&str,args:&JsonDoc,format:&str,terminal:&Terminal)->Result<i64,i64>{
    let follow=cli_flag(args,"follow");if follow and format=="json"{cli_diagnostic("--follow requires text or stream-json output.");return cli_ok(2);};
    let store=job_store_open(state)?;let mut after=cli_parse_unsigned(cli_option(args,"after","0")?.as_str(),10)?;
    let started=time_unix_ms();
    loop{
        let page=job_store_logs(&store,id,after,256)?;
        let before=after;after=job_commands_page(&page,format,after)?;
        let current=job_snapshot(state,&store,id)?;
        let last=cli_json_optional_i64(current.root(),"last_sequence",0);
        if not follow or job_terminal(cli_json_string(current.root(),"state")?.as_str()) and after>=last{return cli_ok(0);};
        if terminal.is_tty(){let event=terminal.read_event(0)?;if event.kind==4 or event.kind==5{return cli_ok(0);};};
        if time_since_ms(started)>86415000{return cli_ok(11);};
        if before==after{time_sleep_ms(50); (); };
    };
    cli_ok(0)
}

def job_commands_interaction(client:&JobClient,event:JsonValue,terminal:&Terminal,format:&str)->Result<bool,i64>{
    let command=job_client_command(client,"approval")?;
    cli_put_string(&command,command.root(),"id",cli_json_string(event,"id")?.as_str())?;
    cli_put_string(&command,command.root(),"request_id",cli_json_string(event,"request_id")?.as_str())?;
    // Structured/redirected attachment observes only. It cannot auto-approve.
    if format!="text" or not terminal.is_tty(){cli_put_bool(&command,command.root(),"approved",false)?;return job_client_send(client,&command);};
    let description=cli_terminal_safe(cli_json_optional_string(event,"text").as_str())?;
    if cli_json_optional_string(event,"mode").as_str()=="question"{
        if not ui_approval_barrier(terminal)?{return state_bool_error(19);};
        ui_output(description.as_str())?;ui_output("\n")?;
        let history:Vec<InputHistory> = vec_new();let pending:Vec<TerminalEvent> = vec_new();
        let answer=ui_read_prompt(terminal,&history,&pending,"AGENT QUESTION")?;cli_put_string(&command,command.root(),"text",answer.as_str())?; (); }else{let approved=ui_confirm(terminal,description.as_str())?;cli_put_bool(&command,command.root(),"approved",approved)?; (); };
    job_client_send(client,&command)
}

def job_commands_attach(state:&CliState,id:&str,args:&JsonDoc,format:&str,terminal:&Terminal,start:bool)->Result<i64,i64>{
    if format=="json"{cli_diagnostic("Live attachment requires text or stream-json output.");return cli_ok(2);};
    let store=job_store_open(state)?;let current=job_snapshot(state,&store,id)?;
    if job_terminal(cli_json_string(current.root(),"state")?.as_str()){job_commands_snapshot(&current,format)?;return job_commands_logs(state,id,args,format,terminal);};
    let observe=cli_flag(args,"observe");if start and observe{return cli_ok(2);};
    let after=cli_parse_unsigned(cli_option(args,"after","0")?.as_str(),10)?;
    let client=job_client_open(&store,id,if observe{"observe"}else{"control"},after)?;
    let live_after=cli_json_optional_i64(client.job.root(),"last_sequence",0);
    job_commands_snapshot(&client.job,format)?;
    if start{let submit=job_client_command(&client,"start")?;job_client_send(&client,&submit)?; (); };
    if terminal.is_tty() and format=="text"{terminal.enter_raw()?; (); };
    let started=time_unix_ms();
    loop{
        let polled=job_client_poll(&client);
        if not polled.is_ok(){if polled.error==5{let last=job_snapshot(state,&store,id)?;job_commands_snapshot(&last,format)?;return cli_ok(if cli_json_string(last.root(),"state")?.as_str()=="completed"{0}else{1});};return cli_fail(polled.error);};
        if polled.value.root().object_has("type"){
            let event=polled.value;
            let kind=cli_json_string(event.root(),"type")?;
            if kind.as_str()=="logs"{
                job_commands_page(&event,format,after)?;
                if not observe{
                    let items=event.root().object_get("events")?;let mut index=0;
                    while index<items.array_len()?{let wrapper=items.array_get(index)?;let inner=wrapper.object_get("event")?;
                        if cli_json_optional_i64(wrapper,"sequence",0)>live_after and cli_json_optional_string(inner,"type").as_str()=="approval"{job_commands_interaction(&client,inner,terminal,format)?; (); };
                        index=index+1;
                    };
                };
            }else{if kind.as_str()=="cursor_expired"{job_commands_page(&event,format,after)?; (); }else{output_document(&event)?; (); };};
        };
        let key=terminal.read_event(0)?;
        if key.kind==4{
            if observe{return cli_ok(0);};let stopped=job_stop(state,id)?;job_commands_snapshot(&stopped,format)?;return cli_ok(130);
        };
        if key.kind==5 and terminal.is_tty(){
            let detach=job_client_command(&client,"detach");if detach.is_ok(){job_client_send(&client,&detach.value)?;job_stream_flush(&client.stream,&client.output)?; (); };return cli_ok(0);
        };
        if time_since_ms(started)>86415000{return cli_ok(11);};time_sleep_ms(2);
    };
    cli_ok(0)
}

def job_commands_start(state:&CliState,args:&JsonDoc,cwd:&str,format:&str,terminal:&Terminal)->Result<i64,i64>{
    let goal=cli_option(args,"goal","")?;let prompt=cli_option(args,"prompt",goal.as_str())?;
    if prompt.len()==0{cli_diagnostic("Use sen agent start -p TASK. Goal remains attached: sen agent start --goal TASK.");return cli_ok(2);};
    if goal.len()>0 and (not terminal.is_tty() or format!="text"){cli_diagnostic("Goal requires an attached interactive text controller; it never runs unattended.");return cli_ok(7);};
    if cli_option(args,"permission-profile","strict")?.as_str()!="strict"{cli_diagnostic("Background Agent supports the native API engine with strict host permissions only.");return cli_ok(7);};
    let metadata=engine_select_target(state,cli_option(args,"connection","")?.as_str(),cli_option(args,"model","")?.as_str())?;
    if cli_json_string(metadata.root(),"engine")?.as_str()!="sengoo-native-api"{cli_diagnostic("Managed account background execution is unavailable; select a native custom API connection.");return cli_ok(8);};
    let submit=json_doc_object()?;cli_put_string(&submit,submit.root(),"type","submit")?;cli_put_string(&submit,submit.root(),"id",state_id("job-submit-")?.as_str())?;cli_put_string(&submit,submit.root(),"text",prompt.as_str())?;
    cli_put_string(&submit,submit.root(),"connection",cli_json_string(metadata.root(),"connection_id")?.as_str())?;cli_put_string(&submit,submit.root(),"model",cli_json_string(metadata.root(),"model")?.as_str())?;
    cli_put_string(&submit,submit.root(),"operation","turn")?;cli_put_string(&submit,submit.root(),"permission_profile","strict")?;cli_put_string(&submit,submit.root(),"goal",goal.as_str())?;
    cli_put_bool(&submit,submit.root(),"plan",cli_flag(args,"plan"))?;cli_put_bool(&submit,submit.root(),"auto_edit",cli_flag(args,"auto-edit"))?;cli_put_bool(&submit,submit.root(),"allow_commands",cli_flag(args,"allow-commands"))?;
    cli_put_i64(&submit,submit.root(),"maximum_requests",cli_parse_unsigned(cli_option(args,"max-requests","50")?.as_str(),10)?)?;cli_put_i64(&submit,submit.root(),"token_budget",cli_parse_unsigned(cli_option(args,"token-budget","0")?.as_str(),10)?)?;
    submit.root().object_set("checks",submit.copy(args.root().object_get("checks")?)?)?;engine_submit_valid(&submit)?;
    let lifetime=cli_parse_unsigned(cli_option(args,"job-timeout-ms","3600000")?.as_str(),10)?;
    if lifetime<1000 or lifetime>86400000{return cli_ok(2);};
    let session=cli_state_create_session(state,cwd)?;let image=current_executable_string()?;
    let job=if goal.len()>0{job_prepare(state,cwd,session.as_str(),&submit,lifetime,image.as_str())?}else{job_start(state,cwd,session.as_str(),&submit,lifetime,image.as_str())?};
    if goal.len()>0{return job_commands_attach(state,cli_json_string(job.root(),"job_id")?.as_str(),args,format,terminal,true);};
    job_commands_snapshot(&job,format)?;
    if format=="text"{let hint=cli_text("  Attach: sen agent attach ");hint.push_str(cli_json_string(job.root(),"job_id")?.as_str())?;hint.push_str("\n")?;ui_output(hint.as_str())?; (); };
    cli_ok(0)
}

def job_commands(state:&CliState,args:&JsonDoc,cwd:&str,terminal:&Terminal)->Result<i64,i64>{
    let format=cli_option(args,"output-format","text")?;
    if format.as_str()!="text" and format.as_str()!="json" and format.as_str()!="stream-json"{return cli_ok(2);};
    let first=management_positional(args,0);let nested=first.as_str()=="agent";
    let action=if nested{management_positional(args,1)}else{first.clone()?};let id=management_positional(args,if nested{2}else{1});
    if action.as_str()=="start"{return job_commands_start(state,args,cwd,format.as_str(),terminal);};
    if action.as_str()=="list"{let store=job_store_open(state)?;let list=job_store_list(&store)?;
        let jobs=list.root().object_get("jobs")?;let mut index=0;while index<jobs.array_len()?{let item=jobs.array_get(index)?;let job=job_snapshot(state,&store,cli_json_string(item,"job_id")?.as_str())?;if format.as_str()=="text"{job_commands_snapshot(&job,format.as_str())?; (); };index=index+1;};
        if format.as_str()!="text"{output_document(&job_store_list(&store)?)?; (); };return cli_ok(0);
    };
    if id.len()==0{cli_diagnostic("Usage: sen agent start -p TASK | list | logs JOB [--follow] | attach JOB | stop JOB");return cli_ok(2);};
    if action.as_str()=="logs"{return job_commands_logs(state,id.as_str(),args,format.as_str(),terminal);};
    if action.as_str()=="attach"{return job_commands_attach(state,id.as_str(),args,format.as_str(),terminal,false);};
    if action.as_str()=="stop"{let stopped=job_stop(state,id.as_str())?;job_commands_snapshot(&stopped,format.as_str())?;return cli_ok(0);};
    cli_ok(2)
}
