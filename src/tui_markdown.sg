import terminal;

// Renderer-owned semantic styles: 0 body, 1 heading, 2 muted, 3 code header,
// 4 code, 5 addition, 6 deletion, 7 quote/table, 8 tool. No model ANSI is used.
struct UiMarkdownState { fenced: bool, marker: String, language: String, number: i64, diff: bool, table: bool, old_line: i64, new_line: i64 }

def md_new() -> UiMarkdownState { UiMarkdownState { fenced: false, marker: string_new(), language: string_new(), number: 0, diff: false, table: false, old_line: 0, new_line: 0 } }
def md_clone(state: &UiMarkdownState) -> Result<UiMarkdownState, i64> { Result { is_ok: true, value: UiMarkdownState { fenced: state.fenced, marker: state.marker.clone()?, language: state.language.clone()?, number: state.number, diff: state.diff, table: state.table, old_line: state.old_line, new_line: state.new_line }, error: 0 } }
def md_ok() -> Result<bool, i64> { Result { is_ok: true, value: true, error: 0 } }

def md_row(rows: &Vec<UiLine>, text: &str, style: i64, message_id: i64) -> Result<bool, i64> {
    let safe = cli_terminal_safe(text)?; let cells = ui_cells(safe.as_str())?;
    rows.push(UiLine { text: safe, cells: cells, style: style, message_id: message_id , spans: ui_spans_empty() }); md_ok()
}

// Strip only paired inline delimiters. Underscores in identifiers and lone
// backticks remain readable, including partially streamed Markdown.
def md_inline_delimiters(text: &str, marker: &str) -> Result<String, i64> {
    let source = cli_text(text); let chunks = source.split(marker); let parts: Vec<InputHistory> = vec_new();
    loop { let next = chunks.next(); if not next.is_some { break; }; parts.push(InputHistory { text: next.value }); (); };
    chunks.free();
    let out = string_new(); let mut index = 0; let delimiters = parts.len() - 1;
    while index < parts.len() {
        out.push_str(parts.get(index).text.as_str())?;
        if delimiters % 2 == 1 and index == delimiters - 1 { out.push_str(marker)?; (); };
        index = index + 1;
    };
    Result { is_ok: true, value: out, error: 0 }
}
def md_inline(text: &str) -> Result<String, i64> {
    let bold = md_inline_delimiters(text, "**")?; md_inline_delimiters(bold.as_str(), "`")
}

def md_wrapped(rows: &Vec<UiLine>, text: &str, width: i64, prefix: &str, style: i64, id: i64) -> Result<bool, i64> {
    let prefix_cells = ui_cells(prefix)?; let available = if width - prefix_cells >= 2 { width - prefix_cells } else { 2 };
    let layout = ui_layout(text, 0, available)?; let mut index = 0;
    while index < layout.lines.len() { let row: &UiLine = layout.lines.get(index); let line = cli_text(prefix); line.push_str(row.text.as_str())?; md_row(rows, ui_fit(line.as_str(), width)?.as_str(), style, id)?; index = index + 1; };
    md_ok()
}

// Styles use UTF-8 byte offsets into sanitised text. Wrapping cuts only on
// grapheme boundaries; metadata never contains terminal control sequences.
def md_styled_wrapped(rows: &Vec<UiLine>, text: &str, spans: &Vec<UiSpan>, width: i64, prefix: &str, style: i64, id: i64) -> Result<bool, i64> {
    let available = if width - ui_cells(prefix)? > 1 { width - ui_cells(prefix)? } else { 2 };
    let layout = ui_layout(text, 0, available)?; let mut offset = 0; let mut index = 0;
    while index < layout.lines.len() {
        let row: &UiLine = layout.lines.get(index); let line = cli_text(prefix); line.push_str(row.text.as_str())?;
        let fitted = ui_fit(line.as_str(), width)?; let mapped: Vec<UiSpan> = vec_new(); let mut cursor = 0;
        while cursor < spans.len() { let span: &UiSpan = spans.get(cursor);
            let start = if span.start > offset { span.start } else { offset }; let end = if span.end < offset + row.text.len() { span.end } else { offset + row.text.len() };
            if start < end { ui_span(&mapped, start - offset + prefix.len(), end - offset + prefix.len(), span.style); }; cursor = cursor + 1;
        };
        rows.push(UiLine { cells: ui_cells(fitted.as_str())?, spans: ui_spans_copy(&mapped, 0, fitted.len()), text: fitted, style: style, message_id: id });
        offset = offset + row.text.len(); index = index + 1;
    }; md_ok()
}

def md_inline_wrapped(rows: &Vec<UiLine>, raw: &str, width: i64, prefix: &str, style: i64, id: i64) -> Result<bool, i64> {
    let source = cli_terminal_safe(raw)?; let bytes = source.bytes(); let out = string_new(); let spans: Vec<UiSpan> = vec_new();
    let mut offset = 0; let mut emitted = 0; let mut active = -1; let mut active_style = 0;
    // Delimiters are ASCII. Slices between them retain whole UTF-8 scalars.
    loop { let next = bytes.next(); if not next.is_some { break; }; let marker = if next.value == 96 { "`" } else { if next.value == 42 { "**" } else { "" } };
        if marker.len() > 0 and offset >= emitted and (marker.len() == 1 or str_starts_with(cli_byte_slice(source.as_str(), offset, source.len())?.as_str(), marker)) {
            let tail = cli_byte_slice(source.as_str(), offset + marker.len(), source.len())?;
            let found = str_index_of(tail.as_str(), marker);
            if active < 0 and found >= 0 {
                out.push_str(cli_byte_slice(source.as_str(), emitted, offset)?.as_str())?; active = out.len(); active_style = if marker.len() == 1 { 11 } else { 12 }; emitted = offset + marker.len();
            } else { if active >= 0 and (active_style == 11 and marker.len() == 1 or active_style == 12 and marker.len() == 2) {
                out.push_str(cli_byte_slice(source.as_str(), emitted, offset)?.as_str())?; ui_span(&spans, active, out.len(), active_style); active = -1; emitted = offset + marker.len();
            }; };
        }; offset = offset + 1;
    }; bytes.free();
    out.push_str(cli_byte_slice(source.as_str(), emitted, source.len())?.as_str())?;
    md_styled_wrapped(rows, out.as_str(), &spans, width, prefix, style, id)
}

def md_rule(rows: &Vec<UiLine>, width: i64, label: &str, style: i64, id: i64) -> Result<bool, i64> {
    let text = cli_text("┌─ "); text.push_str(label)?; text.push_str(" ")?; let cells = ui_cells(text.as_str())?;
    if cells < width { text.push_str(ui_repeat("─", width - cells)?.as_str())?; (); };
    md_row(rows, ui_fit(text.as_str(), width)?.as_str(), style, id)
}

def md_table_separator(text: &str) -> bool {
    if not str_contains(text, "|") or not str_contains(text, "-") { return false; };
    let source = cli_text(text); let bytes = source.bytes();
    loop { let next = bytes.next(); if not next.is_some { break; }; if next.value != 124 and next.value != 45 and next.value != 58 and next.value != 32 and next.value != 9 { bytes.free(); return false; }; };
    bytes.free();
    true
}

def md_table_row(rows: &Vec<UiLine>, text: &str, width: i64, id: i64) -> Result<bool, i64> {
    let trimmed = str_trim(text)?; let pieces = trimmed.split("|"); let cells: Vec<InputHistory> = vec_new(); let mut index = 0;
    loop { let next = pieces.next(); if not next.is_some { break; }; let value = str_trim(next.value.as_str())?;
        if not (index == 0 and value.len() == 0) { cells.push(InputHistory { text: value }); (); }; index = index + 1;
    };
    pieces.free();
    if cells.len() > 0 and cells.get(cells.len() - 1).text.len() == 0 { cells.pop(); (); };
    if cells.len() == 0 or cells.len() > 12 { return md_wrapped(rows, text, width, "", 0, id); };
    let column = (width - cells.len() - 1) / cells.len(); if column < 3 { return md_wrapped(rows, text, width, "", 0, id); };
    let line = cli_text("│"); index = 0;
    while index < cells.len() {
        let cell: &InputHistory = cells.get(index); let content = md_inline(cell.text.as_str())?; let fitted = ui_fit(content.as_str(), column - 2)?;
        line.push_str(" ")?; line.push_str(fitted.as_str())?; line.push_str(ui_repeat(" ", column - ui_cells(fitted.as_str())? - 1)?.as_str())?; line.push_str("│")?; index = index + 1;
    };
    md_row(rows, line.as_str(), 7, id)
}

def md_hunk_start(text: &str, sign: &str) -> i64 {
    let found = str_index_of(text, sign); if found < 0 { return 0; };
    let source = cli_text(text); let bytes = source.bytes(); let mut index = 0; let mut number = 0;
    loop { let next = bytes.next(); if not next.is_some { break; };
        if index > found { if next.value < 48 or next.value > 57 { break; }; number = number * 10 + next.value - 48; if number > 10000000 { number = 0; break; }; };
        index = index + 1;
    }; bytes.free(); number
}

def md_number(out: &String, value: i64) -> Result<bool, i64> {
    let label = string_new(); if value > 0 { label.push_i64(value)?; (); };
    out.push_str(ui_repeat(" ", 5 - label.len())?.as_str())?; out.push_str(label.as_str())?; md_ok()
}

def md_code_line(rows: &Vec<UiLine>, state: &mut UiMarkdownState, text: &str, width: i64, id: i64, complete: bool) -> Result<bool, i64> {
    if state.diff and str_starts_with(text, "@@ ") {
        if state.number > 0 { md_row(rows, "", 0, id)?; (); };
        if complete { state.old_line = md_hunk_start(text, "-"); state.new_line = md_hunk_start(text, "+"); state.number = state.number + 1; };
        return md_ok();
    };
    if state.diff and (str_starts_with(text, "--- ") or str_starts_with(text, "+++ ")) { return md_wrapped(rows, text, width, "", 3, id); };
    if state.diff and (text.len() == 0 or str_starts_with(text, "\\ No newline")) { if text.len() > 0 { return md_wrapped(rows, text, width, "", 2, id); }; return md_ok(); };
    let deletion = state.diff and str_starts_with(text, "-"); let addition = state.diff and str_starts_with(text, "+"); let context = state.diff and str_starts_with(text, " ");
    let style = if deletion { 6 } else { if addition { 5 } else { 4 } };
    let prefix = cli_text(" "); md_number(&prefix, if state.diff { if deletion { state.old_line } else { state.new_line } } else { state.number + 1 })?;
    let gutter_end = prefix.len(); prefix.push_str(if deletion { " - " } else { if addition { " + " } else { "   " } })?;
    let content = if deletion or addition or context { cli_byte_slice(text, 1, text.len())? } else { cli_text(text) };
    let before = rows.len(); md_wrapped(rows, content.as_str(), width, prefix.as_str(), style, id)?;
    let mut index = before; while index < rows.len() { let row: &UiLine = rows.get(index); ui_span(&row.spans, 0, gutter_end, 2); index = index + 1; };
    if complete { if state.diff { if deletion or context { state.old_line = state.old_line + 1; }; if addition or context { state.new_line = state.new_line + 1; }; }; state.number = state.number + 1; };
    md_ok()
}

def md_edit_render(rows: &Vec<UiLine>, text: &str, width: i64, id: i64) -> Result<bool, i64> {
    let source = cli_text(text); let parts = source.split("\n"); let mut state = md_new(); let mut diff = false;
    let mut path = string_new(); let mut added = 0; let mut removed = 0; let mut simplified = false;
    loop { let next = parts.next(); if not next.is_some { break; }; let line = next.value.as_str();
        if str_starts_with(line, "+++ ") { path = cli_byte_slice(line, 4, line.len())?; } else { if str_starts_with(line, "+") { added = added + 1; }; };
        if str_starts_with(line, "-") and not str_starts_with(line, "--- ") { removed = removed + 1; };
        if str_starts_with(line, "Diff simplified:") { simplified = true; };
    }; parts.free();
    let lines = source.split("\n");
    loop { let next = lines.next(); if not next.is_some { break; }; let line = next.value.as_str();
        if str_starts_with(line, "--- ") { diff = true; state.diff = true; let title = cli_text("Edited "); title.push_str(path.as_str())?;
            let spans: Vec<UiSpan> = vec_new(); ui_span(&spans, 7, title.len(), 11);
            if not simplified { title.push_str(" (")?; let begin = title.len(); title.push_str("+")?; title.push_i64(added)?; ui_span(&spans, begin, title.len(), 5); title.push_str(" ")?; let red = title.len(); title.push_str("−")?; title.push_i64(removed)?; ui_span(&spans, red, title.len(), 6); title.push_str(")")?; (); };
            md_styled_wrapped(rows, title.as_str(), &spans, width, "", 12, id)?; ();
        } else { if not str_starts_with(line, "+++ ") { if diff { md_code_line(rows, &mut state, line, width, id, true)?; (); } else { md_wrapped(rows, line, width, "", 0, id)?; (); }; }; };
    }; lines.free(); md_ok()
}

// Complete lines form a stable prefix. The caller parses only its growing
// last line into a copied state, so neither code fences nor tables are lost
// when a token/UTF-8 fragment arrives or the viewport scrolls away and back.
def md_line(rows: &Vec<UiLine>, state: &mut UiMarkdownState, raw: &str, width: i64, id: i64, complete: bool) -> Result<bool, i64> {
    let clean = cli_terminal_safe(raw)?; let trimmed = str_trim(clean.as_str())?;
    let fence = str_starts_with(trimmed.as_str(), "```") or str_starts_with(trimmed.as_str(), "~~~");
    if fence {
        let marker = cli_byte_slice(trimmed.as_str(), 0, 3)?;
        if state.fenced and marker.as_str() == state.marker.as_str() {
            md_row(rows, ui_repeat("─", width)?.as_str(), 2, id)?;
            if complete { state.fenced = false; state.marker.clear(); state.language.clear(); state.number = 0; state.diff = false; };
            return md_ok();
        };
        if not state.fenced {
            let language = str_trim(cli_byte_slice(trimmed.as_str(), 3, trimmed.len())?.as_str())?;
            md_rule(rows, width, if language.len() > 0 { language.as_str() } else { "code" }, 3, id)?;
            if complete { state.fenced = true; state.marker = marker; state.diff = language.as_str() == "diff" or language.as_str() == "patch"; state.language = language; state.number = 0; };
            return md_ok();
        };
    };
    if state.fenced { return md_code_line(rows, state, clean.as_str(), width, id, complete); };
    if md_table_separator(trimmed.as_str()) { state.table = true; return md_row(rows, ui_repeat("─", width)?.as_str(), 2, id); };
    if str_starts_with(trimmed.as_str(), "|") and str_contains(trimmed.as_str(), "|") { return md_table_row(rows, trimmed.as_str(), width, id); };
    state.table = false;
    if trimmed.as_str() == "---" or trimmed.as_str() == "***" or trimmed.as_str() == "___" { return md_row(rows, ui_repeat("─", width)?.as_str(), 2, id); };
    // Classify ASCII bytes without constructing invalid one-byte UTF-8 strings.
    let bytes = trimmed.bytes(); let mut heading = 0; let mut separated = false;
    loop { let next = bytes.next(); if not next.is_some { break; };
        if next.value == 35 and heading < 6 { heading = heading + 1; } else { separated = next.value == 32; break; };
    };
    bytes.free();
    if heading > 0 and separated {
        let text = str_trim(cli_byte_slice(trimmed.as_str(), heading + 1, trimmed.len())?.as_str())?; return md_inline_wrapped(rows, text.as_str(), width, "", 1, id);
    };
    if str_starts_with(trimmed.as_str(), "> ") { let content = cli_byte_slice(trimmed.as_str(), 2, trimmed.len())?; return md_inline_wrapped(rows, content.as_str(), width, "│ ", 7, id); };
    md_inline_wrapped(rows, clean.as_str(), width, "", 0, id)
}

def md_render(rows: &Vec<UiLine>, text: &str, width: i64, id: i64) -> Result<bool, i64> {
    let source = cli_text(text); let lines = source.split("\n"); let mut state = md_new();
    loop { let next = lines.next(); if not next.is_some { break; }; md_line(rows, &mut state, next.value.as_str(), width, id, true)?; (); };
    lines.free();
    md_ok()
}
