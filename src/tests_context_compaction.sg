import context_compaction;
import provider;

def context_check(ok: bool) -> Result<bool, i64> { Result { is_ok: ok, value: ok, error: if ok { 0 } else { 99 } } }

def context_tests() -> Result<bool, i64> {
    let request_history = json_parse("{\"messages\":[{\"role\":\"user\",\"content\":\"hello\"}],\"context_window_tokens\":4096}")?;
    let empty_tools = json_parse("{\"tools\":[]}")?;
    let mut protocol = 0;
    while protocol < 3 {
        let request = json_parse(provider_build_request(protocol, "model", &request_history, &empty_tools)?.as_str())?;
        let key = if protocol == 0 { "max_completion_tokens" } else { if protocol == 1 { "max_output_tokens" } else { "max_tokens" } };
        let cap = request.root().object_get(key)?.number_i64()?;
        context_check(cap > 0 and cap < 4096)?;
        protocol = protocol + 1;
    };
    let defaults = context_defaults();
    context_check(defaults.window_tokens == 262144 and defaults.max_output_tokens == 131072 and defaults.threshold_percent == 80)?;
    let output_settings = json_parse("{\"schema\":1,\"max_output_tokens\":8192,\"models\":[{\"connection\":\"one\",\"model\":\"small\",\"max_output_tokens\":4096}]}")?;
    context_check(context_limits_document(&output_settings, "one", "small")?.max_output_tokens == 4096 and context_limits_document(&output_settings, "two", "small")?.max_output_tokens == 8192)?;
    let settings = json_parse("{\"schema\":1,\"context_window_tokens\":262144,\"models\":[{\"connection\":\"one\",\"model\":\"small\",\"context_window_tokens\":4096,\"threshold_percent\":80}]}")?;
    let selected = context_limits_document(&settings, "one", "small")?;
    let other = context_limits_document(&settings, "two", "small")?;
    context_check(selected.window_tokens == 4096 and other.window_tokens == 262144)?;
    let invalid = json_parse("{\"schema\":1,\"context_window_tokens\":1}")?;
    context_check(not context_limits_document(&invalid, "one", "small").is_ok())?;
    let duplicate = json_parse("{\"schema\":1,\"models\":[{\"connection\":\"one\",\"model\":\"small\"},{\"connection\":\"one\",\"model\":\"small\"}]}")?;
    context_check(not context_limits_document(&duplicate, "one", "small").is_ok())?;
    let history = json_parse("{\"messages\":[{\"role\":\"system\",\"content\":\"Preserve authority 中文😀\"}]}")?;
    let messages = history.root().object_get("messages")?;
    let mut index = 0;
    while index < 16 {
        let message = history.new_object()?; cli_put_string(&history, message, "role", if index % 2 == 0 { "user" } else { "assistant" })?;
        let content = string_new(); let mut fragment = 0; while fragment < 40 { content.push_str("historical evidence 中文😀; ")?; fragment = fragment + 1; };
        cli_put_string(&history, message, "content", content.as_str())?; messages.array_push(message)?; index = index + 1;
    };
    let call = json_parse("{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"stable-call\",\"name\":\"read_file\",\"arguments\":\"{}\"}]}")?;
    messages.array_push(history.copy(call.root())?)?;
    let unresolved = context_units(&history)?;
    context_check(cli_json_optional_i64(unresolved.root(), "pending", 0) == 1)?;
    let tools = json_parse("{\"tools\":[]}")?;
    context_check(not context_plan(&history, &tools, &selected, false).is_ok())?;
    let result = json_parse("{\"role\":\"tool\",\"tool_call_id\":\"stable-call\",\"content\":\"exact tool result 中文😀\"}")?;
    messages.array_push(history.copy(result.root())?)?;
    let units = context_units(&history)?;
    context_check(cli_json_optional_i64(units.root(), "pending", -1) == 0)?;
    let plan = context_plan(&history, &tools, &selected, false)?;
    context_check(plan.root().object_get("needed")?.bool_value()?)?;
    let prefix = context_prefix(&history, &plan)?;
    context_units(&prefix)?;
    let summary = cli_text("1. User goal: continue the requested implementation and preserve all constraints.\n");
    let mut item = 0;
    while item < 8 { summary.push_str("Verified prior file changes and exact tool evidence remain recorded in the complete public transcript. Continue the pending work without replaying uncertain side effects.\n")?; item = item + 1; };
    let compacted = context_compacted(&history, summary.as_str(), &plan)?;
    let serialized = compacted.serialize_string()?;
    context_check(str_contains(serialized.as_str(), "stable-call") and str_contains(serialized.as_str(), "exact tool result 中文😀"))?;
    context_check(history.root().object_get("messages")?.array_len()? == 19)?;
    context_check(not context_compacted(&history, "   ", &plan).is_ok())?;
    let bad = json_parse("{\"messages\":[{\"role\":\"system\",\"content\":\"safe\"},{\"role\":\"tool\",\"tool_call_id\":\"orphan\",\"content\":\"must not be discarded\"}]}")?;
    context_check(not context_units(&bad).is_ok())?;
    // A valid summary which cannot reduce a huge newest unit is refused.
    // Its allocated candidate must drop rather than hide in Result's Err value.
    let stubborn = context_empty_history()?;
    let stubborn_rows = stubborn.root().object_get("messages")?;
    let system_row = stubborn.new_object()?; cli_put_string(&stubborn, system_row, "role", "system")?; cli_put_string(&stubborn, system_row, "content", "safe")?; stubborn_rows.array_push(system_row)?;
    let old_row = stubborn.new_object()?; cli_put_string(&stubborn, old_row, "role", "user")?; cli_put_string(&stubborn, old_row, "content", "old")?; stubborn_rows.array_push(old_row)?;
    let newest_row = stubborn.new_object()?; cli_put_string(&stubborn, newest_row, "role", "user")?;
    let newest_text = string_new(); let mut repeat = 0; while repeat < 1000 { newest_text.push_str("keep")?; repeat = repeat + 1; };
    cli_put_string(&stubborn, newest_row, "content", newest_text.as_str())?; stubborn_rows.array_push(newest_row)?;
    let mut stubborn_limits = context_defaults(); stubborn_limits.min_summary_chars = 32;
    let stubborn_plan = context_plan(&stubborn, &tools, &stubborn_limits, true)?;
    let live_before = sengoo_json_bounded_live_documents();
    let refused = context_compacted(&stubborn, "Preserve the older task and every exact verification result.", &stubborn_plan);
    context_check(not refused.is_ok() and refused.error == 13 and sengoo_json_bounded_live_documents() == live_before)?;
    let threshold = context_empty_history()?;
    let rows = threshold.root().object_get("messages")?;
    let system = threshold.new_object()?; cli_put_string(&threshold, system, "role", "system")?; cli_put_string(&threshold, system, "content", "safe")?; rows.array_push(system)?;
    let text = string_new(); let mut size = 0;
    while size < 31000 { text.push_str("abcdefghij")?; size = size + 10; };
    let mut row = 0;
    while row < 20 {
        let message = threshold.new_object()?; cli_put_string(&threshold, message, "role", "user")?; cli_put_string(&threshold, message, "content", text.as_str())?; rows.array_push(message)?; row = row + 1;
    };
    context_check(not context_plan(&threshold, &tools, &defaults, false)?.root().object_get("needed")?.bool_value()?)?;
    let more = threshold.new_object()?; cli_put_string(&threshold, more, "role", "assistant")?; cli_put_string(&threshold, more, "content", text.as_str())?; rows.array_push(more)?;
    let crossing = context_plan(&threshold, &tools, &defaults, false)?;
    context_check(crossing.root().object_get("needed")?.bool_value()? and cli_json_string(crossing.root(), "trigger")?.as_str() == "estimated-token-threshold")?;
    Result { is_ok: true, value: true, error: 0 }
}

def main() -> i64 {
    let result = context_tests(); if not result.is_ok() { println(result.error); return 1; };
    println("model-scoped context limits, complete tool units and preserved tail acceptance passed"); 0
}
