import tui;
import std::time;

// Isolated rendering harness. This never opens application storage, credentials
// or a provider. Its timer drives real incremental output while input is read.
def tui_console_fixture() -> Result<i64, i64> {
    let terminal = terminal_open()?; terminal.enter_fullscreen()?;
    let mut app = tui_new("D:/fixture/中文", "fixture-only", "test-model", "test-session");
    let references: Vec<UiCandidate> = vec_new();
    references.push(UiCandidate { id: cli_text("src/main.sg"), label: cli_text("src/main.sg"), detail: cli_text("file"), value: cli_text("src/main.sg") });
    references.push(UiCandidate { id: cli_text("src/"), label: cli_text("src/"), detail: cli_text("directory"), value: cli_text("src/") });
    tui_set_references(&mut app, references)?;
    let mut ticks = 0; let mut counter = 0;
    loop {
        tui_paint(&terminal, &mut app)?;
        let action = tui_poll(&terminal, &mut app, 15)?;
        if action.kind == 3 { break; };
        if action.kind == 2 { tui_finish(&mut app, false)?; (); };
        if action.kind == 1 {
            if action.text.as_str() == "/quit" or action.text.as_str() == "/exit" { break; };
            if action.text.as_str() == "stream" { tui_message(&mut app, "user", action.text.as_str())?; tui_begin(&mut app)?; ticks = 0; } else {
                if action.text.as_str() == "/model" { tui_status(&mut app, "MODEL PICKER OPENED")?; (); } else {
                    if action.text.as_str() == "markdown" { tui_clear(&mut app)?; tui_message(&mut app, "assistant", "# Markdown fixture\n\n```diff\n@@ -1 +1 @@\n-old value\n+new value\n```\n\n| kind | value |\n| --- | --- |\n| text | 中文 |\n\nUse **bold** and `code`.")?; (); } else { tui_message(&mut app, "user", action.text.as_str())?; (); };
                };
            }; ();
        };
        if app.busy {
            ticks = ticks + 1;
            if ticks % 4 == 0 { let line = cli_text("stream line "); line.push_i64(counter)?; line.push_str("  中文\n")?; counter = counter + 1; tui_delta(&mut app, line.as_str())?; (); };
            if ticks > 600 { tui_finish(&mut app, true)?; (); };
        };
    };
    terminal.leave_fullscreen()?; cli_ok(0)
}

def main() -> i64 { let result = tui_console_fixture(); if not result.is_ok { return result.error; }; result.value }
