import common;

// Model history opts into explicit runtime budgets. Public/UI history keeps
// its existing admission contract; exhaustion never yields a partial prefix.
def context_document() -> Result<JsonDoc, i64> { json_doc_object_limits(1048576, 32768) }

def context_empty_history() -> Result<JsonDoc, i64> {
    let document = context_document()?;
    document.root().object_set("messages", document.new_array()?)?;
    Result { is_ok: true, value: document, error: 0 }
}

def context_copy_request_limits(source: &JsonDoc, target: &JsonDoc) -> Result<bool, i64> {
    if source.root().object_has("context_window_tokens") { target.root().object_set("context_window_tokens", target.copy(source.root().object_get("context_window_tokens")?)?)?; (); };
    if source.root().object_has("max_output_tokens") { target.root().object_set("max_output_tokens", target.copy(source.root().object_get("max_output_tokens")?)?)?; (); };
    Result { is_ok: true, value: true, error: 0 }
}
