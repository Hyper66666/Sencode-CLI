import execution_diagnostics;

def diagnostic_tests() -> Result<i64, i64> {
    let mut failures = 0;
    let raw: Vec<TerminalEvent> = vec_new();
    execution_diagnostic_stage(&raw, "tool", "run_command", "raw")?;
    execution_diagnostic_failure(&raw, "tool_outcome_unknown", "tool", "run_command", "raw", true)?;
    if raw.len() != 0 { failures = failures + 1; };
    let input: Vec<TerminalEvent> = vec_new();
    engine_control_init(&input)?;
    engine_control_begin(&input, "request")?;
    execution_diagnostic_stage(&input, "provider", "", "")?;
    let provider = execution_diagnostic_document(&input, 20)?;
    if cli_json_string(provider.root(), "reason")?.as_str() != "provider_request" or str_contains(execution_diagnostic_content(&provider)?.as_str(), "UTF-8") or provider.root().object_get("automatic_replay_forbidden")?.bool_value()? { failures = failures + 1; };
    let cancellation = execution_diagnostic_document(&input, 19)?;
    if cli_json_string(cancellation.root(), "reason")?.as_str() != "cancelled" { failures = failures + 1; };
    execution_diagnostic_failure(&input, "provider_request", "provider", "", "", false)?;
    execution_diagnostic_stage(&input, "cleanup", "run_command", "later")?;
    let retained = execution_diagnostic_document(&input, 9)?;
    if cli_json_string(retained.root(), "stage")?.as_str() != "provider" { failures = failures + 1; };
    execution_diagnostic_failure(&input, "cleanup_unknown", "cleanup", "run_command", "later", true)?;
    let unknown = execution_diagnostic_document(&input, 9)?;
    if cli_json_string(unknown.root(), "reason")?.as_str() != "provider_request" or not unknown.root().object_get("automatic_replay_forbidden")?.bool_value()? or not str_contains(execution_diagnostic_content(&unknown)?.as_str(), "automatic replay is forbidden") { failures = failures + 1; };
    execution_diagnostic_reset(&input);
    execution_diagnostic_stage(&input, "tool", "run_command", "call")?;
    let plain = execution_diagnostic_document(&input, 20)?;
    if cli_json_string(plain.root(), "reason")?.as_str() != "tool_failed" or plain.root().object_has("outcome_unknown") or plain.root().object_get("automatic_replay_forbidden")?.bool_value()? { failures = failures + 1; };
    execution_diagnostic_reset(&input);
    execution_diagnostic_failure(&input,"provider_request","provider","","request",false)?;
    execution_diagnostic_network(&input,502,502,6,"attempt or wait limit reached")?;
    let gateway = execution_diagnostic_document(&input,502)?;
    if not str_contains(execution_diagnostic_content(&gateway)?.as_str(),"HTTP 502 Bad Gateway; retries 5/5") or cli_json_optional_i64(gateway.root(),"attempts",0) != 6 { failures = failures + 1; };
    execution_diagnostic_reset(&input);
    execution_diagnostic_failure(&input,"provider_request","provider","","request",false)?;
    execution_diagnostic_network(&input,0,17,6,"attempt or wait limit reached")?;
    if not str_contains(execution_diagnostic_content(&execution_diagnostic_document(&input,17)?)?.as_str(),"TLS handshake failed") { failures = failures + 1; };
    execution_diagnostic_reset(&input);
    execution_diagnostic_failure(&input,"request_state_failed","request_commit","","request",false)?;
    execution_diagnostic_network(&input,502,502,6,"attempt or wait limit reached")?;
    let storage = execution_diagnostic_document(&input,10)?;
    if not str_contains(execution_diagnostic_content(&storage)?.as_str(),"request evidence could not be saved") or str_contains(execution_diagnostic_content(&storage)?.as_str(),"Model request failed") { failures = failures + 1; };
    execution_diagnostic_reset(&input);
    execution_diagnostic_failure(&input,"provider_request","provider","","request",false)?;
    execution_diagnostic_network(&input,200,10,6,"five retries exhausted")?;
    execution_diagnostic_response(&input,"http_finish","HTTP response body ended before completion")?;
    let partial = execution_diagnostic_document(&input,10)?;
    let partial_text = execution_diagnostic_content(&partial)?;
    if not str_starts_with(partial_text.as_str(),"Invalid or incomplete provider response (HTTP 200 received)") or not str_contains(partial_text.as_str(),"body ended before completion") or not str_contains(partial_text.as_str(),"retries 5/5") { failures = failures + 1; };
    if not str_starts_with(execution_network_label(200,11)?.as_str(),"Network timeout") or not str_starts_with(execution_network_label(201,9)?.as_str(),"Network connection / I/O failed") or not str_starts_with(execution_network_label(200,17)?.as_str(),"TLS handshake failed") { failures = failures + 1; };
    engine_control_end(&input);
    execution_diagnostic_reset(&input);
    if input.len() != 1 { failures = failures + 1; };
    cli_ok(failures)
}

def main() -> i64 {
    let result = diagnostic_tests();
    if not result.is_ok() { println(result.error); return 1; };
    if result.value == 0 { println("execution stage diagnostics regression passed"); };
    result.value
}
