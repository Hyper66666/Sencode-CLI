{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sencode-config", "version": "0.1.0", "identifier": "com.sencode.config",
  "build": {
    "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1432",
    "beforeBuildCommand": "npm run build", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "sencode-config", "width": 1120, "height": 780, "minWidth": 760, "minHeight": 560, "center": true, "backgroundColor": "#ffffff" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "resources": ["resources/*"], "icon": ["icons/icon.ico"] }
}
