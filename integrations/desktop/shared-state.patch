+//! Shared non-executable session provenance and ordinary task-list projection.
+pub(super) const CHILDREN_SQL: &str = include_str!("../../../../sencode-cli/shared-state/session-children-v1.sql");
+
+pub(super) fn list_sql() -> String {
+    format!("{CHILDREN_SQL}
+        SELECT s.id,s.project_id,s.title,s.archived,s.created_at,s.updated_at,
+               s.last_sent_at,s.run_state,s.unread,
+               s.selected_connection_id,s.selected_model_id,s.title_source
+        FROM sessions s
+        WHERE s.project_id=?1 AND s.archived=?2
+          AND s.id NOT IN(SELECT id FROM child_sessions)
+        ORDER BY CASE WHEN s.last_sent_at IS NULL THEN 1 ELSE 0 END,
+                 s.last_sent_at DESC,s.created_at DESC,s.id")
+}
+
+pub(super) fn placeholder(title: &str) -> bool {
+    let normalized: String = title.split_whitespace().collect::<String>().to_ascii_lowercase();
+    normalized.is_empty() || matches!(normalized.as_str(), "newtask" | "newchat")
+}
+
+pub(super) fn display_title(connection: &rusqlite::Connection, session: &str, title: &str, source: &str) -> Result<String, super::PersistenceError> {
+    if source != "placeholder" || !placeholder(title) { return Ok(title.to_owned()); }
+    let mut statement=connection.prepare("SELECT substr(text,1,8192) FROM messages WHERE session_id=?1 AND role='user' AND cancelled=0 ORDER BY revision,created_at,id")?;
+    let mut rows=statement.query([session])?;
+    while let Some(row)=rows.next()? {
+        let text:String=row.get(0)?;
+        if let Some(title)=super::derive_session_title(&text) { return Ok(title); }
+    }
+    Ok(title.to_owned())
+}
