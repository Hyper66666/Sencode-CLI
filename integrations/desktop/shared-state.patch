+
+    fn message(id: &str, role: &str, timestamp: i64) -> super::super::LocalMessage {
+        super::super::LocalMessage {
+            id: id.into(), session_id: "one".into(), role: role.into(),
+            text: id.into(), reasoning: String::new(), created_at_ms: timestamp,
+            completed_at_ms: (role == "user").then_some(timestamp),
+            cancelled: false, connection_id: Some("custom-fixture".into()),
+            model_id: Some("model-fixture".into()), revision: timestamp,
+            content_blocks: None,
+        }
+    }
+
+    fn binding(timestamp: i64) -> super::super::RuntimeBindingRecord {
+        super::super::RuntimeBindingRecord {
+            session_id: "one".into(), connection_id: "custom-fixture".into(),
+            generation: 1, native_session_id: "native-fixture".into(),
+            synced_revision: timestamp as u64, updated_at_ms: timestamp,
+        }
+    }
+
+    #[test]
+    fn turn_authority_requires_the_accepted_user_and_current_owner() {
+        let temp = tempfile::tempdir().unwrap();
+        let mut database = fixture(&temp.path().join("sessions.sqlite3"));
+        database.connection.execute("INSERT INTO messages(id,session_id,role,text,created_at,revision) VALUES('legacy','one','assistant','legacy',1,1)",[]).unwrap();
+        SharedStore::validate_legacy_execution(&database.connection,"one").unwrap();
+        SharedStore::validate_message_fence(&database.connection,"legacy").unwrap();
+        assert!(SharedStore::validate_message_fence(&database.connection,"absent").is_err());
+        database.accept_user_turn(&message("accepted","user",2),2).unwrap();
+        SharedStore::validate_turn_fence(&database.connection,"one","accepted").unwrap();
+        assert!(SharedStore::validate_turn_fence(&database.connection,"other","accepted").is_err());
+        assert!(SharedStore::validate_turn_fence(&database.connection,"one","absent").is_err());
+        assert!(SharedStore::validate_legacy_execution(&database.connection,"one").is_err());
+        assert!(SharedStore::validate_message_fence(&database.connection,"legacy").is_err());
+        database.connection.execute("INSERT INTO messages(id,session_id,role,text,created_at,revision) VALUES('assistant','one','assistant','assistant',3,3)",[]).unwrap();
+        assert!(SharedStore::validate_turn_fence(&database.connection,"one","assistant").is_err());
+        let other = super::super::Database::open(&temp.path().join("sessions.sqlite3")).unwrap();
+        assert!(SharedStore::validate_turn_fence(&other.connection,"one","accepted").is_err());
+        database.set_session_run_state_for_turn("one","accepted","idle",4).unwrap();
+        assert!(SharedStore::validate_turn_fence(&database.connection,"one","accepted").is_err());
+        assert!(SharedStore::validate_legacy_execution(&database.connection,"one").is_err());
+    }
+
+    #[test]
+    fn delayed_turn_without_assistant_cannot_dispatch_or_terminate_its_successor() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = temp.path().join("sessions.sqlite3");
+        let mut database = fixture(&path);
+        database.accept_user_turn(&message("user-A","user",1),1).unwrap();
+        database.set_session_run_state_for_turn("one","user-A","idle",2).unwrap();
+        database.accept_user_turn(&message("user-B","user",3),3).unwrap();
+
+        assert!(database.set_session_run_state_for_turn("one","user-A","error",2).is_err());
+        assert!(database.set_session_run_state("one","idle",2).is_err());
+        let mut late_assistant = message("missing-assistant-A","assistant",2);
+        for accepted in [Some("user-A"),None] {
+            late_assistant.completed_at_ms = None;
+            let dispatch_error = database.begin_runtime_turn(&super::super::DispatchTurnPersist {
+                accepted_user_message_id: accepted.map(str::to_owned),
+                assistant_message: late_assistant.clone(), binding: binding(2), accepted_at_ms: 1,
+            }).unwrap_err();
+            assert_eq!(dispatch_error.code,PersistenceErrorCode::Conflict);
+            late_assistant.completed_at_ms = Some(4);
+            let error_terminal = database.commit_runtime_error_terminal(
+                &late_assistant,1,crate::dto::TurnOutcome::Error,None,accepted,
+            ).unwrap_err();
+            assert_eq!(error_terminal.code,PersistenceErrorCode::Conflict);
+            let terminal_error = database.commit_runtime_terminal(&super::super::TerminalTurnCommit {
+                accepted_user_message_id: accepted.map(str::to_owned),
+                assistant_message: late_assistant.clone(), tools: Vec::new(), binding: binding(2),
+                provider_event_id: "late-A".into(), run_state: "idle".into(), accepted_at_ms: 1,
+                outcome: crate::dto::TurnOutcome::Success,
+            },None).unwrap_err();
+            assert_eq!(terminal_error.code,PersistenceErrorCode::Conflict);
+        }
+        let state: (String,i64,i64) = database.connection.query_row(
+            "SELECT s.run_state,e.active,e.fence FROM sessions s JOIN shared_executions e ON e.session_id=s.id WHERE s.id='one'",[],
+            |row|Ok((row.get(0)?,row.get(1)?,row.get(2)?)),
+        ).unwrap();
+        assert_eq!(state,("running".into(),1,2));
+        assert!(database.get_message("missing-assistant-A").unwrap().is_none());
+        assert!(database.shared.leases.borrow().contains_key("one"));
+        assert!(lock_file(&path,"session","one").is_err());
+
+        // A valid callback may still create an assistant and finish this turn.
+        let mut current_assistant = message("assistant-B","assistant",4);
+        database.begin_runtime_turn(&super::super::DispatchTurnPersist {
+            accepted_user_message_id: Some("user-B".into()), assistant_message: current_assistant.clone(),
+            binding: binding(4), accepted_at_ms: 3,
+        }).unwrap();
+        current_assistant.completed_at_ms = Some(5);
+        database.commit_runtime_error_terminal(
+            &current_assistant,3,crate::dto::TurnOutcome::Error,None,Some("user-B"),
+        ).unwrap();
+        assert!(!database.shared.leases.borrow().contains_key("one"));
+        assert!(lock_file(&path,"session","one").is_ok());
+    }
+
+    #[test]
+    fn edited_resend_holds_lease_until_rollback_or_terminal_cleanup() {
+        for rollback_turn in [true,false] {
+            let temp = tempfile::tempdir().unwrap();
+            let path = temp.path().join("sessions.sqlite3");
+            let mut database = fixture(&path);
+            database.insert_message_bundle(&message("original-user","user",1),&[]).unwrap();
+            let mut original_assistant = message("original-assistant","assistant",2);
+            original_assistant.completed_at_ms = Some(2);
+            database.insert_message_bundle(&original_assistant,&[]).unwrap();
+            let second = super::super::Database::open(&path).unwrap();
+            let replaced = database.replace_latest_prompt(
+                "original-user",2,&message("replacement-user","user",3),3,
+            ).unwrap();
+            SharedStore::validate_turn_fence(&database.connection,"one","replacement-user").unwrap();
+            assert!(second.shared.claim(&second.connection,"one").is_err());
+            assert!(lock_file(&path,"session","one").is_err());
+
+            if rollback_turn {
+                database.rollback_latest_prompt_replay(&replaced.rollback).unwrap();
+                assert!(database.get_message("original-user").unwrap().is_some());
+                assert!(database.get_message("original-assistant").unwrap().is_some());
+                assert!(database.get_message("replacement-user").unwrap().is_none());
+            } else {
+                database.set_session_run_state_for_turn("one","replacement-user","idle",4).unwrap();
+            }
+            assert!(!database.shared.leases.borrow().contains_key("one"));
+            second.shared.claim(&second.connection,"one").unwrap();
+            second.shared.release(&second.connection,"one").unwrap();
+        }
+    }
+
+    #[test]
+    fn unadapted_writer_fails_closed() {
+        let temp = tempfile::tempdir().unwrap();
+        let path = temp.path().join("sessions.sqlite3");
+        let _first = fixture(&path);
+        let unadapted = Connection::open(&path).unwrap();
+        assert!(unadapted.execute("UPDATE sessions SET title='old writer' WHERE id='one'",[]).is_err());
+    }
+
+    #[test]
+    fn cross_connection_lock_is_exclusive_and_persistent() {
+        let temp = tempfile::tempdir().unwrap();
+        let db = temp.path().join("sessions.sqlite3");
+        let first = lock_file(&db,"session","one").unwrap();
+        assert!(lock_file(&db,"session","one").is_err());
+        let other = lock_file(&db,"session","two").unwrap();
+        drop(first);
+        assert!(lock_path(&db,"session","one").exists());
+        assert!(lock_file(&db,"session","one").is_ok());
+        drop(other);
+    }
+}
