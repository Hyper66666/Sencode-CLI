+        database.connection.execute("INSERT INTO messages(id,session_id,role,text,created_at,revision) VALUES('old','one','assistant','first',1,1)",[]).unwrap();
+        database.append_message_delta("old"," done","",Some(2)).unwrap();
+        database.shared.claim(&database.connection,"one").unwrap();
+        database.connection.execute("UPDATE sessions SET run_state='running' WHERE id='one'",[]).unwrap();
+        assert!(database.append_message_delta("old","late","",Some(5)).is_err());
+        let state: (String,i64) = database.connection.query_row("SELECT s.run_state,e.active FROM sessions s JOIN shared_executions e ON e.session_id=s.id WHERE s.id='one'",[],|row|Ok((row.get(0)?,row.get(1)?))).unwrap();
+        assert_eq!(state,("running".into(),1));
+        let text: String = database.connection.query_row("SELECT text FROM messages WHERE id='old'",[],|row|row.get(0)).unwrap();
+        assert_eq!(text,"first done");
