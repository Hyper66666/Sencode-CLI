+//! Shared desktop/Sengoo store contract. No model or tool business logic.
+use super::{PersistenceError, PersistenceErrorCode};
+use rusqlite::{params, Connection};
+use sha2::{Digest, Sha256};
+use std::{cell::RefCell, collections::HashMap, fs::{File, OpenOptions}, path::{Path, PathBuf}};
+
+pub(super) const MIGRATION: &str = include_str!("../../../../sencode-cli/shared-state/migration-29.sql");
+pub(super) const TRIGGERS: &str = include_str!("../../../../sencode-cli/shared-state/triggers-v1.sql");
+
+fn error(message: impl ToString) -> PersistenceError {
+    PersistenceError { code: PersistenceErrorCode::Conflict, message: message.to_string() }
+}
+
+pub(crate) fn lock_path(database: &Path, scope: &str, identity: &str) -> PathBuf {
+    let digest = Sha256::digest(format!("{scope}:{identity}").as_bytes());
+    let hash: String = digest.iter().map(|byte| format!("{byte:02x}")).collect();
+    PathBuf::from(format!("{}.locks", database.display())).join(format!("{hash}.lock"))
+}
+
+pub(crate) fn lock_file(database: &Path, scope: &str, identity: &str) -> Result<File, PersistenceError> {
+    let path = lock_path(database, scope, identity);
+    std::fs::create_dir_all(path.parent().unwrap()).map_err(error)?;
+    let file = OpenOptions::new().read(true).write(true).create(true).truncate(false)
+        .open(path).map_err(error)?;
+    file.try_lock().map_err(|_| error("shared resource is busy in another Sencode process"))?;
+    Ok(file)
+}
+
+#[derive(Debug)]
+pub(super) struct SharedStore {
+    pub instance: String,
+    database: PathBuf,
+    leases: RefCell<HashMap<String, File>>,
+}
+
+impl SharedStore {
+    pub fn new(connection: &Connection, path: &Path) -> Result<Self, PersistenceError> {
+        let instance = format!("desktop-{}-{}", std::process::id(), uuid::Uuid::new_v4());
+        let captured = instance.clone();
+        connection.create_scalar_function("sengoo_context", 1,
+            rusqlite::functions::FunctionFlags::SQLITE_UTF8,
+            move |context| {
+                let key: String = context.get(0)?;
+                Ok(if key == "instance_id" { Some(captured.clone()) } else { None })
+            }).map_err(PersistenceError::from)?;
+        let database = std::fs::canonicalize(path).map_err(error)?;
+        #[cfg(windows)]
+        let database = PathBuf::from(database.to_string_lossy().strip_prefix(r"\\?\")
+            .unwrap_or(&database.to_string_lossy()).to_string());
+        Ok(Self { instance, database, leases: RefCell::new(HashMap::new()) })
+    }
+
+    pub fn migration_lock(&self) -> Result<File, PersistenceError> {
+        lock_file(&self.database, "migration", "schema")
+    }
+
+    /// Hold every session's OS lock throughout legacy recovery. If any session
+    /// is alive, skip global recovery altogether; accepting an idle/dead task
+    /// later performs its own local recovery under its lock.
+    pub fn recovery_locks(&self, connection: &Connection) -> Result<Option<Vec<File>>, PersistenceError> {
+        let mut query = connection.prepare("SELECT id FROM sessions ORDER BY id").map_err(PersistenceError::from)?;
+        let ids = query.query_map([], |row| row.get::<_,String>(0)).map_err(PersistenceError::from)?
+            .collect::<rusqlite::Result<Vec<_>>>().map_err(PersistenceError::from)?;
+        let mut files = Vec::new();
+        for id in &ids {
+            match lock_file(&self.database, "session", id) {
+                Ok(file) => files.push(file),
+                Err(_) => return Ok(None),
+            }
+        }
+        connection.execute("UPDATE shared_executions SET cleanup_required=CASE WHEN engine<>'sengoo' OR EXISTS(SELECT 1 FROM shared_tool_ledger t WHERE t.session_id=shared_executions.session_id AND t.state='running') THEN 1 ELSE cleanup_required END,active=0 WHERE active=1", [])
+            .map_err(PersistenceError::from)?;
+        Ok(Some(files))
+    }
+
+    pub fn claim(&self, connection: &Connection, session: &str) -> Result<(), PersistenceError> {
+        if self.leases.borrow().contains_key(session) {
+            return Err(error("session already has an active turn"));
+        }
+        let file = lock_file(&self.database, "session", session)?;
+        let exists: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM sessions WHERE id=?1)", [session], |row| row.get(0))
+            .map_err(PersistenceError::from)?;
+        if !exists { return Err(error("session not found")); }
+        connection.execute_batch("BEGIN IMMEDIATE").map_err(PersistenceError::from)?;
+        let result = (|| {
+            let pending_cleanup: bool = connection.query_row("SELECT EXISTS(SELECT 1 FROM shared_executions e WHERE e.session_id=?1 AND (e.cleanup_required=1 OR (e.active=1 AND (e.engine<>'sengoo' OR EXISTS(SELECT 1 FROM shared_tool_ledger t WHERE t.session_id=e.session_id AND t.state='running')))))",[session],|row|row.get(0))?;
+            if pending_cleanup { return Err(rusqlite::Error::InvalidParameterName("session cleanup is unverified; takeover requires proof that the previous executor and tool processes exited".into())); }
+            // Opaque sessions belong to an engine. A CLI continuation invalidates
+            // the desktop binding; its next dispatch rebuilds from public history.
+            connection.execute("DELETE FROM runtime_bindings WHERE session_id=?1 AND EXISTS(SELECT 1 FROM shared_executions WHERE session_id=?1 AND engine<>'desktop')", [session])?;
+            connection.execute("UPDATE shared_executions SET active=0 WHERE session_id=?1", [session])?;
+            // Incomplete executions require a cleanup certificate above, in
+            // addition to the released lock. Heartbeats never grant authority.
+            connection.execute("UPDATE sessions SET run_state='interrupted' WHERE id=?1 AND run_state IN('running','awaiting-interaction','cancelling','loading')", [session])?;
+            connection.execute("INSERT INTO shared_executions(session_id,owner_instance_id,execution_id,engine,fence,active,started_at,updated_at) VALUES(?1,?2,?3,'desktop',1,1,?4,?4) ON CONFLICT(session_id) DO UPDATE SET owner_instance_id=excluded.owner_instance_id,execution_id=excluded.execution_id,engine='desktop',fence=shared_executions.fence+1,active=1,started_at=excluded.started_at,updated_at=excluded.updated_at",
+                params![session,self.instance,uuid::Uuid::new_v4().to_string(),super::unix_now_ms()])?;
+            connection.execute_batch("COMMIT")
+        })();
+        if let Err(cause) = result {
+            let _ = connection.execute_batch("ROLLBACK");
+            return Err(PersistenceError::from(cause));
+        }
+        self.leases.borrow_mut().insert(session.to_string(),file);
+        Ok(())
+    }
+
+    pub fn release(&self, connection: &Connection, session: &str) -> Result<(), PersistenceError> {
+        connection.execute("UPDATE shared_executions SET active=0,updated_at=?3 WHERE session_id=?1 AND owner_instance_id=?2",
+            params![session,self.instance,super::unix_now_ms()]).map_err(PersistenceError::from)?;
+        self.leases.borrow_mut().remove(session);
+        Ok(())
+    }
+
+    /// Authorize a callback through the immutable user envelope accepted for
+    /// its turn, including failures before an assistant envelope was created.
+    pub fn validate_turn_fence(
+        connection: &Connection,
+        session: &str,
+        accepted_user_message_id: &str,
+    ) -> Result<(), PersistenceError> {
+        let valid: bool = connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM messages m JOIN shared_executions e ON e.session_id=m.session_id WHERE m.id=?1 AND m.session_id=?2 AND m.role='user' AND m.shared_fence IS NOT NULL AND e.active=1 AND e.fence=m.shared_fence AND e.owner_instance_id=sengoo_context('instance_id'))",
+            params![accepted_user_message_id, session], |row| row.get(0),
+        ).map_err(PersistenceError::from)?;
+        if !valid {
+            return Err(error("stale execution fence: accepted user message does not authorize this turn"));
+        }
+        Ok(())
+    }
+
+    /// Older persistence callers have no turn token. They cannot acquire the
+    /// authority of any shared execution, even after that execution ended.
+    pub fn validate_legacy_execution(
+        connection: &Connection,
+        session: &str,
+    ) -> Result<(), PersistenceError> {
+        let exists: bool = connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM shared_executions WHERE session_id=?1)",
+            [session], |row| row.get(0),
+        ).map_err(PersistenceError::from)?;
+        if exists {
+            return Err(error("execution fence required for a shared session"));
+        }
+        Ok(())
+    }
+
+    /// A message retains the fence captured when its turn was accepted. In
+    /// particular, callbacks from the same desktop instance must not acquire
+    /// the authority of a later turn merely by sharing an instance ID.
+    pub fn validate_message_fence(connection: &Connection, message: &str) -> Result<(), PersistenceError> {
+        let valid: bool = connection.query_row(
+            "SELECT EXISTS(SELECT 1 FROM messages m WHERE m.id=?1 AND ((m.shared_fence IS NULL AND NOT EXISTS(SELECT 1 FROM shared_executions e WHERE e.session_id=m.session_id)) OR (m.shared_fence IS NOT NULL AND EXISTS(SELECT 1 FROM shared_executions e WHERE e.session_id=m.session_id AND e.active=1 AND e.fence=m.shared_fence AND e.owner_instance_id=sengoo_context('instance_id')))))",
+            [message], |row| row.get(0),
+        ).map_err(PersistenceError::from)?;
+        if !valid { return Err(error("stale execution fence: message is absent or belongs to an inactive or replaced turn")); }
+        Ok(())
+    }
+
+}
+
+impl super::PersistenceActor {
+    pub async fn shared_connection_lock(&self, id: &str) -> Result<File, PersistenceError> {
+        let id = id.to_string();
+        self.fusion_op(move |database| lock_file(&database.shared.database, "connection", &id)).await
+    }
+
+    pub async fn shared_changes_since(&self, cursor: i64) -> Result<(i64,Vec<String>,bool),PersistenceError> {
+        self.fusion_op(move |database| {
+            let mut query = database.connection.prepare("SELECT seq,entity,entity_id,COALESCE(instance_id,'') FROM shared_changes WHERE seq>?1 ORDER BY seq LIMIT 256").map_err(PersistenceError::from)?;
+            let mut rows = query.query([cursor]).map_err(PersistenceError::from)?;
+            let mut high = cursor;
+            let mut sessions = std::collections::HashSet::new();
+            let mut connections = false;
+            while let Some(row) = rows.next().map_err(PersistenceError::from)? {
+                high = row.get(0).map_err(PersistenceError::from)?;
+                let instance: String = row.get(3).map_err(PersistenceError::from)?;
+                if instance==database.shared.instance { continue; }
+                let entity: String = row.get(1).map_err(PersistenceError::from)?;
+                let id: String = row.get(2).map_err(PersistenceError::from)?;
+                if entity=="connection_configs" || entity=="app_preferences" { connections=true; }
+                else if entity=="shared_usage" { /* Usage is refreshed separately from history. */ }
+                else if !database.shared.leases.borrow().contains_key(&id) { sessions.insert(id); }
+            }
+            Ok((high,sessions.into_iter().collect(),connections))
+        }).await
+    }
+}
