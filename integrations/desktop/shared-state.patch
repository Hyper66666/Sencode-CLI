+use super::*;
+use crate::acp::{ClientBridge, ClientHandler};
+use crate::persistence::{LocalMessage, LocalProject, LocalSession, PersistenceActor};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio_util::compat::{TokioAsyncReadCompatExt, TokioAsyncWriteCompatExt};
+
+fn pending_prompt_peer() -> (
+    SencodeAcpClient,
+    oneshot::Receiver<()>,
+    oneshot::Sender<()>,
+    tokio::task::JoinHandle<()>,
+) {
+    let (client_io, peer_io) = tokio::io::duplex(16 * 1024);
+    let (reader, writer) = tokio::io::split(client_io);
+    let (inbound_tx, _inbound_rx) = mpsc::unbounded_channel();
+    let (connection, io_task) = acp::ClientSideConnection::new(
+        ClientHandler::new(ClientBridge::new(inbound_tx)),
+        writer.compat_write(),
+        reader.compat(),
+        |future| {
+            tokio::task::spawn_local(future);
+        },
+    );
+    tokio::task::spawn_local(async move {
+        let _ = io_task.await;
+    });
+    let client = SencodeAcpClient::from_parts_for_test(
+        Rc::new(connection),
+        ExternalCapabilities::embedded_custom_api(),
+    );
+    let (started_tx, started_rx) = oneshot::channel();
+    let (release_tx, release_rx) = oneshot::channel();
+    let peer = tokio::task::spawn_local(async move {
+        let (reader, mut writer) = tokio::io::split(peer_io);
+        let mut reader = BufReader::new(reader);
+        let mut started = Some(started_tx);
+        let mut release = Some(release_rx);
+        loop {
+            let mut line = String::new();
+            let count = tokio::time::timeout(Duration::from_secs(3), reader.read_line(&mut line))
+                .await
+                .expect("ACP request timed out")
+                .unwrap();
+            assert_ne!(count, 0, "ACP client closed before its prompt");
+            let request: serde_json::Value = serde_json::from_str(&line).unwrap();
+            let method = request["method"].as_str().expect("ACP request method");
+            let result = match method {
+                "session/load" | "session/set_model" => serde_json::json!({}),
+                "session/prompt" => {
+                    started.take().unwrap().send(()).unwrap();
+                    tokio::time::timeout(Duration::from_secs(3), release.take().unwrap())
+                        .await
+                        .expect("test did not release pending ACP prompt")
+                        .unwrap();
+                    serde_json::json!({"stopReason":"end_turn"})
+                }
+                other => panic!("unexpected ACP request: {other}"),
+            };
+            let response = serde_json::json!({"jsonrpc":"2.0","id":request["id"],"result":result});
+            writer
+                .write_all(format!("{response}\n").as_bytes())
+                .await
+                .unwrap();
+            writer.flush().await.unwrap();
+            if method == "session/prompt" {
+                break;
+            }
+        }
+    });
+    (client, started_rx, release_tx, peer)
+}
+
+async fn fallback_prompt_owns_shared_execution(connection_id: &str) {
+    let temp = tempfile::tempdir().unwrap();
+    let path = temp.path().join("shared-execution.sqlite3");
+    let directory = temp.path().to_string_lossy().into_owned();
+    let mut state = Projection::new(EventLog::new());
+    let project = state.remember_project(&directory);
+    state.upsert_session(SessionSummary {
+        id: "fallback-task".into(),
+        project_id: project.id.clone(),
+        title: "Fallback test".into(),
+        updated_at_ms: 1,
+        run_state: SessionRunState::Idle,
+        pending_interactions: 0,
+        attention: crate::dto::SessionAttention::None,
+    });
+    let selected = ModelRef {
+        connection_id: connection_id.into(),
+        model_id: "test-model".into(),
+    };
+    let detail = state.sessions.get_mut("fallback-task").unwrap();
+    detail.model_ref = Some(selected.clone());
+    detail.model_id = selected.model_id.clone();
+    let projection = Arc::new(Mutex::new(state));
+    let first = PersistenceActor::start(&path).unwrap();
+    first
+        .upsert_project(LocalProject {
+            id: project.id.clone(),
+            directory: project.directory,
+            display_name: project.name,
+            created_at_ms: 1,
+            updated_at_ms: 1,
+        })
+        .await
+        .unwrap();
+    first
+        .upsert_session(LocalSession {
+            id: "fallback-task".into(),
+            project_id: project.id,
+            title: "Fallback test".into(),
+            archived: false,
+            created_at_ms: 1,
+            updated_at_ms: 1,
+            last_sent_at_ms: None,
+            run_state: "idle".into(),
+            unread: false,
+            model_ref: Some(selected),
+        })
+        .await
+        .unwrap();
+    let second = PersistenceActor::start(&path).unwrap();
+    let (client, started, release, peer) = pending_prompt_peer();
+    let (internal_tx, mut internal_rx) = mpsc::unbounded_channel();
+    assert!(
+        begin_prompt(
+            "fallback-task",
+            "hold this prompt",
+            Vec::new(),
+            &projection,
+            Some(&first),
+            Some(client),
+            connection_id,
+            &internal_tx,
+            None,
+            None,
+        )
+        .await
+        .unwrap()
+        .accepted
+    );
+    tokio::time::timeout(Duration::from_secs(3), started)
+        .await
+        .expect("provider did not receive pending prompt")
+        .unwrap();
+    let other_message = LocalMessage {
+        id: "second-user".into(),
+        session_id: "fallback-task".into(),
+        role: "user".into(),
+        text: "competing continuation".into(),
+        reasoning: String::new(),
+        created_at_ms: 10,
+        completed_at_ms: Some(10),
+        cancelled: false,
+        connection_id: Some("custom-second".into()),
+        model_id: Some("second-model".into()),
+        revision: 0,
+        content_blocks: None,
+    };
+    let busy = second
+        .accept_user_turn(other_message.clone(), 10)
+        .await
+        .unwrap_err();
+    assert_eq!(
+        busy.code(),
+        crate::persistence::PersistenceErrorCode::Conflict
+    );
+    assert_eq!(
+        first
+            .history_page("fallback-task", None, 10)
+            .await
+            .unwrap()
+            .messages
+            .len(),
+        1,
+        "the rejected second user must not enter the accepted transcript"
+    );
+    release.send(()).unwrap();
+    let terminal = tokio::time::timeout(Duration::from_secs(3), internal_rx.recv())
+        .await
+        .expect("fallback prompt did not persist and release its lease")
+        .expect("terminal event sender closed");
+    assert!(matches!(
+        terminal,
+        InternalMsg::RuntimeTurnFinished {
+            ok: true,
+            cancelled: false,
+            ..
+        }
+    ));
+    tokio::time::timeout(Duration::from_secs(3), peer)
+        .await
+        .unwrap()
+        .unwrap();
+    second.accept_user_turn(other_message, 11).await.unwrap();
+    second
+        .set_session_run_state_for_turn("fallback-task", "second-user", "idle", 12)
+        .await
+        .unwrap();
+    first.shutdown().await.unwrap();
+    second.shutdown().await.unwrap();
+}
