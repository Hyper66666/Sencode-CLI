+fn spawn_shared_store_reconciler(
+    persistence: Option<crate::persistence::PersistenceActor>,
+    providers: Option<ProviderStore>,
+    projection: Arc<Mutex<Projection>>,
+) {
+    let Some(persistence) = persistence else { return; };
+    tokio::task::spawn_local(async move {
+        let mut cursor = 0;
+        let mut interval = tokio::time::interval(Duration::from_millis(250));
+        interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+        loop {
+            interval.tick().await;
+            let Ok((next, sessions, connections)) = persistence.shared_changes_since(cursor).await else {
+                continue;
+            };
+            if !sessions.is_empty() {
+                match persistence.projection_snapshot().await {
+                    Ok(snapshot) => projection.lock().merge_shared_local(snapshot, &sessions),
+                    Err(_) => continue,
+                }
+            }
+            if connections {
+                if let Some(store) = providers.as_ref() {
+                    match store.load_summaries().await {
+                        Ok(summaries) => projection.lock().set_api_providers(summaries),
+                        Err(_) => continue,
+                    }
+                }
+                match persistence.preferred_connection_id().await {
+                    Ok(Some(preferred)) => { let _ = projection.lock().set_active_connection(&preferred); },
+                    Ok(None) => {},
+                    Err(_) => continue,
+                }
+            }
+            cursor = next;
+        }
+    });
+}
