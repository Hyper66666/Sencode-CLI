+    /// Refresh only externally changed sessions; never overwrite a desktop
+    /// runtime's unrelated streaming context or permission interactions.
+    pub fn merge_shared_local(&mut self, snapshot: LocalProjectionSnapshot, ids: &[String]) {
+        let mut staged = Projection::new(EventLog::new());
+        staged.hydrate_local(snapshot);
+        for id in ids {
+            if let Some(detail) = staged.sessions.remove(id) {
+                self.events.emit(DesktopEventPayload::SessionUpsert { summary: detail.summary.clone() },
+                    Some(id.clone()), EventOrigin::Local, None);
+                for message_id in &detail.message_order {
+                    if let Some(message) = detail.messages.get(message_id) {
+                        self.events.emit(DesktopEventPayload::MessageUpsert { session_id:id.clone(),message:message.clone() },
+                            Some(id.clone()), EventOrigin::Local, None);
+                    }
+                }
+                if !self.session_order.contains(id) { self.session_order.push(id.clone()); }
+                self.sessions.insert(id.clone(),detail);
+            } else if self.sessions.remove(id).is_some() {
+                self.session_order.retain(|existing| existing!=id);
+                self.events.emit(DesktopEventPayload::SessionRemoved {session_id:id.clone()},
+                    Some(id.clone()),EventOrigin::Local,None);
+            }
+        }
+    }
